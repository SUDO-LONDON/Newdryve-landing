---
/**
 * Shared template for the content pages: town hubs (/driving-lessons/*), test
 * centres (/test-centres and /test-centres/*) and guides (/guides/*). Content
 * comes from src/content/seo-pages.ts.
 *
 * Redesign (November 2026), following docs/redesign/HANDOFF.md "Not designed
 * yet > Content pages":
 * - Mint hero continuing the header band, with a fact card that leads with
 *   the answer (coverage status on town pages, the car-test answer on test
 *   centre pages, big figures with their source on guides).
 * - No numbered section labels.
 * - One call to action (the pink band, or the town waitlist form on towns
 *   without coverage) and one related list per page.
 * Nothing here adds facts: every figure and source shown comes from the data.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import GetAppButton from '../components/GetAppButton.astro';
import Faq from '../components/Faq.astro';
import Car from '../components/Car.astro';
import Scallop from '../components/Scallop.astro';
import {
  conversionLabel,
  getRelatedPages,
  pagePath,
  seoPages,
  waitlistLabel,
  type SeoPage,
} from '../content/seo-pages';
import { SITE_URL } from '../config/site';
import { breadcrumbSchema, organizationSchema, websiteSchema } from '../lib/schema';

export function getStaticPaths() {
  return seoPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: SeoPage;
}

type Fact = SeoPage['quickFacts'][number];

const { page } = Astro.props;
const path = pagePath(page);
const canonical = new URL(path, SITE_URL).href;
const relatedPages = getRelatedPages(page);
const isTestCentreChild = page.slug.startsWith('test-centres/') && page.slug !== 'test-centres';
const isHub = page.slug === 'test-centres';
const isTownWaitlistPage =
  page.slug.startsWith('driving-lessons/') && page.slug !== 'driving-lessons/norwich';
const townName = isTownWaitlistPage ? page.h1.replace('Driving lessons in ', '') : '';
const breadcrumbTrail = [
  { name: 'Home', path: '/' },
  ...(isTestCentreChild ? [{ name: 'Test centres', path: '/test-centres' }] : []),
  { name: page.h1, path },
];
const decisionRule = page.quickFacts.find((fact) => fact.label === 'Decision rule');

const kind: 'town' | 'test-centre' | 'guide' = page.slug.startsWith('guides/')
  ? 'guide'
  : page.slug.startsWith('test-centres')
    ? 'test-centre'
    : 'town';

const factByLabel = (label: string) => page.quickFacts.find((fact) => fact.label === label);

/*
 * The fact the card opens with. Test centres answer "can I take my car test
 * here?" first (Jupiter Road's data says car tests are generally directed to
 * Peachman Way); towns open with their honest coverage status.
 */
const leadFact: Fact | undefined =
  kind === 'test-centre'
    ? (factByLabel('Car tests') ?? factByLabel('Use case') ?? factByLabel('Norwich car-test centre'))
    : kind === 'town'
      ? factByLabel('Coverage status')
      : undefined;

/*
 * Guides lead with their numbers. A figure is pulled out of the fact's own
 * value (never typed in here), and shown with the source the page already
 * cites for it plus the date the page was last checked.
 */
const figurePattern = /£\d+(?:\s+to\s+£\d+)?|\d+\s+hours/;
const figureSourceLabels: Record<string, string> = {
  'Common hourly range': 'RAC: Cost of learning to drive',
  'Official practical test fee': 'GOV.UK: Driving test costs',
  'Theory test fee': 'GOV.UK: Driving test costs',
  'Car practical fee': 'GOV.UK: Driving test costs',
  'Common benchmark': 'Ready to Pass: How long it takes to learn',
};

function figureFor(fact: Fact) {
  if (kind !== 'guide') return null;
  const match = fact.value.match(figurePattern);
  return match ? match[0] : null;
}

function sourceFor(fact: Fact): { label: string; href?: string } | null {
  const wanted = figureSourceLabels[fact.label];
  const cited = wanted ? page.sources.find((source) => source.label === wanted) : undefined;
  if (cited) return cited;
  // Newdryve's own fee: the source is Newdryve itself.
  if (fact.label.startsWith('Newdryve')) return { label: 'Newdryve' };
  return null;
}

const areaLabels = ['Nearby areas', 'Nearby places', 'Norfolk areas'];
function areasFor(fact: Fact) {
  if (!areaLabels.includes(fact.label)) return null;
  return fact.value.split(/,\s*|\s+and\s+/).filter(Boolean);
}

const otherFacts = page.quickFacts.filter((fact) => fact !== leadFact);
// Answer first: on guides, facts with a figure go to the top.
const cardFacts =
  kind === 'guide'
    ? [...otherFacts.filter((fact) => figureFor(fact)), ...otherFacts.filter((fact) => !figureFor(fact))]
    : otherFacts;

const norwichCentres = [
  {
    name: 'Peachman Way',
    sub: 'Broadland Business Park · NR7 0WE · Car tests',
    href: '/test-centres/norwich-peachman-way',
  },
  {
    name: 'Jupiter Road',
    sub: 'NR6 6SS · Lorries, buses & large vehicles',
    href: '/test-centres/norwich-jupiter-road',
  },
];

/* Second pass (November 2026): the body is a run of full-width bands, paper
   then chip, in place of one paper column with a sticky sidebar. Each section
   is a heading beside its text, with its items as a row of tiles underneath.
   Tiles are tinted on paper bands and paper on chip bands. */
const tileTones = ['bg-avatar-tile', 'bg-pink'];
let toneIndex = 0;
const sectionTiles = page.sections.map((section, index) =>
  index % 2 === 1
    ? 'border-2 border-forest bg-paper'
    : section.items
      ? tileTones[toneIndex++ % tileTones.length]
      : ''
);
const tileColumns = (count: number) =>
  count === 2 || count === 4 ? 'md:grid-cols-2' : 'md:grid-cols-2 lg:grid-cols-3';

const sectionHeading = 'nd-h3 text-[clamp(30px,3.4vw,44px)]';
const checkIcon =
  '<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>';

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': page.schemaKind,
  '@id': `${canonical}#content`,
  url: canonical,
  name: page.h1,
  headline: page.h1,
  description: page.description,
  inLanguage: 'en-GB',
  publisher: { '@id': `${SITE_URL}#organization` },
  mainEntityOfPage: canonical,
};

const jsonLd = [
  organizationSchema,
  websiteSchema,
  articleSchema,
  breadcrumbSchema(breadcrumbTrail),
];
---

<BaseLayout title={page.title} description={page.description} path={path} jsonLd={jsonLd} footerEdge="pink">
  <article>
    <!-- Hero: mint, carrying straight on from the header band. -->
    <section class="bg-mint">
      <div
        class="nd-container grid items-start gap-12 pt-10 pb-16 md:pt-16 md:pb-24 lg:grid-cols-[minmax(0,1.15fr)_minmax(0,0.85fr)] lg:gap-16"
      >
        <div class="min-w-0">
          <nav aria-label="Breadcrumb" class="text-[15px] font-semibold">
            <ol class="flex flex-wrap items-center gap-x-2">
              {
                breadcrumbTrail.map((crumb, index) => (
                  <li class="flex items-center gap-2">
                    {index > 0 && <span aria-hidden="true">/</span>}
                    {index === breadcrumbTrail.length - 1 ? (
                      <span aria-current="page">{crumb.name}</span>
                    ) : (
                      <a href={crumb.path} class="inline-flex min-h-11 items-center underline">
                        {crumb.name}
                      </a>
                    )}
                  </li>
                ))
              }
            </ol>
          </nav>

          <p class="nd-hand mt-5 text-[28px]">{page.kicker}</p>
          <h1 class="nd-h1 mt-2">{page.h1}</h1>
          <p class="nd-lede mt-6 max-w-[34em]">{page.summary}</p>

          <div class="mt-9 flex flex-wrap gap-3">
            <GetAppButton class="nd-btn nd-btn-lg">{conversionLabel()}</GetAppButton>
            <a href="/#join" class="nd-btn-secondary nd-btn-lg">Join the waitlist</a>
          </div>

          <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2 text-base font-semibold">
            <li class="inline-flex items-center gap-2"><Fragment set:html={checkIcon} />Free for learners</li>
            <li class="inline-flex items-center gap-2">
              <Fragment set:html={checkIcon} />Reviewed {page.lastReviewed}
            </li>
          </ul>
        </div>

        <!-- Fact card: leads with the answer. -->
        <aside class="min-w-0" aria-label="Page quick facts">
          <div class="nd-card-lg nd-shadow overflow-hidden">
            <div class="flex items-center justify-between gap-3 px-6 pt-6 pb-4 sm:px-7">
              <h2 class="nd-h4">at a glance</h2>
              <span class="nd-chip">{isHub ? 'Illustrative map' : 'Local info'}</span>
            </div>

            {
              leadFact && (
                <div class="border-t-2 border-dashed border-forest px-6 py-5 sm:px-7">
                  <p class="nd-small-label">{leadFact.label}</p>
                  <p class="nd-h3 mt-2">{leadFact.value}</p>
                </div>
              )
            }

            {
              isHub && (
                <div class="border-t-2 border-dashed border-forest bg-avatar-tile p-4">
                  <svg
                    viewBox="0 0 320 190"
                    fill="none"
                    role="img"
                    aria-label="Illustrative map of Norwich showing Peachman Way as the car test centre and Jupiter Road for lorry and bus tests"
                    class="block h-auto w-full"
                  >
                    <rect width="320" height="190" rx="16" class="fill-paper" />
                    <path
                      d="M40 150 C90 120 120 170 170 130 S260 90 300 110"
                      class="stroke-chip"
                      stroke-width="14"
                      stroke-linecap="round"
                    />
                    <path
                      d="M30 60 C90 70 130 40 190 55 S270 45 300 30"
                      class="stroke-chip"
                      stroke-width="10"
                      stroke-linecap="round"
                    />
                    <circle cx="163" cy="148" r="22" class="fill-mint" />
                    <circle cx="163" cy="148" r="5" class="fill-forest" />
                    <text
                      x="163"
                      y="120"
                      text-anchor="middle"
                      font-family="Instrument Sans, system-ui, sans-serif"
                      font-size="10"
                      font-weight="700"
                      class="fill-forest"
                    >
                      Peachman Way
                    </text>
                    <text
                      x="163"
                      y="108"
                      text-anchor="middle"
                      font-family="Instrument Sans, system-ui, sans-serif"
                      font-size="8.5"
                      class="fill-forest-soft"
                    >
                      car tests
                    </text>
                    <rect x="86" y="26" width="7" height="7" rx="2" class="fill-pink-ink" />
                    <text
                      x="99"
                      y="33"
                      font-family="Instrument Sans, system-ui, sans-serif"
                      font-size="10"
                      font-weight="700"
                      class="fill-pink-ink"
                    >
                      Jupiter Road
                    </text>
                    <text
                      x="99"
                      y="46"
                      font-family="Instrument Sans, system-ui, sans-serif"
                      font-size="8.5"
                      class="fill-forest-soft"
                    >
                      lorries & buses
                    </text>
                    <path
                      d="M150 42 q-12 10 -4 18"
                      class="stroke-pink-ink"
                      stroke-width="1.5"
                      stroke-dasharray="2 2"
                      fill="none"
                    />
                    <text
                      x="300"
                      y="176"
                      text-anchor="end"
                      font-family="Instrument Sans, system-ui, sans-serif"
                      font-size="8.5"
                      class="fill-forest-soft"
                    >
                      Not to scale
                    </text>
                  </svg>
                  <ul class="mt-3 flex flex-col gap-1">
                    {norwichCentres.map((centre) => (
                      <li>
                        <a
                          href={centre.href}
                          class="flex min-h-16 items-center gap-3.5 rounded-2xl px-2 py-2 no-underline hover:bg-paper"
                        >
                          <span class="grid size-10 shrink-0 place-items-center rounded-full border-2 border-forest bg-mint">
                            <svg width="17" height="17" viewBox="0 0 18 18" fill="none" aria-hidden="true">
                              <path
                                d="M9 1.5a5.5 5.5 0 0 0-5.5 5.5c0 4.1 5.5 9.5 5.5 9.5s5.5-5.4 5.5-9.5A5.5 5.5 0 0 0 9 1.5z"
                                stroke="currentColor"
                                stroke-width="1.8"
                              />
                              <circle cx="9" cy="7" r="2" stroke="currentColor" stroke-width="1.8" />
                            </svg>
                          </span>
                          <span class="min-w-0">
                            <span class="block text-[17px] font-semibold leading-tight underline">{centre.name}</span>
                            <span class="block text-[15px] text-forest-soft">{centre.sub}</span>
                          </span>
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )
            }

            <dl class="flex flex-col">
              {
                cardFacts.map((fact) => {
                  const figure = figureFor(fact);
                  const source = figure ? sourceFor(fact) : null;
                  const areas = areasFor(fact);
                  return (
                    <div class="border-t-2 border-dashed border-forest px-6 py-4 sm:px-7">
                      <dt class="nd-small-label text-forest-soft">{fact.label}</dt>
                      <dd class="mt-1.5">
                        {figure && (
                          <span
                            class={`nd-number mb-2 block text-[clamp(44px,5vw,64px)] break-words ${
                              figure === '£0' ? 'text-hot-pink' : ''
                            }`}
                          >
                            {figure}
                          </span>
                        )}
                        {areas ? (
                          <ul class="flex flex-wrap gap-2 pt-1">
                            {areas.map((area) => (
                              <li class="nd-tag">{area}</li>
                            ))}
                          </ul>
                        ) : (
                          <span class="block text-[17px] leading-snug">{fact.value}</span>
                        )}
                        {source && (
                          <span class="mt-2 block text-[15px] text-forest-soft">
                            Source:{' '}
                            {source.href ? (
                              <a href={source.href} target="_blank" rel="noopener noreferrer" class="font-semibold underline">{source.label}</a>
                            ) : (
                              <span class="font-semibold">{source.label}</span>
                            )}, checked {page.lastReviewed}
                          </span>
                        )}
                      </dd>
                    </div>
                  );
                })
              }
            </dl>

            <div class="border-t-2 border-forest bg-chip px-6 py-4 text-[15px] sm:px-7">
              <p>Last reviewed: {page.lastReviewed}</p>
              {page.updatedNote && <p class="mt-1">{page.updatedNote}</p>}
            </div>
          </div>
        </aside>
      </div>
    </section>

    <!-- On this page -->
    <nav aria-label="On this page" class="border-b-2 border-forest">
      <div class="nd-container flex flex-wrap items-center gap-x-5 gap-y-3 py-5">
        <span class="nd-small-label">On this page</span>
        <ul class="flex flex-wrap gap-2">
          {
            page.sections.map((section, sectionIndex) => (
              <li>
                <a
                  href={`#section-${sectionIndex + 1}`}
                  class="inline-flex min-h-11 items-center rounded-full bg-chip px-4 text-[15px] leading-tight font-semibold no-underline hover:bg-forest hover:text-mint"
                >
                  {section.heading}
                </a>
              </li>
            ))
          }
          <li>
            <a
              href="#faq"
              class="inline-flex min-h-11 items-center rounded-full bg-chip px-4 text-[15px] font-semibold no-underline hover:bg-forest hover:text-mint"
            >
              Questions
            </a>
          </li>
        </ul>
      </div>
    </nav>

    <!-- Body: one band per section, paper then chip. -->
    {
      page.sections.map((section, sectionIndex) => (
        <section id={`section-${sectionIndex + 1}`} class={sectionIndex % 2 === 1 ? 'bg-chip' : ''}>
          <div class="nd-container py-14 md:py-20">
            <div class="grid gap-x-16 gap-y-5 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
              <h2 class={sectionHeading}>{section.heading}</h2>
              <div class="max-w-[40em] space-y-4 lg:pt-1.5">
                {section.body.map((paragraph) => (
                  <p>{paragraph}</p>
                ))}
              </div>
            </div>

            {section.items && (
              <ul class={`mt-10 grid gap-5 ${tileColumns(section.items.length)}`}>
                {section.items.map((item) => (
                  <li class={`flex flex-col rounded-[28px] p-6 ${sectionTiles[sectionIndex]}`}>
                    <h3 class="font-heading text-[22px] leading-[1.1] font-extrabold tracking-[-0.02em]">
                      {item.title}
                    </h3>
                    <p class="mt-2.5 text-[17px] leading-snug">{item.body}</p>
                    {item.href && (
                      <a
                        href={item.href}
                        class="mt-auto inline-flex min-h-11 items-center pt-2 font-semibold underline"
                      >
                        Read more<span class="sr-only">: {item.title}</span>
                      </a>
                    )}
                  </li>
                ))}
              </ul>
            )}
          </div>
        </section>
      ))
    }

    {
      decisionRule && (
        <section class="on-forest bg-forest text-paper">
          <Scallop color={page.sections.length % 2 === 0 ? 'chip' : 'paper'} />
          <div class="nd-container py-14 md:py-20">
            <p class="nd-hand text-[28px] text-mint">decision rule</p>
            <h2 class="nd-h2 mt-3 max-w-[20ch]">{decisionRule.value}</h2>
            <p class="nd-lede mt-5 max-w-[34ch]">
              A faster slot is not worth much if it lowers your chance of passing.
            </p>
          </div>
        </section>
      )
    }

    <section id="faq" class="nd-section">
      <div class="nd-container grid items-start gap-x-16 gap-y-8 lg:grid-cols-[minmax(0,0.85fr)_minmax(0,1.15fr)]">
        <div class="flex flex-col items-start gap-8">
          <h2 class="nd-h2">questions</h2>
          <Car width={220} class="hidden lg:block" />
        </div>
        <div>
          <Faq items={page.faqs} />

          <div class="mt-10 rounded-[28px] bg-chip p-6">
            <h2 class="nd-h4">sources</h2>
            <p class="nd-help mt-1">Checked {page.lastReviewed}</p>
            <ul class="mt-2 flex flex-col">
              {
                page.sources.map((source) => (
                  <li>
                    <a
                      href={source.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="inline-flex min-h-11 items-center py-1.5 text-base leading-snug font-semibold underline"
                    >
                      {source.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </div>
    </section>

    <!-- The one related list. -->
    {
      relatedPages.length > 0 && (
        <section aria-labelledby="related-heading" class="bg-chip">
          <Scallop color="paper" />
          <div class="nd-container py-14 md:py-20">
            <h2 id="related-heading" class="nd-h2">
              related guides
            </h2>
            <ul class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
              {relatedPages.map((related) => (
                <li>
                  <a
                    href={pagePath(related)}
                    class="nd-card flex h-full flex-col gap-2 p-6 no-underline transition-transform hover:shadow-[0_5px_0_var(--forest)] motion-safe:hover:-translate-y-0.5"
                  >
                    <span class="nd-small-label text-forest-soft">{related.kicker}</span>
                    <span class="nd-h4">{related.h1}</span>
                  </a>
                </li>
              ))}
            </ul>
          </div>
        </section>
      )
    }

    <!-- The one call to action: the town waitlist where there is no coverage yet, otherwise the pink band. -->
    {
      isTownWaitlistPage ? (
        <section id="join" class="bg-pink">
          <div class="nd-container nd-section grid items-start gap-10 lg:grid-cols-[minmax(0,0.9fr)_minmax(0,1.1fr)] lg:gap-16">
            <div>
              <h2 class="nd-h2">join the {townName} learner waitlist</h2>
              <p class="nd-lede mt-6 max-w-[30em]">
                Tell us your postcode, whether you prefer manual or automatic lessons, and when you
                are usually free. Use the notes field for daytime, evening or weekend preference, and
                whether you can meet in {townName} if home pickup is not available.
              </p>
            </div>
            <WaitlistForm
              id={`waitlist-${page.slug.replaceAll('/', '-')}`}
              submitLabel={`Join the ${townName} learner waitlist`}
            />
          </div>
        </section>
      ) : (
        <section aria-labelledby="cta-heading" class="bg-pink">
          <div class="nd-container nd-section flex flex-col items-center gap-7 text-center">
            <h2 id="cta-heading" class="nd-h2 max-w-[14em]">
              find an instructor who can prepare you properly.
            </h2>
            <p class="nd-lede max-w-[30em]">
              Newdryve shows verified instructors, real availability and the areas they cover, so you
              book with confidence instead of guesswork.
            </p>
            <div class="flex flex-wrap justify-center gap-3">
              <a href="/#join" class="nd-btn nd-btn-lg">
                {waitlistLabel()}
              </a>
              <a href="/instructors" class="nd-btn-secondary nd-btn-lg">
                I'm an instructor
              </a>
            </div>
            <p class="text-[17px]">Free for learners and 0% commission. You pay your instructor for the lesson.</p>
          </div>
        </section>
      )
    }
  </article>
</BaseLayout>
