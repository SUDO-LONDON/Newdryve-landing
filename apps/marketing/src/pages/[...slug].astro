---
import BaseLayout from '../layouts/BaseLayout.astro';
import WaitlistForm from '../components/WaitlistForm.astro';
import {
  conversionHref,
  conversionLabel,
  getRelatedPages,
  pagePath,
  seoPages,
  type SeoPage,
} from '../content/seo-pages';
import { SITE_URL, BRAND } from '../config/site';
import { breadcrumbSchema, organizationSchema, websiteSchema } from '../lib/schema';

export function getStaticPaths() {
  return seoPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

interface Props {
  page: SeoPage;
}

const { page } = Astro.props;
const path = pagePath(page);
const canonical = new URL(path, SITE_URL).href;
const relatedPages = getRelatedPages(page);
const isTestCentreChild = page.slug.startsWith('test-centres/') && page.slug !== 'test-centres';
const isTownWaitlistPage =
  page.slug.startsWith('driving-lessons/') && page.slug !== 'driving-lessons/norwich';
const townName = isTownWaitlistPage ? page.h1.replace('Driving lessons in ', '') : '';
const breadcrumbTrail = [
  { name: 'Home', path: '/' },
  ...(isTestCentreChild ? [{ name: 'Test centres', path: '/test-centres' }] : []),
  { name: page.h1, path },
];

function reviewedDateToIso(date: string) {
  const [day, monthName, year] = date.split(' ');
  const months: Record<string, string> = {
    January: '01',
    February: '02',
    March: '03',
    April: '04',
    May: '05',
    June: '06',
    July: '07',
    August: '08',
    September: '09',
    October: '10',
    November: '11',
    December: '12',
  };

  return `${year}-${months[monthName]}-${day.padStart(2, '0')}`;
}

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': page.schemaKind,
  '@id': `${canonical}#content`,
  url: canonical,
  name: page.h1,
  headline: page.h1,
  description: page.description,
  inLanguage: 'en-GB',
  dateModified: reviewedDateToIso(page.lastReviewed),
  publisher: { '@id': `${SITE_URL}#organization` },
  mainEntityOfPage: canonical,
};

const jsonLd = [
  organizationSchema,
  websiteSchema,
  articleSchema,
  breadcrumbSchema(breadcrumbTrail),
];
---

<BaseLayout title={page.title} description={page.description} path={path} jsonLd={jsonLd}>
  <article>
    <section class="hero-bg relative overflow-hidden border-b border-border">
      <div class="dot-pattern pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
      <div class="relative mx-auto grid max-w-6xl gap-10 px-5 py-14 md:grid-cols-[1.05fr_0.95fr] md:py-20">
        <div>
          <nav aria-label="Breadcrumb" class="mb-6 text-sm font-semibold text-ink-muted">
            <ol class="flex flex-wrap items-center gap-2">
              {
                breadcrumbTrail.map((crumb, index) => (
                  <li class="flex items-center gap-2">
                    {index > 0 && <span aria-hidden="true">/</span>}
                    {index === breadcrumbTrail.length - 1 ? (
                      <span aria-current="page">{crumb.name}</span>
                    ) : (
                      <a href={crumb.path} class="focus-ring rounded text-racing-green hover:underline">
                        {crumb.name}
                      </a>
                    )}
                  </li>
                ))
              }
            </ol>
          </nav>

          <p class="text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink">
            {page.kicker}
          </p>
          <h1 class="font-display mt-4 text-[clamp(38px,7vw,62px)] font-semibold leading-[1.04] tracking-[-1px] text-balance">
            {page.h1}
          </h1>
          <p class="mt-6 max-w-2xl text-lg leading-relaxed text-ink-secondary text-pretty">
            {page.summary}
          </p>

          <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
            <a
              href={conversionHref()}
              class="focus-ring inline-flex min-h-11 items-center justify-center rounded-full bg-deep-rose px-6 py-3.5 text-sm font-bold text-white shadow-[0_10px_28px_-10px_rgba(232,82,122,0.6)] transition-transform hover:bg-[#d8406b] motion-safe:hover:-translate-y-0.5"
            >
              {conversionLabel()}
            </a>
            <a
              href="/#join"
              class="focus-ring inline-flex min-h-11 items-center justify-center rounded-full border border-border bg-white px-6 py-3.5 text-sm font-bold text-ink transition-transform hover:border-ink motion-safe:hover:-translate-y-0.5"
            >
              Join the waitlist
            </a>
          </div>
        </div>

        <aside class="self-start rounded-2xl border border-border bg-white p-6 shadow-[0_24px_70px_-40px_rgba(10,10,20,0.4)]">
          <h2 class="text-base font-bold tracking-[-0.2px]">Quick facts</h2>
          <dl class="mt-5 divide-y divide-border">
            {
              page.quickFacts.map((fact) => (
                <div class="grid gap-1 py-3 sm:grid-cols-[9rem_1fr]">
                  <dt class="text-sm font-semibold text-ink-muted">{fact.label}</dt>
                  <dd class="text-sm leading-relaxed text-ink">{fact.value}</dd>
                </div>
              ))
            }
          </dl>
          <p class="mt-4 text-xs leading-relaxed text-ink-muted">Last reviewed: {page.lastReviewed}</p>
          {page.updatedNote && <p class="mt-2 text-xs leading-relaxed text-ink-muted">{page.updatedNote}</p>}
        </aside>
      </div>
    </section>

    <section class="bg-canvas">
      <div class="mx-auto grid max-w-6xl gap-10 px-5 py-14 lg:grid-cols-[minmax(0,1fr)_18rem] lg:py-20">
        <div class="space-y-10">
          {
            page.sections.map((section, sectionIndex) => (
              <section class="reveal rounded-2xl border border-border bg-white p-6 md:p-8" data-reveal-delay={sectionIndex * 80}>
                <h2 class="font-display text-[clamp(26px,4vw,36px)] font-semibold leading-tight tracking-[-0.5px]">
                  {section.heading}
                </h2>
                <div class="mt-5 space-y-4 text-base leading-relaxed text-ink-secondary">
                  {section.body.map((paragraph) => <p>{paragraph}</p>)}
                </div>
                {
                  section.items && (
                    <div class="mt-7 grid gap-4 md:grid-cols-3">
                      {section.items.map((item) => (
                        <div class="rounded-xl border border-border bg-canvas p-5">
                          <h3 class="text-base font-bold tracking-[-0.2px]">{item.title}</h3>
                          <p class="mt-2 text-sm leading-relaxed text-ink-secondary">{item.body}</p>
                          {item.href && (
                            <a href={item.href} class="focus-ring mt-4 inline-flex min-h-11 items-center rounded text-sm font-bold text-racing-green underline underline-offset-2">
                              Read more
                            </a>
                          )}
                        </div>
                      ))}
                    </div>
                  )
                }
              </section>
            ))
          }

          {
            isTownWaitlistPage && (
              <section id="join" class="reveal scroll-mt-20 rounded-2xl border border-border bg-white p-6 md:p-8">
                <div class="mb-6">
                  <p class="text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink">
                    Demand registration
                  </p>
                  <h2 class="font-display mt-3 text-[clamp(26px,4vw,34px)] font-semibold leading-tight tracking-[-0.5px]">
                    Join the {townName} learner waitlist
                  </h2>
                  <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-secondary">
                    Tell us your postcode, whether you prefer manual or automatic lessons, and when
                    you are usually free. Use the notes field for daytime, evening or weekend
                    preference, and whether you can meet in {townName} if home pickup is not
                    available.
                  </p>
                </div>
                <WaitlistForm
                  id={`waitlist-${page.slug.replaceAll('/', '-')}`}
                  submitLabel={`Join the ${townName} learner waitlist`}
                />
              </section>
            )
          }

          <section class="reveal rounded-2xl border border-border bg-white p-6 md:p-8">
            <h2 class="font-display text-[clamp(26px,4vw,34px)] font-semibold leading-tight tracking-[-0.5px]">
              Frequently asked questions
            </h2>
            <div class="mt-6 divide-y divide-border">
              {
                page.faqs.map((faq) => (
                  <details class="group py-4">
                    <summary class="focus-ring flex cursor-pointer list-none items-center justify-between gap-4 rounded text-left text-base font-bold [&::-webkit-details-marker]:hidden">
                      <span>{faq.q}</span>
                      <span class="text-xl leading-none text-ink-muted group-open:rotate-45" aria-hidden="true">+</span>
                    </summary>
                    <p class="mt-3 max-w-3xl text-sm leading-relaxed text-ink-secondary">{faq.a}</p>
                  </details>
                ))
              }
            </div>
          </section>
        </div>

        <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start">
          <section class="rounded-2xl border border-border bg-white p-5">
            <h2 class="text-sm font-bold uppercase tracking-[1px] text-deep-rose-ink">
              Related pages
            </h2>
            <ul class="mt-4 space-y-2">
              {
                relatedPages.map((related) => (
                  <li>
                    <a href={pagePath(related)} class="focus-ring block rounded-lg px-2 py-2 text-sm font-semibold text-ink-secondary hover:bg-canvas hover:text-ink">
                      {related.h1}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="rounded-2xl border border-border bg-white p-5">
            <h2 class="text-sm font-bold uppercase tracking-[1px] text-deep-rose-ink">
              Sources
            </h2>
            <ul class="mt-4 space-y-3">
              {
                page.sources.map((source) => (
                  <li>
                    <a
                      href={source.href}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="focus-ring rounded text-sm font-semibold leading-relaxed text-racing-green underline underline-offset-2"
                    >
                      {source.label}
                    </a>
                  </li>
                ))
              }
            </ul>
          </section>

          <section class="rounded-2xl bg-racing-green p-5 text-white">
            <h2 class="text-lg font-bold tracking-[-0.2px]">Learning in {BRAND.city}?</h2>
            <p class="mt-2 text-sm leading-relaxed text-white/80">
              Find verified instructors, compare real availability, and keep your lessons moving.
            </p>
            <a
              href="/#join"
              class="focus-ring mt-4 inline-flex min-h-11 items-center justify-center rounded-full bg-white px-5 py-3 text-sm font-bold text-racing-green"
            >
              Join the waitlist
            </a>
          </section>
        </aside>
      </div>
    </section>
  </article>
</BaseLayout>
