---
/**
 * Ported from app/datadeletion/page.tsx. The form posts to /api/data-deletion
 * with the same JSON contract as before: { firstName, lastName, email, phone }.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { organizationSchema, breadcrumbSchema } from '../lib/schema';

const title = 'Request data deletion | Newdryve';
const description =
  'Request deletion of your Newdryve account and eligible personal data, including identity checks before data is removed or anonymised.';

const jsonLd = [
  organizationSchema,
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Request data deletion', path: '/datadeletion' },
  ]),
];

const inputClass = 'nd-input';
const labelClass = 'nd-label';

const steps = [
  'We match the details you provide with your Newdryve account.',
  'We contact you if we need more information to verify your identity.',
  'We delete or anonymise eligible data and confirm when the request is complete.',
];
---

<BaseLayout title={title} description={description} path="/datadeletion" jsonLd={jsonLd} noindex footerEdge="paper">
  <PageHero
    hand="your privacy"
    title="request data deletion"
    lede="Submit the details linked to your Newdryve account and our team will review your request. We may need to verify your identity before taking action."
    carColor="#CDB9F7"
    car="long-hair"
  />

  <div class="nd-container py-14 md:py-20">
    <div class="grid gap-10 md:grid-cols-[0.8fr_1.2fr] md:items-start md:gap-14">
      <div class="rounded-[32px] border-2 border-forest bg-pink p-6 sm:p-8 md:sticky md:top-8">
        <h2 class="nd-h4">What happens next?</h2>
        <ol class="mt-5 flex flex-col gap-4">
          {
            steps.map((text, index) => (
              <li class="flex items-start gap-4">
                <span class="nd-marker size-10 text-lg" aria-hidden="true">
                  {index + 1}
                </span>
                <span class="pt-1.5">{text}</span>
              </li>
            ))
          }
        </ol>
      </div>

      <section aria-labelledby="deletion-form-heading">
        <div class="mb-6">
          <h2 id="deletion-form-heading" class="nd-h3">Your account details</h2>
          <p class="nd-help mt-2">
            All fields are required. Use the email address and phone number associated with your
            account.
          </p>
        </div>

        <div data-deletion-root>
          <form
            action="/api/data-deletion"
            method="post"
            novalidate
            data-deletion-form
            class="nd-card-lg nd-shadow flex flex-col gap-5 p-6 sm:p-8"
          >
            <div class="grid gap-5 sm:grid-cols-2">
              <div class="flex flex-col gap-2">
                <label class={labelClass} for="dd-first-name">First name</label>
                <input
                  id="dd-first-name"
                  name="firstName"
                  type="text"
                  required
                  autocomplete="given-name"
                  class={inputClass}
                />
              </div>
              <div class="flex flex-col gap-2">
                <label class={labelClass} for="dd-last-name">Last name</label>
                <input
                  id="dd-last-name"
                  name="lastName"
                  type="text"
                  required
                  autocomplete="family-name"
                  class={inputClass}
                />
              </div>
            </div>

            <div class="flex flex-col gap-2">
              <label class={labelClass} for="dd-email">Email address</label>
              <input
                id="dd-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                inputmode="email"
                class={inputClass}
              />
            </div>

            <div class="flex flex-col gap-2">
              <label class={labelClass} for="dd-phone">Phone number</label>
              <input
                id="dd-phone"
                name="phone"
                type="tel"
                required
                autocomplete="tel"
                inputmode="tel"
                class={inputClass}
              />
            </div>

            <p data-deletion-error role="alert" class="nd-error hidden"></p>

            <button
              type="submit"
              data-deletion-submit
              class="nd-btn nd-btn-lg mt-1 w-full sm:w-auto sm:self-start"
            >
              <span data-deletion-submit-label>Submit deletion request</span>
            </button>
          </form>

          <div
            data-deletion-success
            hidden
            role="status"
            class="nd-card-lg flex flex-col items-center p-8 text-center"
          >
            <div
              class="mb-4 flex size-14 items-center justify-center rounded-full border-2 border-forest bg-mint text-forest"
            >
              <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
                <path
                  d="M5 11l4 4 8-9"
                  stroke="currentColor"
                  stroke-width="2.5"
                  stroke-linecap="round"
                  stroke-linejoin="round"></path>
              </svg>
            </div>
            <h3 class="nd-h4">Request received.</h3>
            <p class="mt-2">
              We will review your request and contact you at the email address you provided.
            </p>
          </div>
        </div>

        <p class="nd-help mt-6">
          Some records may need to be retained where required by law or for fraud prevention,
          disputes, tax or accounting purposes. See our <a
            href="/privacy"
            class="font-semibold text-forest underline underline-offset-2">Privacy Policy</a
          > for details.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>

<script>
  const root = document.querySelector<HTMLElement>('[data-deletion-root]');
  if (root) {
    const form = root.querySelector<HTMLFormElement>('[data-deletion-form]');
    const success = root.querySelector<HTMLElement>('[data-deletion-success]');
    const errorEl = root.querySelector<HTMLElement>('[data-deletion-error]');
    const button = root.querySelector<HTMLButtonElement>('[data-deletion-submit]');
    const buttonLabel = root.querySelector<HTMLElement>('[data-deletion-submit-label]');

    if (form && success && errorEl && button && buttonLabel) {
      let submitting = false;

      form.addEventListener('submit', async (event) => {
        event.preventDefault();
        if (submitting) return;

        const data = new FormData(form);
        const payload = {
          firstName: String(data.get('firstName') || ''),
          lastName: String(data.get('lastName') || ''),
          email: String(data.get('email') || ''),
          phone: String(data.get('phone') || ''),
        };

        submitting = true;
        button.disabled = true;
        buttonLabel.textContent = 'Sending...';
        errorEl.classList.add('hidden');

        try {
          const res = await fetch('/api/data-deletion', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload),
          });

          if (!res.ok) {
            const body = (await res.json().catch(() => ({}))) as { error?: string };
            throw new Error(body.error || 'Something went wrong. Please try again.');
          }

          form.hidden = true;
          success.hidden = false;
        } catch (err) {
          errorEl.textContent =
            err instanceof Error ? err.message : 'Something went wrong. Please try again.';
          errorEl.classList.remove('hidden');
          buttonLabel.textContent = 'Submit deletion request';
        } finally {
          submitting = false;
          button.disabled = false;
        }
      });
    }
  }
</script>
