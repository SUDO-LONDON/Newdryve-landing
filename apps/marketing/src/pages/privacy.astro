---
/**
 * Ported verbatim from the Next app at app/privacy/page.tsx. This is real,
 * reviewed legal content naming a real company number and registered office,
 * so the text must not be altered, summarised or replaced with placeholder copy.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { organizationSchema, breadcrumbSchema } from '../lib/schema';

const title = 'Newdryve Privacy Policy | Learner and Instructor Data';
const description =
  'Read how NEWDRYVE LTD collects, uses, shares, protects and deletes learner, instructor and account data across the app and website.';

const jsonLd = [
  organizationSchema,
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Privacy Policy', path: '/privacy' },
  ]),
];

const linkClass = 'focus-ring rounded font-semibold text-ink underline underline-offset-2';
---

<BaseLayout title={title} description={description} path="/privacy" jsonLd={jsonLd}>
  <div class="mx-auto max-w-3xl px-5 py-16 md:py-24">
    <h1 class="font-display text-[clamp(32px,5vw,48px)] font-semibold leading-[1.05] tracking-[-1px]">
      Privacy Policy
    </h1>
    <p class="mt-4 text-sm text-ink-secondary">Last updated 31 July 2026</p>

    <p
      class="mt-6 rounded-2xl border border-blush-border bg-blush-surface px-5 py-4 text-sm leading-relaxed text-ink-secondary"
    >
      <strong class="text-ink">Data controller:</strong> NEWDRYVE LTD, trading as Newdryve, company
      number 17234490. Registered office: 10 Greylag Close, Norwich, NR7 8FQ, England. For privacy
      questions or requests, email <a href="mailto:support@newdryve.com" class={linkClass}
        >support@newdryve.com</a
      >.
      <span class="mt-2 block"
        >The Newdryve iOS app is published on the App Store by JSDK SAGA LIMITED on behalf of
        NEWDRYVE LTD.</span
      >
    </p>

    <div class="mt-10 space-y-8 [&_h2]:font-display [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:tracking-[-0.3px] [&_h2]:text-ink [&_p]:mt-3 [&_p]:text-base [&_p]:leading-relaxed [&_p]:text-ink-secondary [&_ul]:mt-3 [&_ul]:list-disc [&_ul]:space-y-2 [&_ul]:pl-5 [&_ul]:text-base [&_ul]:leading-relaxed [&_ul]:text-ink-secondary [&_ul]:marker:text-deep-rose">
      <section>
        <h2>1. Scope</h2>
        <p>
          This policy explains how we handle personal data when you use the Newdryve website, join
          our early-access waitlist, contact us, or use our mobile app and related services. It
          applies to learner drivers, instructors, driving schools and other people who use or
          interact with Newdryve.
        </p>
      </section>

      <section>
        <h2>2. Information we collect</h2>
        <p>Depending on how you use Newdryve, we may collect the following information.</p>
        <ul>
          <li>
            <strong class="text-ink">Website and waitlist information:</strong> if you join the learner
            waitlist, your email address, name, postcode or area, and any optional notes.
          </li>
          <li>
            <strong class="text-ink">Instructor application information:</strong> if you apply to teach
            with Newdryve, your name, email address, telephone number, the areas you cover, your ADI
            number and expiry date, driving-school name, hourly rate, vehicle details, availability and
            any notes you add. We record your permission for us to confirm your current registration
            through the GOV.UK directory or directly with DVSA. You may optionally upload a badge image
            to help us match your details. We do not request or retain your DBS certificate.
          </li>
          <li>
            <strong class="text-ink">Account and profile information:</strong> your name, email address,
            telephone number, account and authentication identifiers, role, age, driving experience, language
            preferences, transmission and instructor preferences, and learning goal.
          </li>
          <li>
            <strong class="text-ink">Lesson and booking information:</strong> availability, instructor
            profile information, lesson type, date, time, price, pickup address, booking status, cancellations,
            payment status, lesson notes, learning progress, assessments, reviews and messages.
          </li>
          <li>
            <strong class="text-ink">Location information:</strong> a pickup address and, if you choose
            to use the feature, your precise device location. An instructor may also actively share a live
            vehicle position during a lesson. We do not request background location access.
          </li>
          <li>
            <strong class="text-ink">Payment and payout information:</strong> payment references, transaction
            history, limited card details such as brand and last four digits, and instructor bank-transfer
            or payout details. Stripe handles card details and connected-account onboarding.
          </li>
          <li>
            <strong class="text-ink">Optional uploads and content:</strong> receipt images, expense details,
            messages, lesson notes and other content you choose to provide. Receipt images may be processed
            to extract information when you request scanning.
          </li>
          <li>
            <strong class="text-ink">Device and technical information:</strong> push-notification token,
            device platform, security and diagnostic logs, and information needed to keep the service reliable
            and secure.
          </li>
        </ul>
      </section>

      <section>
        <h2>3. How we use your information</h2>
        <p>
          We use personal data to provide and administer Newdryve, including to create accounts,
          match learners and instructors, manage bookings, process and record payments, enable
          payouts, send service notifications, provide support, maintain records, prevent fraud,
          investigate disputes, protect users and improve reliability.
        </p>
        <p>
          For instructor verification, we use the applicant&rsquo;s name and ADI number only to confirm
          current DVSA registration. We record the verification method, date, reviewer and next recheck
          date. We do not independently assess criminal-record information or publish a Newdryve DBS claim.
        </p>
        <p>
          Where UK data-protection law applies, we rely on the performance of a contract, legal
          obligations, our legitimate interests in running a safe and reliable service, or your
          consent where we ask for it. You can change device permissions, such as location, camera,
          photo-library and notification permissions, in your device settings.
        </p>
      </section>

      <section>
        <h2>4. Early access and marketing</h2>
        <p>
          If you join the waitlist or apply as an instructor, we use the information you provide to
          assess your application and send Newdryve early-access, launch and service updates. You can
          ask us to stop these messages at any time by emailing <a
            href="mailto:support@newdryve.com"
            class={linkClass}>support@newdryve.com</a
          >.
        </p>
        <p>
          We do not sell personal data, display third-party advertising, or use personal data to
          track you across other companies&apos; apps or websites.
        </p>
      </section>

      <section>
        <h2>5. Who we share information with</h2>
        <p>
          We share the information needed to arrange and deliver a lesson between the relevant
          learner and instructor. For example, this may include contact details, booking details,
          pickup location, messages, lesson records and payment status.
        </p>
        <p>
          We also use specialist providers to operate Newdryve. They process information only as
          needed to provide their services to us:
        </p>
        <ul>
          <li>Supabase, for database, authentication and storage services.</li>
          <li>Railway, for application hosting and operational infrastructure.</li>
          <li>
            Stripe, for card payments, payment methods, instructor subscriptions and connected-account
            payouts.
          </li>
          <li>Expo, for push-notification delivery.</li>
          <li>Twilio, for communications where SMS is enabled.</li>
          <li>Mistral AI, when you request receipt extraction or an AI-generated summary.</li>
          <li>Resend, for website waitlist and service emails.</li>
        </ul>
        <p>
          We may also share information where required by law, to enforce our rights, respond to a
          valid legal request, protect people from harm, or obtain professional advice.
        </p>
      </section>

      <section>
        <h2>6. International transfers and security</h2>
        <p>
          Some of our providers may process information outside the United Kingdom. Where required,
          we use recognised transfer mechanisms and contractual safeguards. We use access controls,
          encryption in transit and database security controls designed to protect personal data. No
          online service can guarantee absolute security.
        </p>
      </section>

      <section>
        <h2>7. How long we keep information</h2>
        <p>
          We keep active account, booking and lesson information while an account is in use. If you
          delete your account, we remove or anonymise profile information and future bookings where
          appropriate. We may retain transaction, tax, accounting, payment, dispute, fraud-prevention
          and security records for as long as required or permitted by law, which may be up to seven
          years for accounting records.
        </p>
        <p>
          We keep waitlist information only for as long as needed to manage early access and launch
          communications, or until you ask us to stop. Security logs and failed synchronisation
          records are retained only for as long as reasonably needed for security, reliability and
          dispute handling.
        </p>
        <p>
          An optional ADI badge image is kept only while an instructor application is reviewed and is
          deleted after the decision. We retain the minimal verification record &mdash; ADI number,
          badge expiry, check method, date, reviewer and recheck date &mdash; while the instructor account
          remains active and as needed for disputes or legal obligations. We do not request or retain DBS
          certificates. You can ask about or request deletion of application information by emailing <a
            href="mailto:support@newdryve.com" class={linkClass}>support@newdryve.com</a>.
        </p>
      </section>

      <section>
        <h2>8. Your rights and choices</h2>
        <p>
          Depending on the law that applies to you, you may ask for access to your personal data,
          correction, deletion, restriction, portability, or an objection to certain processing. You
          may withdraw consent where we rely on it. We may need to verify your identity before acting
          on a request.
        </p>
        <p>
          To make a request, email <a href="mailto:support@newdryve.com" class={linkClass}
            >support@newdryve.com</a
          >. You can also complain to the UK Information Commissioner&apos;s Office if you are
          unhappy with how we handle your information.
        </p>
      </section>

      <section>
        <h2>9. Deleting your account</h2>
        <p>
          You can request account deletion through Account settings in the app, by using our <a
            href="/datadeletion"
            class={linkClass}>data deletion request form</a
          >, or by emailing <a href="mailto:support@newdryve.com" class={linkClass}
            >support@newdryve.com</a
          >. Deleting the app from your device does not delete your Newdryve account.
        </p>
      </section>

      <section>
        <h2>10. Children</h2>
        <p>
          Newdryve is not directed to children under 13. Learner drivers under 18 should use the
          service with a parent or guardian&apos;s awareness, as set out in our <a
            href="/terms"
            class={linkClass}>Terms and Conditions</a
          >.
        </p>
      </section>

      <section>
        <h2>11. Changes to this policy</h2>
        <p>
          We may update this policy when our services or legal obligations change. We will publish
          the updated version here and change the date at the top of this page. If a change is
          material, we will take reasonable steps to notify affected users.
        </p>
      </section>
    </div>
  </div>
</BaseLayout>
