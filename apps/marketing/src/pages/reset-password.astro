---
/**
 * Ported from app/reset-password/page.tsx.
 *
 * Talks to the PRODUCT Supabase project (the live app's auth project), which is
 * deliberately separate from the internal ops project. Client-side only, using
 * the public publishable key, exactly as before.
 *
 * Env: PUBLIC_PRODUCT_SUPABASE_URL, PUBLIC_PRODUCT_SUPABASE_ANON_KEY
 * (renamed from NEXT_PUBLIC_* because Astro only exposes PUBLIC_* to the browser).
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const title = 'Set a new password | Newdryve';
const description = 'Choose a new password for your Newdryve account.';

const productUrl = import.meta.env.PUBLIC_PRODUCT_SUPABASE_URL ?? '';
const productKey = import.meta.env.PUBLIC_PRODUCT_SUPABASE_ANON_KEY ?? '';

const inputClass =
  'focus-ring mt-2 block h-12 w-full rounded-xl border border-border bg-white px-3 text-base text-ink outline-none transition focus:border-racing-green';
---

<BaseLayout title={title} description={description} path="/reset-password" noindex>
  <div class="mx-auto flex max-w-md flex-col justify-center px-5 py-12 sm:py-20">
    <section
      class="rounded-2xl border border-border bg-white p-6 shadow-[0_20px_50px_-30px_rgba(10,10,20,0.22)] sm:p-8"
      data-reset-root
      data-supabase-url={productUrl}
      data-supabase-key={productKey}
    >
      <p class="text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink">
        Account security
      </p>
      <h1 class="font-display mt-3 text-3xl font-semibold leading-tight text-ink">
        Set a new password
      </h1>
      <p class="mt-3 text-sm leading-relaxed text-ink-secondary">
        Choose a new password for your Newdryve account. You will then sign in again in the app.
      </p>

      <form class="mt-7 space-y-5" data-reset-form novalidate>
        <div>
          <label class="block text-sm font-bold text-ink" for="password">New password</label>
          <input
            id="password"
            name="password"
            type="password"
            autocomplete="new-password"
            minlength="8"
            required
            class={inputClass}
          />
          <p class="mt-2 text-xs text-ink-muted">Use at least 8 characters.</p>
        </div>

        <div>
          <label class="block text-sm font-bold text-ink" for="confirmation"
            >Confirm new password</label
          >
          <input
            id="confirmation"
            name="confirmation"
            type="password"
            autocomplete="new-password"
            minlength="8"
            required
            class={inputClass}
          />
        </div>

        <p
          data-reset-error
          role="alert"
          class="hidden rounded-xl border border-deep-rose/30 bg-deep-rose/10 px-4 py-3 text-sm leading-relaxed text-deep-rose-ink"
        >
        </p>

        <button
          type="submit"
          data-reset-submit
          class="focus-ring inline-flex h-12 w-full items-center justify-center rounded-full bg-racing-green px-5 text-sm font-bold text-white transition hover:bg-racing-green-dark disabled:cursor-not-allowed disabled:opacity-60"
        >
          <span data-reset-submit-label>Update password</span>
        </button>
      </form>

      <div
        data-reset-success
        hidden
        role="status"
        class="mt-7 rounded-xl border border-racing-green/30 bg-racing-green/10 px-4 py-3 text-sm leading-relaxed text-racing-green"
      >
        Your password has been updated. Return to the Newdryve app and sign in.
      </div>

      <p class="mt-7 border-t border-border pt-5 text-sm leading-relaxed text-ink-secondary">
        Need help? Contact <a
          class="focus-ring rounded font-semibold text-racing-green underline underline-offset-2"
          href="mailto:support@newdryve.com">support@newdryve.com</a
        >.
      </p>
    </section>
  </div>
</BaseLayout>

<script>
  import { createClient } from '@supabase/supabase-js';

  const root = document.querySelector<HTMLElement>('[data-reset-root]');
  const form = root?.querySelector<HTMLFormElement>('[data-reset-form]');
  const errorEl = root?.querySelector<HTMLElement>('[data-reset-error]');
  const success = root?.querySelector<HTMLElement>('[data-reset-success]');
  const button = root?.querySelector<HTMLButtonElement>('[data-reset-submit]');
  const buttonLabel = root?.querySelector<HTMLElement>('[data-reset-submit-label]');

  if (root && form && errorEl && success && button && buttonLabel) {
    const url = root.dataset.supabaseUrl || '';
    const key = root.dataset.supabaseKey || '';

    const supabase =
      url && key
        ? createClient(url, key, {
            auth: {
              persistSession: false,
              autoRefreshToken: false,
              // Supports Supabase's default recovery redirect, which returns the
              // recovery session in the URL fragment after email verification.
              detectSessionInUrl: true,
            },
          })
        : null;

    const showError = (message: string) => {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
    };

    const params = new URLSearchParams(window.location.search);
    const tokenHash = params.get('token_hash');
    const recoveryType = params.get('type');

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      errorEl.classList.add('hidden');

      if (!supabase) {
        showError('Password reset is temporarily unavailable. Please try again shortly.');
        return;
      }

      const data = new FormData(form);
      const password = String(data.get('password') || '');
      const confirmation = String(data.get('confirmation') || '');

      if (password.length < 8) {
        showError('Choose a password with at least 8 characters.');
        return;
      }
      if (password !== confirmation) {
        showError('The passwords do not match.');
        return;
      }

      button.disabled = true;
      buttonLabel.textContent = 'Updating password...';

      const expiredMessage =
        'This reset link has expired or has already been used. Request a new one from the Newdryve app.';

      try {
        const { data: sessionData } = await supabase.auth.getSession();

        if (!sessionData.session) {
          if (!tokenHash || recoveryType !== 'recovery') {
            showError(expiredMessage);
            return;
          }

          const { error: verificationError } = await supabase.auth.verifyOtp({
            token_hash: tokenHash,
            type: 'recovery',
          });

          if (verificationError) {
            showError(expiredMessage);
            return;
          }
        }

        const { error: updateError } = await supabase.auth.updateUser({ password });
        await supabase.auth.signOut();

        if (updateError) {
          showError('We could not update your password. Please try again or request a new reset link.');
          return;
        }

        form.hidden = true;
        success.hidden = false;
      } finally {
        button.disabled = false;
        buttonLabel.textContent = 'Update password';
      }
    });
  }
</script>
