---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProductPreview from '../components/ProductPreview.astro';
import Faq from '../components/Faq.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { PRICING, BRAND } from '../config/site';
import { INSTRUCTOR_FEATURES, SCHOOL_FEATURES } from '../content/instructor-features';
import {
  organizationSchema,
  instructorAppSchema,
  breadcrumbSchema,
  faqSchema,
  type FaqItem,
} from '../lib/schema';

const title = 'Driving Instructor App: Diary, Pupils, Payments and New Learners | Newdryve';
const description =
  'The all-in-one app for driving instructors: diary, pupils, DVSA progress tracking, payments, expenses and cancellation protection, plus new learners. GBP29/month, 0% commission.';

const FAQ_ITEMS: readonly FaqItem[] = [
  {
    q: 'Can I bring my existing pupils onto Newdryve?',
    a: 'Yes. Send your pupils your own Newdryve link. Once they sign in it takes them straight to your profile, where they book their lessons with you. Pupils you have not moved over yet can still go in your diary: block out the time by hand. Payments, cancellation protection and progress tracking work once a pupil is on Newdryve.',
  },
  {
    q: 'Can Newdryve replace TotalDrive or another driving instructor app?',
    a: 'For most instructors, yes. Newdryve covers the day-to-day: diary and availability, your pupils and their lesson history, progress mapped to the DVSA test, card, cash and bank-transfer payments, earnings, receipt scanning and PDF and CSV exports for your accountant. On top of that it brings you new learners and charges late cancellations automatically. Notes and progress stored in your old app do not transfer automatically, and we sit down with you to help move your pupils across.',
  },
  {
    q: 'Do my pupils need the app?',
    a: 'To use payments, cancellation protection and progress tracking, yes: they download Newdryve and sign in with your link. Until then you can keep them in your diary by blocking out their lesson times.',
  },
  {
    q: 'Can I give my figures to my accountant?',
    a: 'Yes. Newdryve tracks your earnings and the expenses you scan from receipts, and exports them as PDF and CSV files to send to your accountant. It does not file your tax return.',
  },
  {
    q: 'Is it on iPhone and Android?',
    a: 'Yes. Newdryve is on the App Store and Google Play.',
  },
  {
    q: 'How do I get paid?',
    a: 'At the end of each lesson, you choose whether the learner pays by cash, bank transfer or card through Stripe. Newdryve takes 0% commission from lesson payments. Stripe’s standard processing fee applies only when you choose card payment.',
  },
  {
    q: 'How does the late cancellation charge actually work?',
    a: 'Every learner must keep a valid card saved to their account before they can book. Nothing is charged when they book. If the learner cancels within 24 hours of the lesson, a 50% cancellation fee is automatically charged through Stripe and sent to you, rising to the full lesson price within 30 minutes of the start. Newdryve takes no commission; Stripe’s standard processing fee applies.',
  },
  {
    q: 'Do I keep my own pricing?',
    a: 'Yes. You set your own hourly rate, your own availability and the areas you cover. Newdryve never sets your prices or takes a percentage of them.',
  },
  {
    q: 'What areas do you cover?',
    a: 'Newdryve is live in Norwich and the surrounding Norfolk area, and we are expanding across the UK from there. We are also building towards HGV, motorcycle and trade instruction. If you teach outside Norwich, apply anyway and we will tell you when we reach you.',
  },
  {
    q: 'How do I join?',
    a: 'Apply on this page with your ADI details. We are onboarding founding instructors in small groups so we can get each one set up properly. Membership is £29 per month with 0% Newdryve commission.',
  },
  {
    q: 'What do I need to qualify?',
    a: 'You need a current ADI registration. With your permission, we verify it through the GOV.UK directory or directly with DVSA before your profile goes live. DVSA already handles the required criminal-record suitability checks.',
  },
];

const SOLUTION = [
  {
    step: '01',
    title: 'Set up your diary',
    body: 'Add your rate, the areas you cover, your working hours and travel time. Learners can only ever book the slots you really have free.',
    accent: 'green' as const,
  },
  {
    step: '02',
    title: 'Bring your pupils, get new ones',
    body: 'Send your existing pupils your link and they book you directly. New learners searching in your area find your profile and book too, each with a card on file.',
    accent: 'green' as const,
  },
  {
    step: '03',
    title: 'Teach, track and get paid',
    body: `Record progress against the DVSA test, take card, cash or bank transfer, and let Newdryve charge late cancellations for you: ${PRICING.lateCancellationShare} within ${PRICING.lateCancellationWindow}, the full price within ${PRICING.finalCancellationWindow}.`,
    accent: 'pink' as const,
  },
];

const SWITCH_STEPS = [
  {
    title: 'We set you up in person',
    body: 'We sit down with you, set up your profile and diary with you, and show you round the app.',
  },
  {
    title: 'We help move your pupils across',
    body: 'Send your pupils your link and they land on your profile to book. We help you onboard them, and you can block out time for anyone not moved over yet.',
  },
  {
    title: 'Your diary carries on',
    body: 'Your working hours, prices and areas are yours to set, so the week you are used to carries straight on.',
  },
];

const jsonLd = [
  organizationSchema,
  instructorAppSchema,
  faqSchema(FAQ_ITEMS),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'For instructors', path: '/instructors' },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  path="/instructors"
  jsonLd={jsonLd}
  audience="instructor"
>
  <!-- HERO -->
  <section class="hero-bg relative overflow-hidden">
    <div class="dot-pattern pointer-events-none absolute inset-0 opacity-50" aria-hidden="true"></div>
    <div
      class="relative mx-auto grid max-w-6xl grid-cols-1 items-center gap-10 px-5 pb-16 pt-10 md:grid-cols-[1.05fr_1fr] md:pb-24 md:pt-20 lg:gap-16"
    >
      <div class="min-w-0">
        <span
          class="inline-flex items-center gap-2 rounded-full border border-blush-border bg-blush-surface px-3 py-1.5 text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink"
        >
          <span class="size-1.5 rounded-full bg-deep-rose" aria-hidden="true"></span>
          For driving instructors
        </span>

        <h1
          class="font-display mt-5 text-[clamp(36px,6.5vw,60px)] font-semibold leading-[1.03] tracking-[-1.5px] text-balance"
        >
          Run your business. Fill your diary. <span class="gradient-text">Protect your income.</span>
        </h1>

        <p class="mt-6 max-w-xl text-lg leading-relaxed text-ink-secondary text-pretty">
          Everything you use an instructor app for, in one place: your diary, your pupils, progress
          mapped to the DVSA test, payments and expenses. Plus a marketplace that brings new learners
          to you, and late cancellations charged automatically.
        </p>

        <div class="mt-7 flex flex-col gap-3 sm:flex-row sm:flex-wrap sm:items-center">
          <a
            href="/instructors/apply"
            class="focus-ring inline-flex min-h-11 items-center justify-center gap-1.5 rounded-full bg-deep-rose px-6 py-3.5 text-sm font-bold text-white shadow-[0_10px_28px_-10px_rgba(232,82,122,0.6)] transition-transform hover:bg-[#d8406b] motion-safe:hover:-translate-y-0.5"
          >
            Apply as a founding instructor
            <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
              <path
                d="M2.5 6h7M6 2.5 9.5 6 6 9.5"
                stroke="currentColor"
                stroke-width="1.75"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </a>
          <a
            href="/instructors/features"
            class="focus-ring inline-flex min-h-11 items-center justify-center gap-1.5 rounded-full border border-border bg-white px-6 py-3.5 text-sm font-bold text-ink transition-transform hover:border-ink motion-safe:hover:-translate-y-0.5"
          >
            See every feature
          </a>
        </div>

        <ul class="mt-6 flex flex-wrap items-center gap-x-5 gap-y-2 text-sm font-semibold">
          {
            [PRICING.commission + ' Newdryve commission', PRICING.monthlyWithPeriod, 'On iPhone and Android'].map(
              (item) => (
                <li class="inline-flex items-center gap-1.5 text-racing-green">
                  <svg width="14" height="14" viewBox="0 0 14 14" fill="none" aria-hidden="true">
                    <circle cx="7" cy="7" r="6" stroke="currentColor" stroke-width="1.5" />
                    <path d="M4 7l2 2 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                  {item}
                </li>
              )
            )
          }
        </ul>
      </div>

      <div class="flex justify-center md:justify-end">
        <ProductPreview
          variant="instructor-profile"
          caption="How your profile is presented to learners. Sample data shown."
          float
        />
      </div>
    </div>
  </section>

  <!-- EVERYTHING YOUR BUSINESS NEEDS -->
  <section id="features" class="scroll-mt-20 bg-canvas">
    <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
      <div class="reveal max-w-2xl">
        <p class="mb-3 text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink">
          One app for the whole job
        </p>
        <h2
          class="font-display text-[clamp(30px,4.5vw,46px)] font-semibold leading-[1.08] tracking-[-1px] text-balance"
        >
          Everything your business needs. Nothing extra to juggle.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-ink-secondary text-pretty">
          Newdryve is your instructor management app and your source of new pupils in one. No separate
          diary app, no spreadsheet of who owes what, no chasing cancellations.
        </p>
      </div>

      <ul class="mt-12 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {
          INSTRUCTOR_FEATURES.map((feature, index) => (
            <li class="reveal rounded-2xl border border-border bg-white p-6" data-reveal-delay={(index % 3) * 100}>
              <h3 class="text-lg font-bold tracking-[-0.3px]">{feature.title}</h3>
              <p class="mt-2 text-sm leading-relaxed text-ink-secondary">{feature.summary}</p>
            </li>
          ))
        }
      </ul>

      <div class="reveal mt-5 flex flex-col gap-4 rounded-2xl border border-blush-border bg-blush-surface p-6 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h3 class="text-lg font-bold tracking-[-0.3px]">{SCHOOL_FEATURES.title}</h3>
          <p class="mt-1 max-w-2xl text-sm leading-relaxed text-ink-secondary">{SCHOOL_FEATURES.body}</p>
        </div>
        <a
          href={`mailto:${BRAND.email}?subject=Newdryve%20for%20driving%20schools`}
          class="focus-ring inline-flex min-h-11 shrink-0 items-center justify-center rounded-full border border-ink/15 bg-white px-5 py-3 text-sm font-bold text-ink"
        >
          Talk to us
        </a>
      </div>

      <a
        href="/instructors/features"
        class="focus-ring mt-8 inline-flex min-h-11 items-center gap-1.5 rounded text-sm font-bold text-racing-green underline underline-offset-4"
      >
        See every feature in detail
      </a>
    </div>
  </section>

  <!-- THE PROBLEM -->
  <section class="border-y border-border bg-white">
    <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
      <div class="grid items-center gap-12 md:grid-cols-2 lg:gap-20">
        <div class="reveal">
          <p class="mb-3 text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink">
            The problem
          </p>
          <h2
            class="font-display text-[clamp(30px,4.5vw,46px)] font-semibold leading-[1.08] tracking-[-1px] text-balance"
          >
            A cancelled lesson is a hole in your week you cannot fill.
          </h2>
          <div class="mt-6 space-y-4 text-base leading-relaxed text-ink-secondary text-pretty">
            <p>
              Someone cancels the night before. That two-hour slot is gone. You cannot fill it at
              short notice, you are already in the car park, and the lesson you planned your day
              around pays nothing.
            </p>
            <p>
              Then there is the rest of it: gaps in the diary you fill by posting in local Facebook
              groups, learners who go quiet for three weeks, and payments you have to ask for twice.
            </p>
          </div>
        </div>

        <div class="reveal rounded-2xl border border-border bg-canvas p-7" data-reveal-delay="100">
          <p class="text-[11px] font-bold uppercase tracking-[1px] text-ink-muted">
            Do the arithmetic yourself
          </p>
          <dl class="mt-5 space-y-4 text-sm">
            <div class="flex items-baseline justify-between gap-4 border-b border-border pb-4">
              <dt class="text-ink-secondary">One 2-hour lesson at £38/hr</dt>
              <dd class="font-bold tabular-nums">£76</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-border pb-4">
              <dt class="text-ink-secondary">Cancelled once a week</dt>
              <dd class="font-bold tabular-nums">£76 / week</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4 border-b border-border pb-4">
              <dt class="text-ink-secondary">Across a 48-week teaching year</dt>
              <dd class="text-deep-rose-ink font-bold tabular-nums">&minus; £3,648</dd>
            </div>
            <div class="flex items-baseline justify-between gap-4">
              <dt class="text-ink-secondary">Recovered by Newdryve at 50%</dt>
              <dd class="font-bold tabular-nums text-racing-green">+ £1,824</dd>
            </div>
          </dl>
          <p class="mt-5 text-xs leading-relaxed text-ink-muted">
            A worked example using a £38 hourly rate, not a survey figure. Swap in your own rate and
            cancellation rate to see where you land.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- THE SOLUTION -->
  <section id="how-it-works" class="bg-canvas">
    <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
      <div class="reveal max-w-2xl">
        <p class="mb-3 text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink">
          How Newdryve works for you
        </p>
        <h2
          class="font-display text-[clamp(30px,4.5vw,46px)] font-semibold leading-[1.08] tracking-[-1px] text-balance"
        >
          Your diary, your pupils, your income protected.
        </h2>
      </div>

      <ol class="mt-12 grid gap-6 md:grid-cols-3">
        {
          SOLUTION.map((item, index) => (
            <li
              class={`reveal rounded-2xl border p-7 ${
                item.accent === 'pink'
                  ? 'border-blush-border bg-blush-surface'
                  : 'border-border bg-white'
              }`}
              data-reveal-delay={index * 100}
            >
              <span
                class={`font-display text-3xl font-semibold tabular-nums ${
                  item.accent === 'pink' ? 'text-deep-rose' : 'text-ink-muted'
                }`}
              >
                {item.step}
              </span>
              <h3 class="mt-4 text-xl font-bold tracking-[-0.3px]">{item.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-ink-secondary">{item.body}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- SWITCHING FROM ANOTHER APP -->
  <section id="switching" class="scroll-mt-20 border-y border-border bg-ink text-white">
    <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
      <div class="reveal max-w-2xl">
        <p class="mb-3 text-[11px] font-bold uppercase tracking-[1px] text-deep-rose">
          Switching from another app
        </p>
        <h2
          class="font-display text-[clamp(30px,4.5vw,46px)] font-semibold leading-[1.08] tracking-[-1px] text-balance"
        >
          Moving over is easier than you think. We do it with you.
        </h2>
        <p class="mt-5 text-base leading-relaxed text-white/70 text-pretty">
          You should not have to rebuild your business to change app. We sit down with you, teach
          you Newdryve and help bring your existing pupils across.
        </p>
      </div>

      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {
          SWITCH_STEPS.map((item, index) => (
            <li class="reveal rounded-2xl border border-white/15 bg-white/5 p-7" data-reveal-delay={index * 100}>
              <span class="font-display text-3xl font-semibold tabular-nums text-deep-rose">0{index + 1}</span>
              <h3 class="mt-4 text-lg font-bold tracking-[-0.3px]">{item.title}</h3>
              <p class="mt-2.5 text-sm leading-relaxed text-white/70">{item.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="reveal mt-12 grid gap-8 border-t border-white/15 pt-10 md:grid-cols-2">
        <div>
          <h3 class="text-lg font-bold tracking-[-0.3px]">Coming from TotalDrive, MyDriveTime or another diary app?</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/70 text-pretty">
            Your diary, pupils, progress tracking, payments, earnings, receipts and accountant
            exports are all in Newdryve. Diary apps are built to organise the pupils you already
            have; Newdryve also brings you new learners and charges late cancellations
            automatically, for {PRICING.monthlyWithPeriod} with {PRICING.commission} commission.
          </p>
        </div>
        <div>
          <h3 class="text-lg font-bold tracking-[-0.3px]">What does not come with you</h3>
          <p class="mt-3 text-sm leading-relaxed text-white/70 text-pretty">
            Notes and progress records kept in your old app are tied to that app and do not transfer
            automatically. Once a pupil is on Newdryve, everything from then on is recorded against
            them, and it belongs to them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="scroll-mt-20 bg-canvas">
    <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
      <div class="reveal mx-auto mb-10 max-w-2xl text-center">
        <p class="mb-3 text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink">Pricing</p>
        <h2
          class="font-display text-[clamp(30px,4.5vw,46px)] font-semibold leading-[1.08] tracking-[-1px] text-balance"
        >
          One flat fee. No commission, ever.
        </h2>
      </div>

      <div class="reveal mx-auto max-w-md rounded-3xl border border-border bg-white p-8 text-center shadow-[0_20px_60px_-20px_rgba(0,0,0,0.1)]">
        <p class="text-[11px] font-bold uppercase tracking-[1px] text-ink-muted">
          Instructor subscription
        </p>
        <p class="mt-4 flex items-baseline justify-center gap-1">
          <span class="font-display text-6xl font-semibold tracking-[-2px] tabular-nums"
            >{PRICING.monthly}</span
          >
          <span class="text-lg font-semibold text-ink-secondary">/month</span>
        </p>

        <ul class="mt-8 space-y-3.5 text-left text-sm">
          {
            [
              `${PRICING.commission} Newdryve commission on lesson payments`,
              'Diary, pupils and progress mapped to the DVSA test',
              'Card, cash or bank transfer; Stripe fees only on card',
              'Earnings, receipt scanning, PDF and CSV exports',
              'New learners from the Newdryve marketplace',
              `${PRICING.lateCancellationShare} fee within ${PRICING.lateCancellationWindow}, full price within ${PRICING.finalCancellationWindow}`,
              'Help moving your existing pupils across',
              PRICING.cancelAnytime,
            ].map((item) => (
              <li class="flex items-start gap-2.5">
                <span
                  class="mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full bg-racing-green/10 text-racing-green"
                  aria-hidden="true"
                >
                  <svg width="12" height="12" viewBox="0 0 14 14" fill="none">
                    <path d="M3 7l3 3 5-6" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
                  </svg>
                </span>
                <span class="leading-relaxed text-ink-secondary">{item}</span>
              </li>
            ))
          }
        </ul>

        <a
          href="/instructors/apply"
          class="focus-ring mt-8 inline-flex min-h-11 w-full items-center justify-center gap-1.5 rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white transition-transform hover:bg-[#1a1a2c] motion-safe:hover:-translate-y-0.5"
        >
          Apply as a founding instructor
        </a>
        <p class="mt-4 text-xs leading-relaxed text-ink-muted">
          {PRICING.billingCancellation} You will not be charged again.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="border-y border-border bg-white">
    <div class="mx-auto max-w-6xl px-5 py-16 md:py-24">
      <div class="reveal mx-auto mb-10 max-w-2xl text-center">
        <p class="mb-3 text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink">
          Frequently asked
        </p>
        <h2
          class="font-display text-[clamp(30px,4.5vw,44px)] font-semibold leading-[1.1] tracking-[-1px] text-balance"
        >
          Instructor questions.
        </h2>
      </div>
      <Faq items={FAQ_ITEMS} />
    </div>
  </section>

  <!-- APPLY -->
  <section id="apply" class="scroll-mt-20 bg-canvas">
    <div class="mx-auto max-w-3xl px-5 py-16 md:py-24">
      <div class="reveal mb-8 text-center">
        <p class="mb-3 text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink">
          For instructors
        </p>
        <h2
          class="font-display text-[clamp(28px,4vw,40px)] font-semibold leading-[1.1] tracking-[-1px] text-balance"
        >
          Apply as a founding instructor.
        </h2>
        <p class="mx-auto mt-4 max-w-xl text-base leading-relaxed text-ink-secondary">
          You&rsquo;re applying for a real account, not a waiting list. Set up your profile and
          choose your password now; we check your current DVSA registration and approve you by hand, usually
          within a day or two.
        </p>
      </div>

      <div class="reveal rounded-2xl border border-border bg-white p-6 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.08)] sm:p-8">
        <p class="text-[11px] font-bold uppercase tracking-[1px] text-ink-muted">
          What you&rsquo;ll need
        </p>
        <ul class="mt-4 space-y-3 text-sm leading-relaxed text-ink-secondary">
          {
            [
              'Your ADI number and badge expiry date.',
              'Permission for Newdryve to confirm your current registration with DVSA.',
              'Your hourly rate, the areas you cover and roughly when you teach.',
              'About five minutes.',
            ].map((item) => (
              <li class="flex gap-3">
                <svg
                  width="18"
                  height="18"
                  viewBox="0 0 22 22"
                  fill="none"
                  aria-hidden="true"
                  class="mt-0.5 shrink-0 text-racing-green"
                >
                  <path
                    d="M5 11l4 4 8-9"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  />
                </svg>
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <a
          href="/instructors/apply"
          class="focus-ring mt-7 inline-flex min-h-11 w-full items-center justify-center gap-1.5 rounded-full bg-deep-rose px-6 py-3.5 text-sm font-bold text-white shadow-[0_10px_28px_-10px_rgba(232,82,122,0.6)] transition-transform hover:bg-[#d8406b] motion-safe:hover:-translate-y-0.5"
        >
          Start your application
          <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path
              d="M2.5 6h7M6 2.5 9.5 6 6 9.5"
              stroke="currentColor"
              stroke-width="1.75"
              stroke-linecap="round"
              stroke-linejoin="round"></path>
          </svg>
        </a>
        <p class="mt-4 text-center text-xs text-ink-muted">
          {PRICING.monthlyWithPeriod}. Newdryve takes 0% commission from lesson payments.
        </p>
      </div>
    </div>
  </section>

