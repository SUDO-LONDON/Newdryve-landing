---
import BaseLayout from '../layouts/BaseLayout.astro';
import Phone from '../components/Phone.astro';
import Car from '../components/Car.astro';
import Scallop from '../components/Scallop.astro';
import Faq from '../components/Faq.astro';
import StoreBadges from '../components/StoreBadges.astro';
import { PRICING, BRAND } from '../config/site';
import { INSTRUCTOR_FEATURES, SCHOOL_FEATURES } from '../content/instructor-features';
import {
  organizationSchema,
  instructorAppSchema,
  breadcrumbSchema,
  faqSchema,
  type FaqItem,
} from '../lib/schema';

const title = 'Driving Instructor App: Diary, Pupils, Payments and New Learners | Newdryve';
const description =
  'The all-in-one app for driving instructors: diary, pupils, DVSA progress tracking, payments, expenses and cancellation protection, plus new learners. GBP29/month, 0% commission.';

const FAQ_ITEMS: readonly FaqItem[] = [
  {
    q: 'Can I bring my existing pupils onto Newdryve?',
    a: 'Yes. Send your pupils your own Newdryve link. Once they sign in it takes them straight to your profile, where they book their lessons with you. Pupils you have not moved over yet can still go in your diary: block out the time by hand. Payments, cancellation protection and progress tracking work once a pupil is on Newdryve.',
  },
  {
    q: 'Can Newdryve replace TotalDrive or another driving instructor app?',
    a: 'For most instructors, yes. Newdryve covers the day-to-day: diary and availability, your pupils and their lesson history, progress mapped to the DVSA test, card, cash and bank-transfer payments, earnings, receipt scanning and PDF and CSV exports for your accountant. On top of that it brings you new learners and charges late cancellations automatically. Notes and progress stored in your old app do not transfer automatically, and we sit down with you to help move your pupils across.',
  },
  {
    q: 'Do my pupils need the app?',
    a: 'To use payments, cancellation protection and progress tracking, yes: they download Newdryve and sign in with your link. Until then you can keep them in your diary by blocking out their lesson times.',
  },
  {
    q: 'Can I give my figures to my accountant?',
    a: 'Yes. Newdryve tracks your earnings and the expenses you scan from receipts, and exports them as PDF and CSV files to send to your accountant. It does not file your tax return.',
  },
  {
    q: 'Is it on iPhone and Android?',
    a: 'Yes. Newdryve is on the App Store and Google Play.',
  },
  {
    q: 'How do I get paid?',
    a: 'At the end of each lesson, you choose whether the learner pays by cash, bank transfer or card through Stripe. Newdryve takes 0% commission from lesson payments. Stripe’s standard processing fee applies only when you choose card payment.',
  },
  {
    q: 'How does the late cancellation charge actually work?',
    a: 'Every learner must keep a valid card saved to their account before they can book. Nothing is charged when they book. If the learner cancels within 24 hours of the lesson, a 50% cancellation fee is automatically charged through Stripe and sent to you, rising to the full lesson price within 30 minutes of the start. Newdryve takes no commission; Stripe’s standard processing fee applies.',
  },
  {
    q: 'Do I keep my own pricing?',
    a: 'Yes. You set your own hourly rate, your own availability and the areas you cover. Newdryve never sets your prices or takes a percentage of them.',
  },
  {
    q: 'What areas do you cover?',
    a: 'Newdryve is live in Norwich and the surrounding Norfolk area, and we are expanding across the UK from there. We are also building towards HGV, motorcycle and trade instruction. If you teach outside Norwich, apply anyway and we will tell you when we reach you.',
  },
  {
    q: 'How do I join?',
    a: 'Apply on this page with your ADI details. We are onboarding founding instructors in small groups so we can get each one set up properly. Membership is £29 per month with 0% Newdryve commission.',
  },
  {
    q: 'What do I need to qualify?',
    a: 'You need a current ADI registration. With your permission, we verify it through the GOV.UK directory or directly with DVSA before your profile goes live. DVSA already handles the required criminal-record suitability checks.',
  },
];

const SOLUTION = [
  {
    step: '01',
    title: 'Set up your diary',
    body: 'Add your rate, the areas you cover, your working hours and travel time. Learners can only ever book the slots you really have free.',
    accent: 'green' as const,
  },
  {
    step: '02',
    title: 'Bring your pupils, get new ones',
    body: 'Send your existing pupils your link and they book you directly. New learners searching in your area find your profile and book too, each with a card on file.',
    accent: 'green' as const,
  },
  {
    step: '03',
    title: 'Teach, track and get paid',
    body: `Record progress against the DVSA test, take card, cash or bank transfer, and let Newdryve charge late cancellations for you: ${PRICING.lateCancellationShare} within ${PRICING.lateCancellationWindow}, the full price within ${PRICING.finalCancellationWindow}.`,
    accent: 'pink' as const,
  },
];

const SWITCH_STEPS = [
  {
    title: 'We set you up in person',
    body: 'We sit down with you, set up your profile and diary with you, and show you round the app.',
  },
  {
    title: 'We help move your pupils across',
    body: 'Send your pupils your link and they land on your profile to book. We help you onboard them, and you can block out time for anyone not moved over yet.',
  },
  {
    title: 'Your diary carries on',
    body: 'Your working hours, prices and areas are yours to set, so the week you are used to carries straight on.',
  },
];

const PRICING_POINTS = [
  `${PRICING.commission} Newdryve commission on lesson payments`,
  'Diary, pupils and progress mapped to the DVSA test',
  'Card, cash or bank transfer; Stripe fees only on card',
  'Earnings, receipt scanning, PDF and CSV exports',
  'New learners from the Newdryve marketplace',
  `${PRICING.lateCancellationShare} fee within ${PRICING.lateCancellationWindow}, full price within ${PRICING.finalCancellationWindow}`,
  'Help moving your existing pupils across',
  PRICING.cancelAnytime,
];

const APPLY_NEEDS = [
  'Your ADI number and badge expiry date.',
  'Permission for Newdryve to confirm your current registration with DVSA.',
  'Your hourly rate, the areas you cover and roughly when you teach.',
  'About five minutes.',
];

/* The worked cancellation example. Defaults match the original copy: one
   2-hour lesson a week at £38/hr over a 48-week teaching year. The script at
   the bottom of the page recalculates these when the instructor changes the
   rate or the number of cancellations. */
const CALC = {
  rate: 38,
  hours: 2,
  perWeek: 1,
  weeks: 48,
  share: Number.parseInt(PRICING.lateCancellationShare, 10),
};
const gbp = new Intl.NumberFormat('en-GB', { maximumFractionDigits: 0 });
const calcLesson = CALC.rate * CALC.hours;
const calcWeek = calcLesson * CALC.perWeek;
const calcYear = calcWeek * CALC.weeks;
const calcBack = (calcYear * CALC.share) / 100;

/* How each feature sits in the overview grid. Three carry an app screen and
   take two rows; the rest are text tiles. Placement classes are written out
   in full so Tailwind sees them. */
const FEATURE_TILES: Record<string, { place: string; tone?: string; screen?: string; alt?: string }> = {
  diary: {
    place: 'lg:col-start-1 lg:row-start-1 lg:row-span-2',
    tone: 'bg-avatar-tile',
    screen: 'instructor-iCalendar',
    alt: 'The newdryve instructor calendar for a Saturday, with lessons, a mock test, lunch and travel time to the next pick-up',
  },
  pupils: { place: 'lg:col-start-2 lg:row-start-1' },
  progress: {
    place: 'lg:col-start-3 lg:row-start-1 lg:row-span-2',
    tone: 'bg-pink',
    screen: 'learner-progress',
    alt: 'The newdryve progress screen: 12 of 27 skills signed off, with strengths and what to focus on next',
  },
  payments: { place: 'lg:col-start-2 lg:row-start-2' },
  cancellations: { place: 'lg:col-start-1 lg:row-start-3' },
  'road-board': {
    place: 'lg:col-start-2 lg:row-start-3 lg:row-span-2',
    tone: 'bg-chip',
    screen: 'instructor-roadBoard',
    alt: 'Road Board in newdryve: a roundabout drawn on screen with three cars and an arrow showing who gives way',
  },
  money: { place: 'lg:col-start-3 lg:row-start-3' },
  messages: { place: 'lg:col-start-1 lg:row-start-4' },
  'new-learners': { place: 'lg:col-start-3 lg:row-start-4' },
};

const tick = `<svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="mt-1 shrink-0"><path d="M5 12.5l4.5 4.5L19 7.5" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"></path></svg>`;

const jsonLd = [
  organizationSchema,
  instructorAppSchema,
  faqSchema(FAQ_ITEMS),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'For instructors', path: '/instructors' },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  path="/instructors"
  jsonLd={jsonLd}
  audience="instructor"
  footerEdge="pink"
>
  <!-- HERO: mint, continuing the header band -->
  <section class="overflow-hidden bg-mint">
    <div class="nd-container flex flex-wrap items-end gap-x-12 gap-y-10 pt-12 md:pt-[72px]">
      <div class="flex min-w-0 flex-[1.3_1_520px] flex-col items-start pb-12 md:pb-[88px]">
        <p class="nd-hand mb-3 ml-1.5">for driving instructors</p>

        <h1 class="nd-h1">
          run your business. fill your diary. protect your <span class="nd-highlight">income.</span>
        </h1>

        <p class="nd-lede mt-7 max-w-[34em]">
          Your diary, your pupils, progress mapped to the DVSA test, payments and expenses, in one
          app. Plus a marketplace that brings new learners to you, and late cancellations charged
          automatically.
        </p>

        <div class="mt-9 flex w-full flex-col gap-3 sm:w-auto sm:flex-row sm:flex-wrap sm:items-center">
          <a href="/instructors/apply" class="nd-btn nd-btn-lg">Apply as a founding instructor</a>
          <a href="/instructors/features" class="nd-btn-secondary nd-btn-lg">See every feature</a>
        </div>

        <ul class="mt-7 flex flex-wrap gap-x-6 gap-y-2.5 text-base font-semibold">
          {
            [PRICING.commission + ' Newdryve commission', PRICING.monthlyWithPeriod, 'On iPhone and Android'].map(
              (item) => (
                <li class="inline-flex items-center gap-2">
                  <Fragment set:html={tick.replace('mt-1 ', '')} />
                  {item}
                </li>
              )
            )
          }
        </ul>
      </div>

      <!-- The instructor's own screens: today in front, earnings behind. -->
      <div class="relative mx-auto flex h-[430px] w-full max-w-[440px] flex-[1_1_340px] items-end sm:h-[540px]">
        <Phone
          screen="instructor-iEarnings"
          alt="The newdryve earnings screen, with the amount available to pay out and the month's recorded income"
          eager
          crop
          class="absolute right-0 bottom-0 h-[84%] w-[58%] rotate-6 [transform-origin:bottom_right]"
        />
        <Phone
          screen="instructor-iToday"
          alt="The newdryve instructor Today screen: three lessons today, one request, and the next lesson at 3:00pm with a Start lesson button"
          eager
          crop
          class="nd-shadow relative z-10 h-full w-[66%]"
        />
      </div>
    </div>
  </section>

  <!-- THE PROBLEM: the cancellation sum -->
  <section class="bg-pink">
    <Scallop color="mint" />
    <div class="nd-container grid items-center gap-x-16 gap-y-10 py-16 md:py-24 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.1fr)]">
      <div>
        <h2 class="nd-h2">a cancelled lesson is a hole in your week you cannot fill</h2>
        <div class="mt-6 flex max-w-[30em] flex-col gap-4 text-lg">
          <p>
            Someone cancels the night before. That two-hour slot is gone. You cannot fill it at short
            notice, you are already in the car park, and the lesson you planned your day around pays
            nothing.
          </p>
          <p>
            Then there is the rest of it: gaps in the diary you fill by posting in local Facebook
            groups, learners who go quiet for three weeks, and payments you have to ask for twice.
          </p>
        </div>
      </div>

      <div
        class="nd-card-lg nd-shadow flex min-w-0 flex-col gap-6 p-6 sm:p-9"
        data-cancel-calc
        data-hours={CALC.hours}
        data-weeks={CALC.weeks}
        data-share={CALC.share}
      >
        <div>
          <p class="nd-small-label">Do the arithmetic yourself</p>
          <p class="nd-number mt-4 text-[clamp(64px,9vw,132px)] text-hot-pink tabular-nums">
            £<span data-calc="year">{gbp.format(calcYear)}</span>
          </p>
          <p class="mt-5 max-w-[26em] text-lg">
            <strong>lost across a 48-week teaching year.</strong> Newdryve&rsquo;s
            {PRICING.lateCancellationShare} late cancellation fee brings £<span data-calc="back"
              >{gbp.format(calcBack)}</span
            > of it back to you.
          </p>
        </div>

        <div class="grid gap-4 sm:grid-cols-2" data-calc-controls hidden>
          <div class="flex flex-col gap-2">
            <label for="calc-rate" class="nd-label">Your hourly rate (£)</label>
            <input
              id="calc-rate"
              class="nd-input"
              type="number"
              inputmode="decimal"
              min="1"
              max="200"
              step="0.5"
              value={CALC.rate}
            />
          </div>
          <div class="flex flex-col gap-2">
            <label for="calc-freq" class="nd-label">Cancelled 2-hour lessons a week</label>
            <select id="calc-freq" class="nd-input">
              {[1, 2, 3, 4, 5].map((n) => <option value={n} selected={n === CALC.perWeek}>{n}</option>)}
            </select>
          </div>
        </div>

        <dl class="flex flex-col text-[17px]">
          <div class="flex items-baseline justify-between gap-6 border-b-2 border-dashed border-forest py-3">
            <dt>One 2-hour lesson at £<span data-calc="rate">{CALC.rate}</span>/hr</dt>
            <dd class="text-right font-semibold whitespace-nowrap tabular-nums">
              £<span data-calc="lesson">{gbp.format(calcLesson)}</span>
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 border-b-2 border-dashed border-forest py-3">
            <dt>Cancelled <span data-calc="freq">once</span> a week</dt>
            <dd class="text-right font-semibold whitespace-nowrap tabular-nums">
              £<span data-calc="week">{gbp.format(calcWeek)}</span> / week
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 border-b-2 border-dashed border-forest py-3">
            <dt>Across a 48-week teaching year</dt>
            <dd class="text-right font-semibold whitespace-nowrap tabular-nums">
              &minus; £<span data-calc="year">{gbp.format(calcYear)}</span>
            </dd>
          </div>
          <div class="flex items-baseline justify-between gap-6 py-3">
            <dt>Recovered by Newdryve at {PRICING.lateCancellationShare}</dt>
            <dd class="text-right font-semibold whitespace-nowrap tabular-nums">
              + £<span data-calc="back">{gbp.format(calcBack)}</span>
            </dd>
          </div>
        </dl>

        <p class="sr-only" role="status" data-calc-status></p>

        <p class="text-[15px] text-forest-soft">
          A worked example using a £38 hourly rate, not a survey figure. Swap in your own rate and
          cancellation rate to see where you land.
        </p>
      </div>
    </div>
  </section>

  <!-- EVERYTHING YOUR BUSINESS NEEDS -->
  <section id="features" class="nd-section">
    <div class="nd-container">
      <div class="grid gap-x-16 gap-y-5 lg:grid-cols-2 lg:items-end">
        <h2 class="nd-h2">everything your business needs, nothing extra to juggle</h2>
        <p class="text-lg lg:pb-1">
          Newdryve is your instructor management app and your source of new pupils in one. No separate
          diary app, no spreadsheet of who owes what, no chasing cancellations.
        </p>
      </div>

      <ul class="mt-12 grid gap-5 md:grid-cols-2 lg:auto-rows-[204px] lg:grid-cols-3">
        {
          INSTRUCTOR_FEATURES.map((feature) => {
            const tile = FEATURE_TILES[feature.id] ?? { place: '' };
            return (
              <li
                class:list={[
                  'flex flex-col overflow-hidden rounded-[28px]',
                  tile.place,
                  tile.screen ? tile.tone : 'border-2 border-forest',
                ]}
              >
                <div class="p-6 pb-5">
                  <h3 class="font-heading text-[22px] leading-[1.1] font-extrabold tracking-[-0.02em]">
                    <a href={`/instructors/features#${feature.id}`} class="no-underline hover:underline">
                      {feature.title}
                    </a>
                  </h3>
                  <p class="mt-2 text-[17px] leading-snug">{feature.summary}</p>
                </div>
                {tile.screen && (
                  <Phone
                    screen={tile.screen}
                    alt={tile.alt ?? ''}
                    crop
                    class="mx-auto mt-auto h-[230px] w-[74%] max-w-[280px] lg:h-auto lg:min-h-0 lg:flex-1"
                  />
                )}
              </li>
            );
          })
        }
      </ul>

      <div
        class="on-forest mt-5 flex flex-col gap-5 rounded-[28px] bg-forest p-6 text-paper sm:flex-row sm:items-center sm:justify-between sm:p-8"
      >
        <div>
          <h3 class="nd-h4">{SCHOOL_FEATURES.title}</h3>
          <p class="mt-2 max-w-[40em] text-[17px]">{SCHOOL_FEATURES.body}</p>
        </div>
        <a
          href={`mailto:${BRAND.email}?subject=Newdryve%20for%20driving%20schools`}
          class="nd-btn shrink-0 border-mint bg-mint text-forest"
        >
          Talk to us
        </a>
      </div>

      <a
        href="/instructors/features"
        class="mt-8 inline-flex min-h-11 items-center font-semibold underline"
      >
        See every feature in detail
      </a>
    </div>
  </section>

  <!-- HOW IT WORKS -->
  <section id="how-it-works" class="nd-section pt-0 md:pt-0">
    <div class="nd-container">
      <h2 class="nd-h2 max-w-[16em]">your diary, your pupils, your income protected</h2>

      <div class="relative mt-12 md:mt-16">
        <div class="nd-roadline absolute inset-x-0 top-3.5 hidden h-7 md:block" aria-hidden="true"></div>
        <ol class="relative grid gap-x-10 gap-y-10 md:grid-cols-3">
          {
            SOLUTION.map((item, index) => (
              <li class="flex flex-col items-start">
                <span
                  class={`nd-marker ${item.accent === 'pink' ? 'bg-pink' : 'bg-paper'}`}
                  aria-hidden="true"
                >
                  {index + 1}
                </span>
                <h3 class="nd-h3 mt-6">{item.title}</h3>
                <p class="mt-3 max-w-[27em]">{item.body}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- SWITCHING FROM ANOTHER APP -->
  <section id="switching" class="bg-chip">
    <Scallop color="paper" />
    <div class="nd-container py-16 md:py-24">
      <div class="grid items-end gap-x-16 gap-y-5 lg:grid-cols-2">
        <div>
          <p class="nd-hand text-[28px]">switching from another app</p>
          <h2 class="nd-h2 mt-3">moving over is easier than you think. we do it with you</h2>
        </div>
        <p class="nd-lede lg:pb-1">
          You should not have to rebuild your business to change app. We sit down with you, teach
          you Newdryve and help bring your existing pupils across.
        </p>
      </div>

      <ol class="mt-12 grid gap-5 md:grid-cols-3">
        {
          SWITCH_STEPS.map((item, index) => (
            <li class="nd-card flex flex-col items-start p-6">
              <span class="nd-marker" aria-hidden="true">
                {index + 1}
              </span>
              <h3 class="nd-h4 mt-5">{item.title}</h3>
              <p class="mt-2.5 text-[17px]">{item.body}</p>
            </li>
          ))
        }
      </ol>

      <div class="mt-10 grid gap-x-16 gap-y-8 md:grid-cols-2">
        <div>
          <h3 class="text-xl font-semibold">Coming from TotalDrive, MyDriveTime or another diary app?</h3>
          <p class="mt-3 text-[17px]">
            Your diary, pupils, progress tracking, payments, earnings, receipts and accountant
            exports are all in Newdryve. Diary apps are built to organise the pupils you already
            have; Newdryve also brings you new learners and charges late cancellations
            automatically, for {PRICING.monthlyWithPeriod} with {PRICING.commission} commission.
          </p>
        </div>
        <div>
          <h3 class="text-xl font-semibold">What does not come with you</h3>
          <p class="mt-3 text-[17px]">
            Notes and progress records kept in your old app are tied to that app and do not transfer
            automatically. Once a pupil is on Newdryve, everything from then on is recorded against
            them, and it belongs to them.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PRICING -->
  <section id="pricing" class="on-forest bg-forest text-paper">
    <Scallop color="chip" />
    <div class="nd-container grid items-center gap-x-16 gap-y-10 py-16 md:py-24 lg:grid-cols-2">
      <div>
        <p class="nd-hand text-[28px] text-mint">instructor subscription</p>
        <div class="mt-4 flex flex-wrap items-end gap-x-10 gap-y-6">
          <p class="flex items-baseline gap-2.5">
            <span class="nd-number text-[clamp(96px,13vw,176px)] text-mint tabular-nums">{PRICING.monthly}</span>
            <span class="text-xl font-semibold">/month</span>
          </p>
          <p class="flex items-baseline gap-2.5">
            <span class="nd-number text-[clamp(96px,13vw,176px)] text-pink tabular-nums">{PRICING.commission}</span>
            <span class="text-xl font-semibold">commission</span>
          </p>
        </div>
        <h2 class="nd-h2 mt-8">one flat fee, no commission, ever</h2>
        <p class="nd-lede mt-5 max-w-[24em]">Your rates stay yours.</p>
      </div>

      <div class="nd-card-lg p-6 text-forest sm:p-9">
        <ul class="flex flex-col gap-3 text-[17px]">
          {
            PRICING_POINTS.map((item) => (
              <li class="flex items-start gap-3">
                <Fragment set:html={tick} />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <a href="/instructors/apply" class="nd-btn nd-btn-lg mt-8 w-full">
          Apply as a founding instructor
        </a>
        <p class="mt-4 text-[15px] text-forest-soft">
          {PRICING.billingCancellation} You will not be charged again.
        </p>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="nd-section">
    <div class="nd-container grid items-start gap-x-16 gap-y-8 lg:grid-cols-[1fr_1.5fr]">
      <div class="flex flex-col items-start gap-8">
        <h2 class="nd-h2">instructor questions</h2>
        <Car width={240} class="hidden lg:block" />
      </div>
      <Faq items={FAQ_ITEMS} />
    </div>
  </section>

  <!-- APPLY: pink band -->
  <section id="apply" class="bg-pink">
    <div class="nd-container grid items-center gap-x-16 gap-y-10 py-16 md:py-24 lg:grid-cols-2">
      <div>
        <h2 class="nd-h2">apply as a founding instructor</h2>
        <p class="nd-lede mt-6 max-w-[30em]">
          You&rsquo;re applying for a real account, not a waiting list. Set up your profile and choose
          your password now; we check your current DVSA registration and approve you by hand, usually
          within a day or two.
        </p>
        <StoreBadges class="mt-7" />
        <p class="mt-5 text-[17px]">
          Questions? Email <a href={`mailto:${BRAND.email}`} class="font-semibold underline">{BRAND.email}</a>.
        </p>
      </div>

      <div class="nd-card-lg nd-shadow p-6 sm:p-9">
        <h3 class="text-xl font-semibold">What you&rsquo;ll need</h3>
        <ul class="mt-4 flex flex-col">
          {
            APPLY_NEEDS.map((item, index) => (
              <li
                class={`flex gap-3 py-3 text-[17px] ${
                  index > 0 ? 'border-t-2 border-dashed border-forest' : ''
                }`}
              >
                <Fragment set:html={tick} />
                <span>{item}</span>
              </li>
            ))
          }
        </ul>

        <a href="/instructors/apply" class="nd-btn nd-btn-lg mt-6 w-full">Start your application</a>
        <p class="mt-4 text-center text-[15px] text-forest-soft">
          {PRICING.monthlyWithPeriod}. Newdryve takes 0% commission from lesson payments.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Cancellation sum. The figures are rendered on the server with the default
  // example, so this only adds the inputs and keeps the numbers in step.
  const root = document.querySelector<HTMLElement>('[data-cancel-calc]');
  const controls = root?.querySelector<HTMLElement>('[data-calc-controls]');
  const rateInput = root?.querySelector<HTMLInputElement>('#calc-rate');
  const freqInput = root?.querySelector<HTMLSelectElement>('#calc-freq');
  const status = root?.querySelector<HTMLElement>('[data-calc-status]');

  if (root && controls && rateInput && freqInput) {
    const hours = Number(root.dataset.hours) || 2;
    const weeks = Number(root.dataset.weeks) || 48;
    const share = Number(root.dataset.share) || 50;
    const gbp = new Intl.NumberFormat('en-GB', { maximumFractionDigits: 0 });

    const set = (key: string, value: string) => {
      root.querySelectorAll(`[data-calc="${key}"]`).forEach((el) => {
        el.textContent = value;
      });
    };
    const often = (n: number) => (n === 1 ? 'once' : n === 2 ? 'twice' : `${n} times`);

    const update = () => {
      const rate = Number(rateInput.value);
      if (!Number.isFinite(rate) || rate <= 0) return;
      const perWeek = Number(freqInput.value) || 1;
      const lesson = rate * hours;
      const week = lesson * perWeek;
      const year = week * weeks;
      const back = (year * share) / 100;

      set('rate', Number.isInteger(rate) ? String(rate) : rate.toFixed(2));
      set('freq', often(perWeek));
      set('lesson', gbp.format(lesson));
      set('week', gbp.format(week));
      set('year', gbp.format(year));
      set('back', gbp.format(back));
      if (status) {
        status.textContent = `About £${gbp.format(year)} lost a year. £${gbp.format(back)} of it comes back to you.`;
      }
    };

    controls.hidden = false;
    rateInput.addEventListener('input', update);
    freqInput.addEventListener('change', update);
  }
</script>
