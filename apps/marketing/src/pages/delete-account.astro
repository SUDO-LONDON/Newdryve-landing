---
import BaseLayout from '../layouts/BaseLayout.astro';
import { organizationSchema, breadcrumbSchema } from '../lib/schema';

const title = 'Delete Your Newdryve Account';
const description =
  'How learners and driving instructors can delete a Newdryve account and what happens to their data.';

const jsonLd = [
  organizationSchema,
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Delete account', path: '/delete-account' },
  ]),
];

const linkClass = 'focus-ring rounded font-semibold text-ink underline underline-offset-2';
---

<BaseLayout title={title} description={description} path="/delete-account" jsonLd={jsonLd}>
  <main class="mx-auto max-w-3xl px-5 py-16 md:py-24">
    <h1 class="font-display text-[clamp(32px,5vw,48px)] font-semibold leading-[1.05] tracking-[-1px]">
      Delete your Newdryve account
    </h1>
    <p class="mt-4 text-base text-ink-secondary">
      These instructions are for students and instructors using the Newdryve app.
    </p>

    <div class="mt-10 space-y-6">
      <section class="rounded-2xl border border-border bg-white px-5 py-5 md:px-6">
        <h2 class="font-display text-2xl font-semibold text-ink">Delete your account in the app</h2>
        <ol class="mt-4 list-decimal space-y-2 pl-5 leading-relaxed text-ink-secondary marker:font-semibold marker:text-deep-rose">
          <li>Open the Newdryve app and sign in.</li>
          <li>Go to <strong class="text-ink">Account</strong>. Instructors use <strong class="text-ink">Settings → Instructor account</strong>.</li>
          <li>Tap <strong class="text-ink">Delete account</strong>.</li>
          <li>Confirm with <strong class="text-ink">Delete my account</strong>.</li>
        </ol>
      </section>

      <section class="rounded-2xl border border-border bg-white px-5 py-5 md:px-6">
        <h2 class="font-display text-2xl font-semibold text-ink">Can't access the app?</h2>
        <p class="mt-3 leading-relaxed text-ink-secondary">
          Email <a
            href="mailto:support@newdryve.com?subject=Delete%20my%20Newdryve%20account"
            class={linkClass}>support@newdryve.com</a
          > from the email address registered to your account and ask us to delete it. We action
          deletion requests within 30 days.
        </p>
      </section>

      <section class="rounded-2xl border border-blush-border bg-blush-surface px-5 py-5 md:px-6">
        <h2 class="font-display text-2xl font-semibold text-ink">What happens after deletion</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 leading-relaxed text-ink-secondary marker:text-deep-rose">
          <li>Your name, email address and phone number are removed from your profile.</li>
          <li>Upcoming lessons are cancelled and the relevant learner or instructor is notified.</li>
          <li>An instructor's public booking page is taken down.</li>
          <li>Booking and payment records may be anonymised and retained where required for accounting, tax and fraud-prevention obligations.</li>
          <li>Deletion cannot be undone. You will need to create a new account to use Newdryve again.</li>
        </ul>
      </section>
    </div>

    <p class="mt-10 border-t border-border pt-6 text-sm leading-relaxed text-ink-secondary">
      Questions about your data? Read our <a href="/privacy" class={linkClass}>privacy policy</a> or
      email <a href="mailto:support@newdryve.com" class={linkClass}>support@newdryve.com</a>.
    </p>
  </main>
</BaseLayout>
