---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { organizationSchema, breadcrumbSchema } from '../lib/schema';

const title = 'Delete Your Newdryve Account';
const description =
  'How learners and driving instructors can delete a Newdryve account and what happens to their data.';

const jsonLd = [
  organizationSchema,
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Delete account', path: '/delete-account' },
  ]),
];

const linkClass = 'font-semibold text-forest underline underline-offset-2';
const markerClass = 'nd-marker size-10 text-lg';
---

<BaseLayout title={title} description={description} path="/delete-account" jsonLd={jsonLd} footerEdge="paper">
  <PageHero
    hand="sorry to see you go"
    title="delete your newdryve account"
    lede="These instructions are for students and instructors using the Newdryve app."
    carColor="#FFD96B"
  />

  <div class="nd-container py-14 md:py-20">
    <div class="mx-auto flex max-w-3xl flex-col gap-6">
      <section class="nd-card-lg p-6 sm:p-8">
        <h2 class="nd-h4">Delete your account in the app</h2>
        <ol class="mt-5 flex flex-col gap-4">
          <li class="flex items-start gap-4">
            <span class={markerClass} aria-hidden="true">1</span>
            <span class="pt-1.5">Open the Newdryve app and sign in.</span>
          </li>
          <li class="flex items-start gap-4">
            <span class={markerClass} aria-hidden="true">2</span>
            <span class="pt-1.5"
              >Go to <strong>Account</strong>. Instructors use <strong
                >Settings → Instructor account</strong
              >.</span
            >
          </li>
          <li class="flex items-start gap-4">
            <span class={markerClass} aria-hidden="true">3</span>
            <span class="pt-1.5">Tap <strong>Delete account</strong>.</span>
          </li>
          <li class="flex items-start gap-4">
            <span class={markerClass} aria-hidden="true">4</span>
            <span class="pt-1.5">Confirm with <strong>Delete my account</strong>.</span>
          </li>
        </ol>
      </section>

      <section class="nd-card-lg p-6 sm:p-8">
        <h2 class="nd-h4">Can't access the app?</h2>
        <p class="mt-3">
          Email <a
            href="mailto:support@newdryve.com?subject=Delete%20my%20Newdryve%20account"
            class={linkClass}>support@newdryve.com</a
          > from the email address registered to your account and ask us to delete it. We action
          deletion requests within 30 days.
        </p>
      </section>

      <section class="rounded-[32px] border-2 border-forest bg-pink p-6 sm:p-8">
        <h2 class="nd-h4">What happens after deletion</h2>
        <ul class="mt-4 list-disc space-y-2 pl-5 marker:text-forest">
          <li>Your name, email address and phone number are removed from your profile.</li>
          <li>Upcoming lessons are cancelled and the relevant learner or instructor is notified.</li>
          <li>An instructor's public booking page is taken down.</li>
          <li>
            Booking and payment records may be anonymised and retained where required for
            accounting, tax and fraud-prevention obligations.
          </li>
          <li>
            Deletion cannot be undone. You will need to create a new account to use Newdryve again.
          </li>
        </ul>
      </section>

      <hr class="nd-divider mt-4" />
      <p class="nd-help">
        Questions about your data? Read our <a href="/privacy" class={linkClass}>privacy policy</a>
        or email <a href="mailto:support@newdryve.com" class={linkClass}>support@newdryve.com</a>.
      </p>
    </div>
  </div>
</BaseLayout>
