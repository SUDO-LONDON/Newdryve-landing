---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Faq from '../../components/Faq.astro';
import StoreBadges from '../../components/StoreBadges.astro';
import { PRICING, BRAND } from '../../config/site';
import { INSTRUCTOR_FEATURES, SCHOOL_FEATURES } from '../../content/instructor-features';
import {
  organizationSchema,
  instructorAppSchema,
  breadcrumbSchema,
  faqSchema,
  type FaqItem,
} from '../../lib/schema';

const title = 'Driving Instructor Management Software with Built-In Pupil Booking | Newdryve';
const description =
  'Every Newdryve feature for driving instructors: diary, existing pupils, DVSA progress tracking, payments, cancellation protection, expenses, accountant exports and new learners.';

const FAQ_ITEMS: readonly FaqItem[] = [
  {
    q: 'Can Newdryve replace TotalDrive or another driving instructor management app?',
    a: 'Newdryve covers the same day-to-day work: a diary with working hours, time off and travel time; your pupils and their lesson history; progress mapped to the DVSA practical test; card, cash and bank-transfer payments; earnings, receipt scanning and PDF and CSV exports for your accountant. On top of that it brings you new learners from its marketplace and charges late cancellations automatically. Notes and progress kept in your old app do not transfer automatically, and we help you move your pupils across.',
  },
  {
    q: 'Can I bring the pupils I already teach?',
    a: 'Yes. Send them your Newdryve link. Once they sign in it takes them to your profile, where they book their lessons with you. Until a pupil is moved over, you can block out their lesson times in your diary by hand.',
  },
  {
    q: 'Who books the lesson, me or the pupil?',
    a: 'The pupil books, from the free slots in your diary. You control those slots through your working hours, time off and travel time.',
  },
  {
    q: 'Does Newdryve sync with Google or Apple Calendar?',
    a: 'Not yet. Your Newdryve diary is the record of your lessons.',
  },
  {
    q: 'Who owns a pupil’s progress record?',
    a: 'The learner. Progress is recorded against them, and you see it as their instructor. It stays with them if they change instructor.',
  },
  {
    q: 'What does it cost?',
    a: `${PRICING.monthlyWithPeriod}, with ${PRICING.commission} Newdryve commission on lesson payments. Stripe’s standard processing fee applies only when a learner pays by card. ${PRICING.cancelAnytime}.`,
  },
];

const jsonLd = [
  organizationSchema,
  instructorAppSchema,
  faqSchema(FAQ_ITEMS),
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'For instructors', path: '/instructors' },
    { name: 'Features', path: '/instructors/features' },
  ]),
];
---

<BaseLayout
  title={title}
  description={description}
  path="/instructors/features"
  jsonLd={jsonLd}
  audience="instructor"
>
  <!-- HERO: mint, continuing the header band -->
  <section class="bg-mint">
    <div class="nd-container pt-12 pb-16 md:pt-[72px] md:pb-24">
      <p class="nd-small-label">Newdryve for instructors</p>
      <h1 class="nd-h1 mt-4 max-w-[17em]">
        driving instructor management software, with pupils who book you <span class="nd-highlight"
          >built in.</span
        >
      </h1>
      <p class="nd-lede mt-7 max-w-[36em]">
        Everything you get from an instructor management app, plus a marketplace that brings you new
        learners. {PRICING.monthlyWithPeriod}, {PRICING.commission} commission, on iPhone and Android.
      </p>

      <nav aria-label="Features on this page" class="mt-9">
        <ul class="flex flex-wrap gap-2.5">
          {
            INSTRUCTOR_FEATURES.map((feature) => (
              <li>
                <a
                  href={`#${feature.id}`}
                  class="inline-flex min-h-11 items-center rounded-full border-2 border-forest bg-paper px-4 text-[15px] font-semibold no-underline hover:bg-forest hover:text-mint"
                >
                  {feature.title}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </div>
  </section>

  <!-- FEATURES -->
  <div class="nd-container pt-6 md:pt-10">
    {
      INSTRUCTOR_FEATURES.map((feature, index) => (
        <section
          id={feature.id}
          aria-labelledby={`${feature.id}-title`}
          class={`grid gap-x-16 gap-y-6 py-12 md:py-16 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] ${
            index > 0 ? 'border-t-2 border-forest' : ''
          }`}
        >
          <h2 id={`${feature.id}-title`} class="nd-h3">
            {feature.title}
          </h2>
          <div class="min-w-0">
            <div class="flex max-w-[38em] flex-col gap-3 text-lg">
              {feature.detail.map((paragraph) => <p>{paragraph}</p>)}
            </div>
            <ul class="mt-6 grid gap-x-8 sm:grid-cols-2">
              {feature.points.map((point) => (
                <li class="flex items-start gap-3 border-t-2 border-dashed border-forest py-3 text-[17px]">
                  <span
                    class="mt-0.5 inline-flex size-6 shrink-0 items-center justify-center rounded-full border-2 border-forest bg-mint"
                    aria-hidden="true"
                  >
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none">
                      <path
                        d="M5 12.5l4.5 4.5L19 7.5"
                        stroke="currentColor"
                        stroke-width="3.5"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                      />
                    </svg>
                  </span>
                  {point}
                </li>
              ))}
            </ul>
          </div>
        </section>
      ))
    }

    <section id="schools" aria-labelledby="schools-title" class="pt-4 pb-16 md:pb-24">
      <div
        class="flex flex-col gap-6 rounded-[32px] bg-pink p-6 sm:p-10 md:flex-row md:items-center md:justify-between"
      >
        <div>
          <h2 id="schools-title" class="nd-h3">{SCHOOL_FEATURES.title}</h2>
          <p class="mt-3 max-w-[38em] text-lg">{SCHOOL_FEATURES.body}</p>
        </div>
        <a
          href={`mailto:${BRAND.email}?subject=Newdryve%20for%20driving%20schools`}
          class="nd-btn shrink-0"
        >
          Talk to us about your school
        </a>
      </div>
    </section>
  </div>

  <!-- SWITCHING -->
  <section class="pb-16 md:pb-24">
    <div class="nd-container">
      <div
        class="on-forest grid gap-x-16 gap-y-6 rounded-[32px] bg-forest p-6 text-paper sm:p-10 lg:grid-cols-[minmax(0,1fr)_minmax(0,1.5fr)] lg:p-14"
      >
        <h2 class="nd-h2">switching from another app</h2>
        <div>
          <div class="flex max-w-[38em] flex-col gap-3 text-lg">
            <p>
              We sit down with you, set up your profile and diary together, and show you round the
              app. Then we help you bring your existing pupils across: send them your link and they
              land on your profile to book.
            </p>
            <p>
              If you are coming from TotalDrive, MyDriveTime or another diary app, everything you use
              day to day is here. Notes and progress records kept in your old app do not transfer
              automatically; from the moment a pupil joins Newdryve, everything is recorded against
              them.
            </p>
          </div>
          <a
            href="/instructors#switching"
            class="mt-6 inline-flex min-h-11 items-center font-semibold text-paper underline"
          >
            How switching works
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="pb-16 md:pb-24">
    <div class="nd-container grid items-start gap-x-16 gap-y-8 lg:grid-cols-[1fr_1.5fr]">
      <h2 class="nd-h2">questions about features</h2>
      <Faq items={FAQ_ITEMS} />
    </div>
  </section>

  <!-- CTA: pink band -->
  <section class="bg-pink">
    <div class="nd-container nd-section flex flex-col items-center text-center">
      <h2 class="nd-h2 max-w-[14em]">one app for your whole business</h2>
      <p class="nd-lede mt-6 max-w-[30em]">
        {PRICING.monthlyWithPeriod}. {PRICING.commission} Newdryve commission. {PRICING.cancelAnytime}.
      </p>
      <a href="/instructors/apply" class="nd-btn nd-btn-lg mt-8">Apply as a founding instructor</a>
      <StoreBadges class="mt-6 justify-center" />
    </div>
  </section>
</BaseLayout>
