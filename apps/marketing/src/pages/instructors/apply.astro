---
/**
 * Instructor application form, as a five-step stepper.
 *
 * Replaces the founder's local daemon as the way an instructor account comes
 * into existence. The applicant chooses their own password here and keeps it —
 * there is no temporary credential and nothing to redeem later. The account is
 * created immediately but cannot be signed into until a founder approves it
 * in /ops.
 *
 * Progressive enhancement: the stepper is applied by script, not baked into the
 * markup. With JavaScript off, every step renders as a plain stacked form with
 * one submit button and a real action/method, exactly as it did before. The
 * step chrome (progress bar, Back/Next) starts `hidden` and is revealed on init.
 *
 * An optional ADI badge image is PUT straight from the browser to private
 * Supabase Storage using a short-lived signed URL. It is supporting evidence,
 * not the verification itself, and is deleted after review.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { testCentresByCity, testCentreOptionsByCity } from '../../data/driving-test-centres';
import { defaultInstructorLanguage, instructorLanguages } from '../../data/instructor-languages';
import { organizationSchema, breadcrumbSchema } from '../../lib/schema';

const title = 'Apply to teach with Newdryve | Newdryve';
const description =
  'Apply to teach with Newdryve. Set your own hours, areas and prices, pay 0% Newdryve commission on lesson payments, and get approved before taking bookings.';

const jsonLd = [
  organizationSchema,
  breadcrumbSchema([
    { name: 'Home', path: '/' },
    { name: 'Instructors', path: '/instructors' },
    { name: 'Apply', path: '/instructors/apply' },
  ]),
];

const inputClass =
  'focus-ring w-full rounded-xl border border-border bg-canvas px-4 py-3 text-base text-ink placeholder:text-ink-muted sm:text-sm';
const fileClass =
  'focus-ring w-full rounded-xl border border-border bg-canvas px-4 py-3 text-sm text-ink-secondary file:mr-3 file:rounded-full file:border-0 file:bg-ink file:px-4 file:py-2 file:text-xs file:font-bold file:text-white';
const labelClass = 'text-xs font-bold uppercase tracking-wider text-ink-secondary';
const stepClass = 'flex flex-col gap-5';
const legendClass = 'font-display text-xl font-semibold tracking-[-0.5px] text-ink';
const pillClass =
  'inline-flex min-h-11 items-center rounded-full border border-border px-4 text-sm font-bold text-ink-secondary transition-colors peer-checked:border-ink peer-checked:bg-ink peer-checked:text-white peer-focus-visible:ring-2 peer-focus-visible:ring-racing-green peer-focus-visible:ring-offset-2';

/** Drives both the progress rail and the script's step count. */
const formSteps = [
  { n: 1, label: 'About you' },
  { n: 2, label: 'Sign-in' },
  { n: 3, label: 'DVSA check' },
  { n: 4, label: 'Teaching' },
  { n: 5, label: 'Availability' },
];

// Monday-first for readability; the value is the Postgres weekday (0 = Sunday).
const weekdays = [
  { value: 1, label: 'Monday' },
  { value: 2, label: 'Tuesday' },
  { value: 3, label: 'Wednesday' },
  { value: 4, label: 'Thursday' },
  { value: 5, label: 'Friday' },
  { value: 6, label: 'Saturday' },
  { value: 0, label: 'Sunday' },
];

const lessonTypes = [
  { code: '1h', label: '1 hour', checked: true },
  { code: '90m', label: '90 minutes', checked: true },
  { code: '2h', label: '2 hours', checked: true },
];

const testCentreCities = Object.keys(testCentresByCity).sort((a, b) => a.localeCompare(b, 'en-GB'));

const howItWorks = [
  { badge: 'bg-racing-green', text: 'You apply here and choose the password you&rsquo;ll sign in with.' },
  { badge: 'bg-deep-rose', text: 'With your permission, we confirm your current ADI registration through GOV.UK or directly with DVSA.' },
  { badge: 'bg-ink', text: 'If approved, we email your agreed membership terms and, where required, a secure Stripe setup link.' },
  { badge: 'bg-racing-green', text: 'After membership or free-trial setup is confirmed, we email your private Newdryve setup page. Connect payouts there, set your service area, and review your listing before it goes live.' },
];

const acceptTypes = 'image/jpeg,image/png,image/heic,image/heif,image/webp,application/pdf';
---

{/* audience="instructor" matters: the default learner nav puts a "Join the
    waitlist" CTA in the header, which is the one thing an instructor should
    never be offered on the application page. */}
<BaseLayout
  title={title}
  description={description}
  path="/instructors/apply"
  jsonLd={jsonLd}
  audience="instructor"
>
  <div class="relative overflow-hidden">
    <div class="dot-pattern pointer-events-none absolute inset-0 opacity-40" aria-hidden="true"></div>

    <div
      class="relative mx-auto grid max-w-6xl gap-10 px-5 py-12 md:grid-cols-[0.85fr_1.15fr] md:items-start md:gap-16 md:py-20"
    >
      <div class="md:sticky md:top-24">
        <p class="text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink">
          Founding instructors
        </p>
        <h1
          class="font-display mt-3 text-[clamp(36px,6vw,56px)] font-semibold leading-[1.02] tracking-[-1.2px] text-balance"
        >
          Apply to teach with Newdryve.
        </h1>
        <p class="mt-5 max-w-xl text-base leading-relaxed text-ink-secondary md:text-lg">
          We&rsquo;re building a carefully selected founding group of ADI-qualified instructors across
          Great Britain. Tell us about yourself and how you teach, and we&rsquo;ll review your application by hand.
        </p>

        <div class="mt-8 rounded-2xl border border-blush-border bg-blush-surface p-5">
          <h2 class="text-sm font-extrabold text-ink">How it works</h2>
          <ol class="mt-4 space-y-4 text-sm leading-relaxed text-ink-secondary">
            {
              howItWorks.map((step, index) => (
                <li class="flex gap-3">
                  <span
                    class={`mt-0.5 flex size-5 shrink-0 items-center justify-center rounded-full text-[11px] font-bold text-white ${step.badge}`}
                  >
                    {index + 1}
                  </span>
                  <span set:html={step.text} />
                </li>
              ))
            }
          </ol>
        </div>

        <p class="mt-6 text-sm text-ink-secondary">
          Already applied? You can&rsquo;t sign in until we&rsquo;ve approved you and any required membership
          setup is complete &mdash; we&rsquo;ll email you the next step.
        </p>
      </div>

      <div data-apply-root>
        <form
          id="instructor-apply"
          action="/api/instructor-apply"
          method="post"
          novalidate
          data-apply-form
          class="flex flex-col gap-6 rounded-2xl border border-border bg-white p-6 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.08)] sm:p-8"
        >
          {/* Step chrome. Hidden until the script takes over, so a no-JS
              visitor sees a plain stacked form rather than dead controls. */}
          <div data-stepper-chrome hidden>
            <div class="flex items-baseline justify-between gap-3">
              <p class="text-[11px] font-bold uppercase tracking-[1px] text-deep-rose-ink">
                Step <span data-step-current>1</span> of {formSteps.length}
              </p>
              <p data-step-name class="text-sm font-semibold text-ink-secondary"></p>
            </div>

            <ol class="mt-3 flex gap-1.5" aria-hidden="true">
              {
                formSteps.map((step) => (
                  <li
                    data-step-tick={step.n}
                    class="h-1.5 flex-1 rounded-full bg-border transition-colors"
                  />
                ))
              }
            </ol>

            {/* Announces step changes to screen readers without stealing focus
                from the heading, which is focused separately. */}
            <p data-step-announce class="sr-only" role="status" aria-live="polite"></p>
          </div>

          <fieldset class={stepClass} data-step="1">
            <legend class={legendClass} tabindex="-1" data-step-heading>About you</legend>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="flex flex-col gap-1.5">
                <label class={labelClass} for="apply-full-name">
                  Full name <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </label>
                <input
                  id="apply-full-name"
                  name="full_name"
                  type="text"
                  required
                  autocomplete="name"
                  placeholder="Jane Smith"
                  class={inputClass}
                />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class={labelClass} for="apply-phone">
                  Mobile number <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </label>
                <input
                  id="apply-phone"
                  name="phone"
                  type="tel"
                  required
                  autocomplete="tel"
                  inputmode="tel"
                  maxlength="17"
                  aria-describedby="apply-phone-hint"
                  title="Enter a valid UK mobile number beginning 07 or +44 7"
                  placeholder="07700 900000"
                  class={inputClass}
                />
                <p id="apply-phone-hint" class="text-xs text-ink-muted">
                  UK mobile format, beginning 07 or +44 7.
                </p>
              </div>
            </div>

            <div class="flex flex-col gap-1.5" data-language-field>
              <label id="apply-languages-label" class={labelClass} for="apply-languages">
                Languages you teach in <span aria-hidden="true" class="text-deep-rose-ink">*</span>
              </label>

              {/* Without JavaScript this checkbox group is the field, so only
                  listed names can ever be submitted. With JavaScript it is
                  hidden but stays the form's record of what is chosen; the
                  picker below ticks and unticks it. */}
              <div
                data-language-fallback
                role="group"
                aria-labelledby="apply-languages-label"
                aria-describedby="apply-languages-hint"
                class="flex flex-wrap gap-2 pt-1"
              >
                {
                  instructorLanguages.map((language) => (
                    <label class="cursor-pointer">
                      <input
                        type="checkbox"
                        name="languages"
                        value={language.name}
                        data-aliases={language.aliases?.join('|')}
                        checked={language.name === defaultInstructorLanguage}
                        class="peer sr-only"
                      />
                      <span class={pillClass}>{language.name}</span>
                    </label>
                  ))
                }
              </div>

              {/* Searchable multi-select (ARIA combobox + listbox), revealed
                  by the script. Chosen languages sit above the input as
                  removable chips; the list opens inline beneath it so it is
                  never clipped or hidden behind a phone keyboard overlay. */}
              <div data-language-picker hidden class="flex flex-col gap-2 pt-1">
                <ul data-language-chips aria-label="Chosen languages" class="flex flex-wrap gap-2"></ul>

                <div class="relative">
                  <input
                    id="apply-languages"
                    type="text"
                    role="combobox"
                    aria-autocomplete="list"
                    aria-expanded="false"
                    aria-controls="apply-languages-listbox"
                    aria-describedby="apply-languages-hint apply-languages-instructions"
                    autocomplete="off"
                    autocapitalize="off"
                    autocorrect="off"
                    spellcheck="false"
                    enterkeyhint="done"
                    placeholder="Search languages"
                    class={`${inputClass} pr-11 aria-[invalid=true]:border-deep-rose-ink`}
                  />
                  <svg
                    class="pointer-events-none absolute top-1/2 right-4 -translate-y-1/2 text-ink-muted"
                    width="14"
                    height="14"
                    viewBox="0 0 12 12"
                    fill="none"
                    aria-hidden="true"
                  >
                    <path
                      d="M2.5 4.5 6 8l3.5-3.5"
                      stroke="currentColor"
                      stroke-width="1.75"
                      stroke-linecap="round"
                      stroke-linejoin="round"></path>
                  </svg>
                </div>

                <ul
                  id="apply-languages-listbox"
                  role="listbox"
                  aria-multiselectable="true"
                  aria-labelledby="apply-languages-label"
                  data-language-listbox
                  hidden
                  class="max-h-64 overflow-y-auto overscroll-contain rounded-xl border border-border bg-white p-1 shadow-[0_20px_60px_-20px_rgba(0,0,0,0.12)]"
                >
                </ul>

                <p
                  data-language-empty
                  hidden
                  class="rounded-xl border border-dashed border-border px-4 py-3 text-sm text-ink-secondary"
                >
                </p>

                <p id="apply-languages-instructions" class="sr-only">
                  Type to search. Use the up and down arrow keys to move through the list, and Enter to
                  add or remove the highlighted language. Backspace in an empty search box removes the
                  last language you added.
                </p>
                <p data-language-status class="sr-only" role="status" aria-live="polite"></p>
              </div>

              <p id="apply-languages-hint" class="text-xs text-ink-muted">
                Choose every language you can teach in. Learners can match with any one of them. Not
                listed? Tell us at the end of the form.
              </p>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class={labelClass} for="apply-service-city">
                City <span aria-hidden="true" class="text-deep-rose-ink">*</span>
              </label>
              <select
                id="apply-service-city"
                name="service_city"
                required
                aria-describedby="apply-service-city-hint"
                class={inputClass}
              >
                <option value="">Select a city</option>
                {testCentreCities.map((city) => <option value={city}>{city}</option>)}
              </select>
              <p id="apply-service-city-hint" class="text-xs text-ink-muted">
                We&rsquo;ll show every current practical test centre in your chosen city.
              </p>
            </div>

            <div class="flex flex-col gap-1.5">
              <span id="apply-test-centres-label" class={labelClass}>
                Primary test centres you cover <span aria-hidden="true" class="text-deep-rose-ink">*</span>
              </span>
              <div
                class="pt-1"
                aria-labelledby="apply-test-centres-label"
                aria-describedby="apply-test-centres-hint"
              >
                <p data-test-centres-empty class="text-sm text-ink-secondary">
                  Choose a city first.
                </p>
                {
                  Object.entries(testCentreOptionsByCity).map(([city, centres]) => (
                    <div
                      data-test-centre-group
                      data-city={city}
                      class="flex flex-wrap gap-2"
                      role="group"
                      aria-label={`${city} practical test centres`}
                    >
                      {centres.map((centre) => (
                        <label class="cursor-pointer">
                          <input
                            type="checkbox"
                            name="test_centres"
                            value={centre.slug}
                            data-centre-name={centre.name}
                            class="peer sr-only"
                          />
                          <span class={pillClass}>{centre.name}</span>
                        </label>
                      ))}
                    </div>
                  ))
                }
              </div>
              <p id="apply-test-centres-hint" class="text-xs text-ink-muted">
                Choose at least one. You&rsquo;ll set your exact pickup-area radius on Newdryve after approval.
              </p>
            </div>
          </fieldset>

          <fieldset class={stepClass} data-step="2">
            <legend class={legendClass} tabindex="-1" data-step-heading>Your sign-in details</legend>
            <p class="-mt-2 text-sm text-ink-secondary">
              This is the password you&rsquo;ll use in the app. It won&rsquo;t work until
              we&rsquo;ve approved you.
            </p>

            <div class="flex flex-col gap-1.5">
              <label class={labelClass} for="apply-email">
                Email <span aria-hidden="true" class="text-deep-rose-ink">*</span>
              </label>
              <input
                id="apply-email"
                name="email"
                type="email"
                required
                autocomplete="email"
                inputmode="email"
                placeholder="you@example.com"
                class={inputClass}
              />
            </div>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="flex flex-col gap-1.5">
                <label class={labelClass} for="apply-password">
                  Password <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </label>
                <input
                  id="apply-password"
                  name="password"
                  type="password"
                  required
                  minlength="8"
                  autocomplete="new-password"
                  aria-describedby="apply-password-requirements"
                  placeholder="Create a strong password"
                  class={inputClass}
                />
                <p id="apply-password-requirements" class="text-xs text-ink-muted">
                  8+ characters with uppercase, lowercase, a number and a symbol.
                </p>
              </div>
              <div class="flex flex-col gap-1.5">
                <label class={labelClass} for="apply-password-confirm">
                  Confirm password <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </label>
                <input
                  id="apply-password-confirm"
                  name="password_confirm"
                  type="password"
                  required
                  minlength="8"
                  autocomplete="new-password"
                  class={inputClass}
                />
              </div>
            </div>
          </fieldset>

          <fieldset class={stepClass} data-step="3">
            <legend class={legendClass} tabindex="-1" data-step-heading>DVSA registration check</legend>
            <p class="-mt-2 text-sm text-ink-secondary">
              DVSA already carries out the criminal-record suitability checks required for ADI
              registration. We only confirm that your registration is current; we do not need your
              DBS certificate.
            </p>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="flex flex-col gap-1.5">
                <label class={labelClass} for="apply-adi-number">
                  ADI badge number <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </label>
                <input
                  id="apply-adi-number"
                  name="adi_number"
                  type="text"
                  required
                  placeholder="e.g. 123456"
                  class={inputClass}
                />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class={labelClass} for="apply-adi-expiry">
                  ADI badge expiry <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </label>
                <input
                  id="apply-adi-expiry"
                  name="adi_badge_expires_on"
                  type="date"
                  required
                  class={inputClass}
                />
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class={labelClass} for="apply-adi-doc">
                ADI badge image <span class="normal-case tracking-normal text-ink-muted">(optional)</span>
              </label>
              <input
                id="apply-adi-doc"
                name="adi_document"
                type="file"
                accept={acceptTypes}
                aria-describedby="apply-adi-doc-help"
                class={fileClass}
              />
              <p id="apply-adi-doc-help" class="text-xs leading-5 text-ink-muted">
                Useful only if your details are difficult to match. Stored privately and deleted
                after review. Your DVSA status is checked separately.
              </p>
            </div>

            <label class="flex items-start gap-3 rounded-xl border border-border bg-canvas p-4 text-sm leading-6 text-ink-secondary">
              <input
                type="checkbox"
                name="dvsa_verification_consent"
                value="yes"
                required
                class="mt-1 size-4 shrink-0 accent-racing-green"
              />
              <span>
                I authorise Newdryve to use my name and ADI number to check that my registration is
                current through the GOV.UK directory or by contacting DVSA.
              </span>
            </label>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="flex flex-col gap-1.5">
                <label class={labelClass} for="apply-school">
                  Driving school name <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </label>
                <input
                  id="apply-school"
                  name="driving_school_name"
                  type="text"
                  required
                  placeholder="Enter Independent if you teach under your own name"
                  class={inputClass}
                />
              </div>
            </div>
          </fieldset>

          <fieldset class={stepClass} data-step="4">
            <legend class={legendClass} tabindex="-1" data-step-heading>How you teach</legend>

            <div class="grid gap-4 sm:grid-cols-2">
              <div class="flex flex-col gap-1.5">
                <label class={labelClass} for="apply-price">
                  Price per hour (&pound;) <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </label>
                <input
                  id="apply-price"
                  name="price_per_hour_pounds"
                  type="number"
                  required
                  min="1"
                  max="500"
                  step="0.50"
                  placeholder="40"
                  class={inputClass}
                />
                <p class="text-xs text-ink-muted">Newdryve takes 0% commission from this. Change it any time.</p>
              </div>

              <div class="flex flex-col gap-1.5">
                <span class={labelClass}>
                  Transmission <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </span>
                <div class="flex flex-wrap gap-2 pt-1">
                  <label class="cursor-pointer">
                    <input type="checkbox" name="transmissions" value="manual" checked class="peer sr-only" />
                    <span class={pillClass}>Manual</span>
                  </label>
                  <label class="cursor-pointer">
                    <input type="checkbox" name="transmissions" value="auto" class="peer sr-only" />
                    <span class={pillClass}>Automatic</span>
                  </label>
                </div>
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <span class={labelClass}>
                Lesson lengths you offer <span aria-hidden="true" class="text-deep-rose-ink">*</span>
              </span>
              <div class="flex flex-wrap gap-2 pt-1">
                {
                  lessonTypes.map((lesson) => (
                    <label class="cursor-pointer">
                      <input
                        type="checkbox"
                        name="lesson_types"
                        value={lesson.code}
                        checked={lesson.checked}
                        class="peer sr-only"
                      />
                      <span class={pillClass}>{lesson.label}</span>
                    </label>
                  ))
                }
              </div>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class={labelClass} for="apply-specialisms">
                Specialisms <span aria-hidden="true" class="text-deep-rose-ink">*</span>
              </label>
              <input
                id="apply-specialisms"
                name="specialisms"
                type="text"
                required
                placeholder="Nervous learners, Pass Plus, refresher lessons"
                class={inputClass}
              />
              <p class="text-xs text-ink-muted">Separate each one with a comma.</p>
            </div>

            <div class="flex flex-col gap-1.5">
              <label class={labelClass} for="apply-bio">
                Short bio <span aria-hidden="true" class="text-deep-rose-ink">*</span>
              </label>
              <textarea
                id="apply-bio"
                name="bio"
                required
                rows="3"
                placeholder="A couple of sentences learners will see on your profile."
                class={`${inputClass} resize-none`}></textarea>
            </div>

            <div class="grid gap-4 sm:grid-cols-3">
              <div class="flex flex-col gap-1.5">
                <label class={labelClass} for="apply-car-make">
                  Car make <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </label>
                <input id="apply-car-make" name="car_make" type="text" required placeholder="Vauxhall" class={inputClass} />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class={labelClass} for="apply-car-model">
                  Model <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </label>
                <input id="apply-car-model" name="car_model" type="text" required placeholder="Corsa" class={inputClass} />
              </div>
              <div class="flex flex-col gap-1.5">
                <label class={labelClass} for="apply-car-color">
                  Colour <span aria-hidden="true" class="text-deep-rose-ink">*</span>
                </label>
                <input id="apply-car-color" name="car_color" type="text" required placeholder="Blue" class={inputClass} />
              </div>
            </div>
          </fieldset>

          <fieldset class={stepClass} data-step="5">
            <legend class={legendClass} tabindex="-1" data-step-heading>
              When you&rsquo;re available
            </legend>
            <p class="-mt-2 text-sm text-ink-secondary">
              Choose at least one day and valid start/end times. You can change all of this in the
              app once you&rsquo;re approved. <span aria-hidden="true" class="text-deep-rose-ink">*</span>
            </p>

            <div class="flex flex-col gap-2">
              {
                weekdays.map((day) => (
                  <div
                    class="grid grid-cols-[1fr] items-center gap-2 sm:grid-cols-[auto_1fr_auto_1fr]"
                    data-availability-row
                    data-weekday={day.value}
                  >
                    <label class="flex min-h-11 cursor-pointer items-center gap-2.5">
                      <input
                        type="checkbox"
                        data-availability-toggle
                        class="focus-ring size-4 rounded border-border accent-racing-green"
                      />
                      <span class="w-24 text-sm font-bold text-ink">{day.label}</span>
                    </label>
                    <input
                      type="time"
                      value="09:00"
                      disabled
                      data-availability-start
                      aria-label={`${day.label} start time`}
                      class={`${inputClass} disabled:opacity-40`}
                    />
                    <span class="hidden text-center text-sm text-ink-muted sm:block">to</span>
                    <input
                      type="time"
                      value="18:00"
                      disabled
                      data-availability-end
                      aria-label={`${day.label} end time`}
                      class={`${inputClass} disabled:opacity-40`}
                    />
                  </div>
                ))
              }
            </div>

            <div class="flex flex-col gap-1.5">
              <label class={labelClass} for="apply-notes">
                Anything else we should know <span aria-hidden="true" class="text-deep-rose-ink">*</span>
              </label>
              <textarea
                id="apply-notes"
                name="application_notes"
                required
                rows="3"
                placeholder="Years teaching, pass rates, current availability, anything else."
                class={`${inputClass} resize-none`}></textarea>
            </div>
          </fieldset>

          <div class="flex flex-col gap-4 border-t border-border pt-6">
            <p data-apply-error role="alert" class="hidden text-sm font-semibold text-deep-rose-ink">
            </p>

            <div class="flex flex-wrap items-center gap-3">
              <button
                type="button"
                data-step-back
                hidden
                class="focus-ring inline-flex min-h-11 items-center justify-center rounded-full border border-border px-5 py-3.5 text-sm font-bold text-ink transition-colors hover:bg-blush-surface disabled:cursor-not-allowed disabled:opacity-60"
              >
                Back
              </button>

              <button
                type="button"
                data-step-next
                hidden
                class="focus-ring inline-flex min-h-11 flex-1 items-center justify-center gap-1.5 rounded-full bg-ink px-6 py-3.5 text-sm font-bold text-white transition-transform hover:bg-[#1a1a2c] motion-safe:hover:-translate-y-0.5 sm:flex-none"
              >
                Continue
                <svg width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                  <path
                    d="M2.5 6h7M6 2.5 9.5 6 6 9.5"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
                </svg>
              </button>

              <button
                type="submit"
                data-apply-submit
                class="focus-ring inline-flex min-h-11 flex-1 items-center justify-center gap-1.5 rounded-full bg-deep-rose px-6 py-3.5 text-sm font-bold text-white shadow-[0_10px_28px_-10px_rgba(232,82,122,0.6)] transition-transform hover:bg-[#d8406b] disabled:cursor-not-allowed disabled:opacity-60 motion-safe:hover:-translate-y-0.5 sm:flex-none"
              >
                <span data-apply-submit-label>Submit application</span>
              </button>
            </div>

            <p class="text-xs text-ink-muted">
              By applying you agree to our
              <a href="/terms" class="font-semibold text-ink underline underline-offset-2">terms</a>
              and <a href="/privacy" class="font-semibold text-ink underline underline-offset-2">privacy policy</a>.
            </p>
          </div>
        </form>

        <div
          data-apply-success
          hidden
          role="status"
          tabindex="-1"
          class="rounded-2xl border border-border bg-white p-8 text-center"
        >
          <div
            class="mx-auto mb-4 flex size-12 items-center justify-center rounded-full bg-racing-green/10 text-racing-green"
          >
            <svg width="22" height="22" viewBox="0 0 22 22" fill="none" aria-hidden="true">
              <path
                d="M5 11l4 4 8-9"
                stroke="currentColor"
                stroke-width="2.5"
                stroke-linecap="round"
                stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="text-xl font-extrabold tracking-tight">Application received.</h3>
          <p class="mt-2 text-sm text-ink-secondary">
            We&rsquo;re working on getting you approved and we&rsquo;ll email
            <span data-apply-success-email class="font-semibold text-ink"></span> as soon as
            you&rsquo;re approved. That email will contain your membership terms and, where required, the final Stripe setup step;
            you&rsquo;ll sign in with the password you just chose once it is complete.
          </p>
          <p data-apply-upload-warning hidden class="mt-4 rounded-xl bg-blush-surface p-4 text-sm text-ink-secondary">
            We couldn&rsquo;t upload the optional badge image. Your application is safe and we can still
            verify your registration directly with DVSA.
          </p>
        </div>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  /* The step fieldsets are display:flex, which wins over the `hidden`
     attribute's UA display:none. Without this the stepper shows every step at
     once. */
  [hidden] {
    display: none !important;
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-apply-root]');
  const form = root?.querySelector<HTMLFormElement>('[data-apply-form]');
  const success = root?.querySelector<HTMLElement>('[data-apply-success]');
  const successEmail = root?.querySelector<HTMLElement>('[data-apply-success-email]');
  const uploadWarning = root?.querySelector<HTMLElement>('[data-apply-upload-warning]');
  const errorEl = root?.querySelector<HTMLElement>('[data-apply-error]');
  const submitButton = root?.querySelector<HTMLButtonElement>('[data-apply-submit]');
  const submitLabel = root?.querySelector<HTMLElement>('[data-apply-submit-label]');
  const chrome = root?.querySelector<HTMLElement>('[data-stepper-chrome]');
  const backButton = root?.querySelector<HTMLButtonElement>('[data-step-back]');
  const nextButton = root?.querySelector<HTMLButtonElement>('[data-step-next]');
  const currentLabel = root?.querySelector<HTMLElement>('[data-step-current]');
  const stepName = root?.querySelector<HTMLElement>('[data-step-name]');
  const announce = root?.querySelector<HTMLElement>('[data-step-announce]');

  if (
    root && form && success && successEmail && uploadWarning && errorEl &&
    submitButton && submitLabel && chrome && backButton && nextButton &&
    currentLabel && stepName && announce
  ) {
    const stepEls = Array.from(root.querySelectorAll<HTMLFieldSetElement>('[data-step]'));
    const ticks = Array.from(root.querySelectorAll<HTMLElement>('[data-step-tick]'));
    const citySelect = root.querySelector<HTMLSelectElement>('#apply-service-city');
    const testCentreGroups = Array.from(
      root.querySelectorAll<HTMLElement>('[data-test-centre-group]')
    );
    const testCentresEmpty = root.querySelector<HTMLElement>('[data-test-centres-empty]');
    const names = ['About you', 'Sign-in', 'DVSA check', 'Teaching', 'Availability'];
    const total = stepEls.length;
    let current = 1;

    const fail = (message: string, focus?: HTMLElement | null) => {
      errorEl.textContent = message;
      errorEl.classList.remove('hidden');
      focus?.focus();
      return false;
    };

    const clearError = () => errorEl.classList.add('hidden');

    const syncTestCentres = (clearPrevious = false) => {
      const selectedCity = citySelect?.value || '';

      for (const group of testCentreGroups) {
        const active = Boolean(selectedCity) && group.dataset.city === selectedCity;
        group.hidden = !active;

        const checkboxes = Array.from(group.querySelectorAll<HTMLInputElement>(
          'input[name="test_centres"]'
        ));
        for (const checkbox of checkboxes) {
          if (!active && clearPrevious) checkbox.checked = false;
          checkbox.disabled = !active;
        }
        if (active && checkboxes.length === 1) checkboxes[0].checked = true;
      }

      if (testCentresEmpty) testCentresEmpty.hidden = Boolean(selectedCity);
    };

    syncTestCentres();
    citySelect?.addEventListener('change', () => {
      syncTestCentres(true);
      clearError();
    });

    /**
     * Languages: a searchable multi-select over the fallback checkbox group
     * (ARIA combobox with a multi-selectable listbox). The checkboxes stay the
     * record of what is chosen, so nothing outside the list can be submitted;
     * `order` only remembers the order languages were picked in, which is the
     * order the chips show and the API receives. Returns null, leaving the
     * plain checkboxes in place, if the markup is not what it expects.
     */
    const setUpLanguagePicker = () => {
      const fallback = root.querySelector<HTMLElement>('[data-language-fallback]');
      const picker = root.querySelector<HTMLElement>('[data-language-picker]');
      const chips = picker?.querySelector<HTMLUListElement>('[data-language-chips]');
      const input = picker?.querySelector<HTMLInputElement>('#apply-languages');
      const listbox = picker?.querySelector<HTMLUListElement>('[data-language-listbox]');
      const empty = picker?.querySelector<HTMLElement>('[data-language-empty]');
      const status = picker?.querySelector<HTMLElement>('[data-language-status]');
      const boxes = Array.from(
        fallback?.querySelectorAll<HTMLInputElement>('input[name="languages"]') ?? []
      );
      if (!fallback || !picker || !chips || !input || !listbox || !empty || !status) return null;
      if (boxes.length === 0) return null;

      /** POST /v1/instructors/apply accepts at most 20 languages. */
      const maxLanguages = 20;
      const fold = (value: string) =>
        value.normalize('NFD').replace(/[̀-ͯ]/g, '').toLowerCase().trim();
      const countLabel = (n: number) => `${n} language${n === 1 ? '' : 's'} chosen.`;
      const checkIcon =
        '<svg class="invisible shrink-0 text-racing-green group-aria-selected:visible" width="14" height="14" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M2.5 6.5 5 9l4.5-6" stroke="currentColor" stroke-width="1.75" stroke-linecap="round" stroke-linejoin="round"></path></svg>';
      const removeIcon =
        '<svg class="shrink-0" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true"><path d="M3 3l6 6M9 3 3 9" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path></svg>';

      type LanguageOption = {
        name: string;
        folded: string;
        words: string[];
        aliases: Array<{ label: string; folded: string }>;
        box: HTMLInputElement;
        el: HTMLLIElement;
        aliasEl: HTMLElement;
      };

      const options: LanguageOption[] = boxes.map((box, index) => {
        const name = box.value;
        const el = document.createElement('li');
        el.id = `apply-languages-option-${index}`;
        el.setAttribute('role', 'option');
        el.className =
          'group flex min-h-11 cursor-pointer items-center justify-between gap-3 rounded-lg px-3 py-2 text-base text-ink select-none hover:bg-canvas aria-selected:font-bold data-active:bg-canvas data-active:ring-2 data-active:ring-racing-green data-active:ring-inset sm:text-sm';
        const text = document.createElement('span');
        text.textContent = name;
        const aliasEl = document.createElement('span');
        aliasEl.className = 'font-normal text-ink-muted';
        text.append(aliasEl);
        el.append(text);
        el.insertAdjacentHTML('beforeend', checkIcon);
        return {
          name,
          folded: fold(name),
          words: fold(name).split(/[\s()]+/).filter(Boolean),
          aliases: (box.dataset.aliases || '')
            .split('|')
            .filter(Boolean)
            .map((label) => ({ label, folded: fold(label) })),
          box,
          el,
          aliasEl,
        };
      });
      const byName = new Map(options.map((option) => [option.name, option]));

      let order = boxes.filter((box) => box.checked).map((box) => box.value);
      let visible: LanguageOption[] = [];
      let active = -1;
      let open = false;
      let statusTimer: number | undefined;

      /** One pending message at a time, so a burst of picks reads only the last. */
      const announce = (message: string, delay = 50) => {
        window.clearTimeout(statusTimer);
        // Cleared first so the same message twice in a row is still read out.
        status.textContent = '';
        statusTimer = window.setTimeout(() => {
          status.textContent = message;
        }, delay);
      };

      const values = (): string[] => order.filter((name) => byName.get(name)?.box.checked);

      const renderChips = () => {
        chips.replaceChildren(
          ...order.map((name) => {
            const item = document.createElement('li');
            const button = document.createElement('button');
            button.type = 'button';
            button.dataset.value = name;
            button.setAttribute('aria-label', `Remove ${name}`);
            button.className =
              'focus-ring inline-flex min-h-11 items-center gap-2 rounded-full border border-ink bg-ink pr-3.5 pl-4 text-sm font-bold text-white transition-colors hover:bg-[#1a1a2c]';
            const label = document.createElement('span');
            label.textContent = name;
            button.append(label);
            button.insertAdjacentHTML('beforeend', removeIcon);
            item.append(button);
            return item;
          })
        );
        chips.hidden = order.length === 0;
      };

      const setActive = (index: number) => {
        active = index;
        visible.forEach((option, i) => option.el.toggleAttribute('data-active', i === index));
        const current = visible[index];
        if (current) {
          input.setAttribute('aria-activedescendant', current.el.id);
          current.el.scrollIntoView({ block: 'nearest' });
        } else {
          input.removeAttribute('aria-activedescendant');
        }
      };

      /** Shows the listbox, or the "no match" note, to match `visible`. */
      const paint = () => {
        const hasQuery = input.value.trim().length > 0;
        listbox.hidden = !open || visible.length === 0;
        empty.hidden = !open || visible.length > 0 || !hasQuery;
        input.setAttribute('aria-expanded', String(!listbox.hidden));
        if (!empty.hidden) {
          empty.textContent = `No language matches “${input.value.trim()}”. Check the spelling, or tell us about it in the last step.`;
        }
      };

      /**
       * Best matches first: name prefix, then a later word in the name, then an
       * alternative name, then anywhere in either. With a query the top match
       * is highlighted, so typing "pol" then Enter adds Polish.
       */
      const filter = () => {
        const query = fold(input.value);
        if (!query) {
          visible = options.slice();
          options.forEach((option) => (option.aliasEl.textContent = ''));
        } else {
          const ranked: Array<{ option: LanguageOption; rank: number; index: number }> = [];
          options.forEach((option, index) => {
            const aliasStart = option.aliases.find((alias) => alias.folded.startsWith(query));
            const aliasAnywhere = option.aliases.find((alias) => alias.folded.includes(query));
            let rank = -1;
            let alias: string | undefined;
            if (option.folded.startsWith(query)) rank = 0;
            else if (option.words.some((word) => word.startsWith(query))) rank = 1;
            else if (aliasStart) [rank, alias] = [2, aliasStart.label];
            else if (option.folded.includes(query)) rank = 3;
            else if (aliasAnywhere) [rank, alias] = [4, aliasAnywhere.label];
            option.aliasEl.textContent = alias ? ` (${alias})` : '';
            if (rank >= 0) ranked.push({ option, rank, index });
          });
          ranked.sort((a, b) => a.rank - b.rank || a.index - b.index);
          visible = ranked.map((entry) => entry.option);
        }
        listbox.replaceChildren(...visible.map((option) => option.el));
        listbox.scrollTop = 0;
        setActive(query && visible.length ? 0 : -1);
        paint();
      };

      const openList = () => {
        if (open) return;
        open = true;
        paint();
      };

      const closeList = () => {
        open = false;
        setActive(-1);
        paint();
      };

      /** After a pick, clear the search so the next language can be typed. */
      const resetQuery = (keepInView?: LanguageOption) => {
        if (!input.value) return;
        input.value = '';
        filter();
        keepInView?.el.scrollIntoView({ block: 'nearest' });
      };

      const add = (option: LanguageOption): boolean => {
        if (option.box.checked) {
          announce(`${option.name} is already chosen. ${countLabel(values().length)}`);
          return false;
        }
        if (values().length >= maxLanguages) {
          fail(`You can choose up to ${maxLanguages} languages.`);
          return false;
        }
        option.box.checked = true;
        order = [...order.filter((name) => name !== option.name), option.name];
        option.el.setAttribute('aria-selected', 'true');
        input.removeAttribute('aria-invalid');
        clearError();
        renderChips();
        announce(`${option.name} added. ${countLabel(values().length)}`);
        return true;
      };

      const remove = (option: LanguageOption) => {
        option.box.checked = false;
        order = order.filter((name) => name !== option.name);
        option.el.setAttribute('aria-selected', 'false');
        renderChips();
        announce(`${option.name} removed. ${countLabel(values().length)}`);
      };

      // Enhance: swap the checkbox group for the picker.
      options.forEach((option) => option.el.setAttribute('aria-selected', String(option.box.checked)));
      fallback.hidden = true;
      picker.hidden = false;
      renderChips();
      filter();

      input.addEventListener('input', () => {
        open = true;
        filter();
        const query = input.value.trim();
        if (!query) {
          window.clearTimeout(statusTimer);
          return;
        }
        // Read the match count once typing pauses, not on every keystroke.
        announce(
          visible.length === 0
            ? `No language matches ${query}.`
            : `${visible.length} ${visible.length === 1 ? 'language matches' : 'languages match'}. Use the arrow keys to choose.`,
          600
        );
      });

      input.addEventListener('click', openList);

      input.addEventListener('keydown', (event) => {
        if (event.isComposing) return;
        const hasQuery = input.value.trim().length > 0;

        switch (event.key) {
          case 'ArrowDown':
          case 'ArrowUp': {
            event.preventDefault();
            const down = event.key === 'ArrowDown';
            if (!open) {
              openList();
              if (event.altKey) return;
            }
            const n = visible.length;
            if (!n) return;
            if (active < 0) setActive(down ? 0 : n - 1);
            else setActive((active + (down ? 1 : -1) + n) % n);
            return;
          }
          case 'Enter': {
            // A closed, empty picker leaves Enter to the stepper (next step).
            if (!open && !hasQuery) return;
            event.preventDefault();
            event.stopPropagation();
            if (!open) return openList();
            const option = visible[active];
            if (!option) {
              if (!hasQuery) closeList();
              return;
            }
            if (hasQuery) {
              // Typed then Enter means "add": never untick by accident.
              add(option);
              resetQuery(option);
            } else if (option.box.checked) {
              remove(option);
            } else {
              add(option);
            }
            return;
          }
          case 'Escape': {
            if (open) {
              event.preventDefault();
              event.stopPropagation();
              closeList();
            } else if (input.value) {
              event.preventDefault();
              input.value = '';
              filter();
            }
            return;
          }
          case 'Backspace': {
            if (input.value || input.selectionStart !== 0) return;
            const last = byName.get(order[order.length - 1] ?? '');
            if (last) {
              event.preventDefault();
              remove(last);
            }
            return;
          }
          case 'Tab':
            closeList();
            return;
        }
      });

      // Keep focus (and a phone's keyboard) in the search box while picking.
      listbox.addEventListener('mousedown', (event) => event.preventDefault());

      listbox.addEventListener('click', (event) => {
        const el = (event.target as HTMLElement).closest<HTMLLIElement>('[role="option"]');
        const option = options.find((candidate) => candidate.el === el);
        if (!option) return;
        if (option.box.checked) remove(option);
        else add(option);
        resetQuery(option);
        const index = visible.indexOf(option);
        if (document.activeElement === input && index >= 0) setActive(index);
      });

      chips.addEventListener('click', (event) => {
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-value]');
        const option = byName.get(button?.dataset.value ?? '');
        if (!button || !option) return;
        const index = Array.from(chips.querySelectorAll('button')).indexOf(button);
        remove(option);
        // Focus the chip that took its place, else the one before, else search.
        const remaining = Array.from(chips.querySelectorAll<HTMLButtonElement>('button'));
        (remaining[Math.min(index, remaining.length - 1)] ?? input).focus();
      });

      // The stepper treats Enter as "next step", so handle it (and Delete or
      // Backspace) on a chip here before it gets that far.
      chips.addEventListener('keydown', (event) => {
        if (!['Enter', 'Delete', 'Backspace'].includes(event.key)) return;
        const button = (event.target as HTMLElement).closest<HTMLButtonElement>('button[data-value]');
        if (!button) return;
        event.preventDefault();
        event.stopPropagation();
        button.click();
      });

      // Close when focus moves somewhere else or the visitor taps outside. A
      // blur with nowhere to go (a phone's "Done" key) keeps the list open so
      // it can still be scrolled and tapped with the keyboard put away.
      input.addEventListener('blur', (event) => {
        const next = event.relatedTarget as Node | null;
        if (next && !listbox.contains(next)) closeList();
      });
      document.addEventListener('pointerdown', (event) => {
        if (open && !picker.contains(event.target as Node)) closeList();
      });

      return { input, values };
    };

    const languagePicker = setUpLanguagePicker();
    /** Chosen languages, in the order picked; the bare checkboxes if no picker. */
    const chosenLanguages = (): string[] =>
      languagePicker ? languagePicker.values() : checkedValues('languages');

    /**
     * Per-step gate. Native constraints first (required, minlength, type=email)
     * so the browser shows its own message against the offending field, then
     * the checks the markup cannot express.
     */
    const validateStep = (step: number): boolean => {
      const el = stepEls[step - 1];
      if (!el) return true;

      for (const field of Array.from(
        el.querySelectorAll<HTMLInputElement | HTMLTextAreaElement | HTMLSelectElement>(
          'input, textarea, select'
        )
      )) {
        if (field.disabled) continue;
        field.setCustomValidity('');
        if (field.required && 'value' in field && !field.value.trim()) {
          field.setCustomValidity('Please fill in this field.');
        }
        if (field.id === 'apply-phone' && field.value && !toE164(field.value)) {
          field.setCustomValidity('Enter a valid UK mobile number beginning 07 or +44 7.');
        }
        if (field.id === 'apply-password' && field.value && !isStrongPassword(field.value)) {
          field.setCustomValidity(
            'Use 8 or more characters with uppercase, lowercase, a number and a symbol.'
          );
        }
        if (!field.checkValidity()) {
          clearError();
          field.reportValidity();
          return false;
        }
      }

      if (step === 1) {
        if (chosenLanguages().length === 0) {
          languagePicker?.input.setAttribute('aria-invalid', 'true');
          return fail(
            'Please choose at least one language you teach in.',
            languagePicker?.input ?? el.querySelector<HTMLInputElement>('input[name="languages"]')
          );
        }

        const testCentres = el.querySelectorAll('input[name="test_centres"]:checked');
        if (testCentres.length === 0) {
          return fail(
            'Please choose at least one practical test centre you cover.',
            el.querySelector<HTMLInputElement>('input[name="test_centres"]:not(:disabled)') ??
              citySelect
          );
        }
      }

      if (step === 2) {
        const password = form.querySelector<HTMLInputElement>('#apply-password');
        const confirm = form.querySelector<HTMLInputElement>('#apply-password-confirm');
        if (password && confirm && password.value !== confirm.value) {
          return fail('Those two passwords do not match.', confirm);
        }
      }

      if (step === 4) {
        const transmissions = form.querySelectorAll('input[name="transmissions"]:checked');
        if (transmissions.length === 0) {
          return fail('Please choose at least one transmission you teach in.');
        }
        const lessonLengths = form.querySelectorAll('input[name="lesson_types"]:checked');
        if (lessonLengths.length === 0) {
          return fail('Please choose at least one lesson length you offer.');
        }
      }

      if (step === 5) {
        const activeRows = Array.from(
          root.querySelectorAll<HTMLElement>('[data-availability-row]')
        ).filter((row) => row.querySelector<HTMLInputElement>('[data-availability-toggle]')?.checked);
        if (activeRows.length === 0) {
          return fail('Please choose at least one day you are available.');
        }
        for (const row of activeRows) {
          const start = row.querySelector<HTMLInputElement>('[data-availability-start]');
          const end = row.querySelector<HTMLInputElement>('[data-availability-end]');
          if (!start?.value || !end?.value || end.value <= start.value) {
            return fail('Each available day needs an end time after its start time.', start);
          }
        }
      }

      clearError();
      return true;
    };

    const show = (step: number, { focus = true }: { focus?: boolean } = {}) => {
      current = Math.min(Math.max(step, 1), total);
      stepEls.forEach((el, index) => {
        el.hidden = index + 1 !== current;
      });
      ticks.forEach((tick, index) => {
        tick.classList.toggle('bg-racing-green', index + 1 <= current);
        tick.classList.toggle('bg-border', index + 1 > current);
      });

      currentLabel.textContent = String(current);
      stepName.textContent = names[current - 1] ?? '';
      announce.textContent = `Step ${current} of ${total}: ${names[current - 1] ?? ''}`;

      backButton.hidden = current === 1;
      nextButton.hidden = current === total;
      submitButton.hidden = current !== total;

      if (focus) {
        stepEls[current - 1]?.querySelector<HTMLElement>('[data-step-heading]')?.focus();
        // Keep the top of the form in view on a phone, where a long step can
        // otherwise leave the heading off-screen above the fold.
        form.scrollIntoView({ block: 'start', behavior: 'smooth' });
      }
    };

    // Enhance: reveal the chrome and collapse to one step at a time. Everything
    // above this point renders as a plain stacked form without JavaScript.
    chrome.hidden = false;
    const adiExpiry = form.querySelector<HTMLInputElement>('#apply-adi-expiry');
    if (adiExpiry) adiExpiry.min = new Date().toISOString().slice(0, 10);
    show(1, { focus: false });

    nextButton.addEventListener('click', () => {
      if (validateStep(current)) show(current + 1);
    });

    backButton.addEventListener('click', () => {
      clearError();
      show(current - 1);
    });

    // Enter should advance rather than submit, except on the final step.
    // Buttons and links keep their own Enter: on Back it means "back", and
    // treating it as "next step" sent keyboard users the wrong way.
    form.addEventListener('keydown', (event) => {
      if (event.key !== 'Enter') return;
      const target = event.target as HTMLElement;
      if (target.tagName === 'TEXTAREA') return;
      if (target.closest('button, a[href], [role="button"]')) return;
      if (current !== total) {
        event.preventDefault();
        if (validateStep(current)) show(current + 1);
      }
    });

    // Time inputs stay disabled until the day is ticked, so an unchecked day
    // can never contribute an availability rule.
    root.querySelectorAll<HTMLElement>('[data-availability-row]').forEach((row) => {
      const toggle = row.querySelector<HTMLInputElement>('[data-availability-toggle]');
      const start = row.querySelector<HTMLInputElement>('[data-availability-start]');
      const end = row.querySelector<HTMLInputElement>('[data-availability-end]');
      toggle?.addEventListener('change', () => {
        if (!start || !end) return;
        start.disabled = !toggle.checked;
        end.disabled = !toggle.checked;
        start.required = toggle.checked;
        end.required = toggle.checked;
      });
    });

    const splitList = (value: string): string[] =>
      value
        .split(',')
        .map((part) => part.trim())
        .filter(Boolean);

    const checkedValues = (name: string): string[] =>
      Array.from(form.querySelectorAll<HTMLInputElement>(`input[name="${name}"]:checked`)).map(
        (input) => input.value
      );

    const isStrongPassword = (value: string): boolean =>
      value.length >= 8 &&
      /[a-z]/.test(value) &&
      /[A-Z]/.test(value) &&
      /\d/.test(value) &&
      /[^A-Za-z0-9]/.test(value);

    /** Valid UK mobile as typed (07… or +44 7…) into the E.164 the API expects. */
    const toE164 = (raw: string): string | null => {
      const compact = raw.replace(/[\s()-]/g, '');
      if (/^07\d{9}$/.test(compact)) return `+44${compact.slice(1)}`;
      if (/^\+447\d{9}$/.test(compact)) return compact;
      if (/^00447\d{9}$/.test(compact)) return `+${compact.slice(2)}`;
      return null;
    };

    const collectAvailability = () => {
      const today = new Date().toISOString().slice(0, 10);
      const rules: Array<Record<string, unknown>> = [];
      root.querySelectorAll<HTMLElement>('[data-availability-row]').forEach((row) => {
        const toggle = row.querySelector<HTMLInputElement>('[data-availability-toggle]');
        const start = row.querySelector<HTMLInputElement>('[data-availability-start]');
        const end = row.querySelector<HTMLInputElement>('[data-availability-end]');
        if (!toggle?.checked || !start?.value || !end?.value) return;
        if (end.value <= start.value) return;
        rules.push({
          weekday: Number(row.dataset.weekday),
          start_time: start.value,
          end_time: end.value,
          effective_from: today,
          effective_until: null,
        });
      });
      return rules;
    };

    let submitting = false;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;

      // Re-check every step, not just the last: someone can go back, break an
      // earlier answer, then jump forward again.
      for (let step = 1; step <= total; step += 1) {
        if (!validateStep(step)) {
          if (current !== step) show(step);
          return;
        }
      }

      const data = new FormData(form);
      const email = String(data.get('email') || '').trim().toLowerCase();

      const adiFile = (form.querySelector<HTMLInputElement>('#apply-adi-doc')?.files || [])[0];
      const files: Record<string, File> = adiFile ? { adi: adiFile } : {};
      const lessonSelected = checkedValues('lesson_types');
      const testCentres = checkedValues('test_centres');

      const payload = {
        full_name: String(data.get('full_name') || '').trim(),
        email,
        password: String(data.get('password') || ''),
        phone_e164: toE164(String(data.get('phone') || '')),
        driving_school_name: String(data.get('driving_school_name') || '').trim() || null,
        bio: String(data.get('bio') || '').trim() || null,
        price_per_hour_pounds: Number(data.get('price_per_hour_pounds') || 0),
        transmissions: checkedValues('transmissions'),
        // Names from the picker's fixed list, never free text.
        languages: chosenLanguages(),
        specialisms: splitList(String(data.get('specialisms') || '')),
        // Stable slugs, not display names: the slug is the join key the API
        // stores in instructor_test_centres, and DVSA renames sites. The
        // catchment columns are now derived server-side from these, so the
        // client no longer constructs service_areas or picks the city anchor.
        test_centre_slugs: testCentres,
        car_make: String(data.get('car_make') || '').trim() || null,
        car_model: String(data.get('car_model') || '').trim() || null,
        car_color: String(data.get('car_color') || '').trim() || null,
        adi_number: String(data.get('adi_number') || '').trim() || null,
        adi_badge_expires_on: String(data.get('adi_badge_expires_on') || ''),
        dvsa_verification_consent: data.get('dvsa_verification_consent') === 'yes',
        application_notes: String(data.get('application_notes') || '').trim() || null,
        lesson_types: {
          '1h': lessonSelected.includes('1h'),
          '90m': lessonSelected.includes('90m'),
          '2h': lessonSelected.includes('2h'),
          mock_test: false,
        },
        weekly_availability: collectAvailability(),
        documents: adiFile
          ? [{ kind: 'adi', content_type: adiFile.type || 'application/octet-stream' }]
          : [],
      };

      submitting = true;
      submitButton.disabled = true;
      backButton.disabled = true;
      submitLabel.textContent = 'Submitting...';
      clearError();

      try {
        const res = await fetch('/api/instructor-apply', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        const body = (await res.json().catch(() => ({}))) as {
          error?: string;
          uploads?: Array<{ kind: string; signed_url: string }>;
        };

        if (!res.ok) throw new Error(body.error || 'Something went wrong. Please try again.');

        // The account exists from here on. The optional badge upload is a follow-up
        // step: if they fail we still show success, because re-submitting the
        // form would only collide with the account we just created.
        submitLabel.textContent = adiFile ? 'Uploading badge image...' : 'Finishing...';
        let uploadsOk = true;

        for (const upload of body.uploads || []) {
          const file = files[upload.kind];
          if (!file) continue;
          try {
            const put = await fetch(upload.signed_url, {
              method: 'PUT',
              headers: { 'content-type': file.type || 'application/octet-stream' },
              body: file,
            });
            if (!put.ok) uploadsOk = false;
          } catch {
            uploadsOk = false;
          }
        }

        successEmail.textContent = email;
        uploadWarning.hidden = uploadsOk;
        form.hidden = true;
        success.hidden = false;
        success.focus();
      } catch (err) {
        fail(err instanceof Error ? err.message : 'Something went wrong. Please try again.');
        submitLabel.textContent = 'Submit application';
      } finally {
        submitting = false;
        submitButton.disabled = false;
        backButton.disabled = false;
      }
    });
  }
</script>
