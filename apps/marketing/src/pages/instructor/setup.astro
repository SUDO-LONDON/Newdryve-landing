---
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Instructor payout setup | Newdryve"
  description="Use your secure Newdryve email link to connect your Stripe payout account."
  path="/instructor/setup"
  audience="instructor"
  noindex
>
  <div class="mx-auto flex max-w-lg flex-col justify-center px-5 py-16 sm:py-24">
    <section class="rounded-2xl border border-border bg-white p-7 text-center shadow-[0_20px_50px_-30px_rgba(10,10,20,0.22)] sm:p-10">
      <p class="text-[11px] font-bold uppercase tracking-[1px] text-racing-green">Instructor setup</p>
      <h1 class="font-display mt-3 text-3xl font-semibold text-ink">Use your secure payout link</h1>
      <p class="mt-4 text-sm leading-6 text-ink-secondary">
        Stripe Connect setup now happens online through your private Newdryve email link. That link opens a secure Stripe page for your bank details.
      </p>
      <a
        class="focus-ring mt-7 inline-flex h-12 items-center justify-center rounded-full bg-racing-green px-6 text-sm font-bold text-white"
        href="mailto:support@newdryve.com?subject=Resend%20Stripe%20Connect%20setup%20link"
      >
        Ask support to resend link
      </a>
      <p class="mt-5 text-xs leading-5 text-ink-muted">
        Need help? Email <a class="font-semibold underline" href="mailto:support@newdryve.com">support@newdryve.com</a>.
      </p>
    </section>
  </div>
</BaseLayout>
