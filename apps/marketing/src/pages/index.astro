---
/**
 * Learner home. Built from docs/redesign/learner-home.reference.html (the
 * approved design); copy is taken from it verbatim.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import CoverageCheck from '../components/CoverageCheck.astro';
import AvatarPicker from '../components/AvatarPicker.astro';
import AppBand from '../components/AppBand.astro';
import { BACKERS } from '../config/site';
import {
  organizationSchema,
  websiteSchema,
  learnerServiceSchema,
  breadcrumbSchema,
} from '../lib/schema';

const title = 'Book Driving Lessons in Norwich | Newdryve';
const description =
  'Find verified driving instructors in Norwich, see real availability, and join the learner waitlist. Newdryve is free for learners.';

const jsonLd = [
  organizationSchema,
  websiteSchema,
  learnerServiceSchema,
  breadcrumbSchema([{ name: 'Home', path: '/' }]),
];

const TRUST_POINTS = ['DVSA registration checked', 'Real availability', 'No booking fee'];

const SLOTS = ['Tue 4:00pm', 'Wed 9:30am', 'Fri 1:00pm', 'Sat 10:00am'];
const SELECTED_SLOT = 'Sat 10:00am';

const CANCELLATION = [
  { when: 'More than 24 hours before', cost: 'Free' },
  { when: 'Within 24 hours', cost: '50% of the lesson' },
  { when: 'Within 30 minutes of the start', cost: 'Full price' },
];

const FAQ = [
  {
    q: 'How do I book a lesson?',
    a: 'Open the app, browse instructors near you and pick a slot from their real availability. You need a valid card saved before you can book, but nothing is charged when you reserve a lesson.',
  },
  {
    q: 'Are the instructors qualified?',
    a: 'Every instructor’s current DVSA registration is checked before their profile goes live. You can also see their experience, specialisms and the areas they cover.',
  },
  {
    q: 'What happens if a card payment fails?',
    a: 'We try the card again automatically. If it still fails, you can pay in the app with Pay now. Until it’s paid, or your instructor settles it, you can’t book new lessons.',
  },
];

const check = `<svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12.5l4.5 4.5L19 7.5"></path></svg>`;

const stepContent = 'grid min-w-0 flex-1 items-center gap-7 pb-16 md:pb-20 lg:grid-cols-2 lg:gap-x-16';
const stepBody = 'mt-3.5 max-w-[27em]';
---

<BaseLayout
  title={title}
  description={description}
  path="/"
  jsonLd={jsonLd}
  audience="learner"
  appHref="#get-the-app"
>
  <!-- HERO -->
  <section class="bg-mint" aria-labelledby="hero-title">
    <div class="nd-container flex flex-wrap items-end gap-x-12 gap-y-8 pt-12 md:pt-[72px]">
      <div class="flex min-w-0 flex-[1.4_1_520px] flex-col items-start pb-12 md:pb-[88px]">
        <p class="nd-hand mb-3 ml-1.5">hello, Norwich</p>
        <h1 id="hero-title" class="nd-display">
          driving <span
            aria-hidden="true"
            class="nd-swing inline-flex h-[1.18em] w-[1.18em] -rotate-6 items-center [--nd-rot:-6deg] justify-center rounded-[0.16em] bg-white align-[0.02em] text-[0.74em] tracking-normal text-hot-pink shadow-[0_0.07em_0_var(--forest)]"
            >L</span
          > lessons, minus the <span class="nd-highlight">faff.</span>
        </h1>
        <p class="nd-lede mt-7 max-w-[34em]">
          Find a driving instructor whose DVSA registration we&rsquo;ve checked, see when they&rsquo;re
          actually free, and book in the app. Free for learners.
        </p>

        <div class="mt-9 w-full">
          <CoverageCheck />
        </div>

        <ul class="mt-7 flex flex-wrap gap-x-[22px] gap-y-2.5 text-base font-semibold">
          {
            TRUST_POINTS.map((point) => (
              <li class="inline-flex items-center gap-2">
                <Fragment set:html={check} />
                {point}
              </li>
            ))
          }
        </ul>
      </div>

      <div class="flex min-w-0 flex-[1_1_300px] justify-center">
        <figure class="relative w-full max-w-[320px]">
          <div class="h-[440px] rounded-t-[48px] bg-forest px-3 pt-3 sm:h-[540px]">
            <div class="h-full overflow-hidden rounded-t-[36px] bg-paper">
              <img
                src="/product/newdryve-learner-home.png"
                alt="The newdryve app home screen, showing the next lesson, what to practise next, and shortcuts to book a lesson or find test centres"
                width="900"
                height="1948"
                loading="eager"
                fetchpriority="high"
                decoding="async"
                class="block h-auto w-full"
              />
            </div>
          </div>
        </figure>
      </div>
    </div>
  </section>

  {
    BACKERS.show && (
      <section aria-label="Who is behind newdryve" class="border-b-2 border-forest">
        <div class="nd-container flex flex-wrap gap-x-[72px] gap-y-5 py-9">
          <div class="flex flex-wrap items-baseline gap-x-7 gap-y-1.5">
            <span class="nd-small-label">Backed by</span>
            {BACKERS.backedBy.map((name) => (
              <span class="font-heading text-[21px] font-bold tracking-[-0.02em]">{name}</span>
            ))}
          </div>
          <div class="flex flex-wrap items-baseline gap-x-7 gap-y-1.5">
            <span class="nd-small-label">Teaching on newdryve</span>
            {BACKERS.teachingOnNewdryve.map((name) => (
              <span class="font-heading text-[21px] font-bold tracking-[-0.02em]">{name}</span>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <!-- FROM GREEN TO PINK -->
  <section id="route" class="pt-20 pb-6 md:pt-[104px]" aria-labelledby="route-title">
    <div class="nd-container">
      <div class="mb-16 grid items-center gap-x-16 gap-y-9 md:grid-cols-2 md:mb-[72px]">
        <div>
          <h2 id="route-title" class="nd-h2">from green to pink</h2>
          <p class="nd-lede mt-[18px] max-w-[30em]">
            Your provisional licence is green. The full one is pink. Here&rsquo;s the bit in between.
          </p>
        </div>
        <div class="flex justify-center md:justify-end">
          <AvatarPicker />
        </div>
      </div>

      <ol class="flex flex-col">
        <!-- 1 -->
        <li class="flex flex-col gap-4 md:flex-row md:gap-7">
          <div aria-hidden="true" class="flex flex-[0_0_56px] flex-col items-start md:items-center">
            <span class="nd-marker">1</span>
            <span class="nd-rail my-2.5 hidden w-0 flex-1 border-l-4 border-dashed border-forest md:block"></span>
          </div>
          <div class={stepContent}>
            <div>
              <h3 class="nd-h3">Find an instructor we&rsquo;ve checked</h3>
              <p class={stepBody}>
                We check every instructor&rsquo;s current DVSA registration before their profile goes
                live. Filter by manual or automatic, and see their rate and the areas they cover.
              </p>
            </div>
            <div class="rounded-[32px] bg-mint p-4 sm:p-6">
              <div class="flex flex-col gap-3.5 rounded-[20px] bg-paper p-5">
                <div class="flex items-center justify-between gap-3">
                  <div class="flex min-w-0 items-center gap-3">
                    <span aria-hidden="true" class="size-12 shrink-0 rounded-full bg-forest"></span>
                    <div class="min-w-0">
                      <p class="text-lg leading-tight font-semibold">Sample instructor</p>
                      <p class="text-[15px]">Manual, £38 an hour</p>
                    </div>
                  </div>
                  <span class="nd-chip">Example</span>
                </div>
                <div class="flex flex-wrap gap-2 text-sm font-semibold">
                  <span class="inline-flex items-center gap-1.5 rounded-full bg-forest px-3 py-1.5 text-paper">
                    <Fragment set:html={check.replace(/18/g, '14')} />
                    DVSA registration checked
                  </span>
                  <span class="nd-tag">Covers NR2, NR4, NR7</span>
                </div>
                <p class="border-t-2 border-dashed border-forest pt-3 text-[15px]">
                  Next free: <strong>Tue 4:00pm</strong>
                </p>
              </div>
            </div>
          </div>
        </li>

        <!-- 2 -->
        <li class="flex flex-col gap-4 md:flex-row md:gap-7">
          <div aria-hidden="true" class="flex flex-[0_0_56px] flex-col items-start md:items-center">
            <span class="nd-marker">2</span>
            <span class="nd-rail my-2.5 hidden w-0 flex-1 border-l-4 border-dashed border-forest md:block"></span>
          </div>
          <div class={stepContent}>
            <div>
              <h3 class="nd-h3">Book a slot that&rsquo;s actually free</h3>
              <p class={stepBody}>
                You see real open slots, not a contact form. Pick one and confirm. No phone tag, no
                waiting days for a reply.
              </p>
            </div>
            <div class="rounded-[32px] bg-pink p-4 sm:p-6">
              <div class="flex flex-col gap-3.5 rounded-[20px] bg-paper p-5" data-slot-picker>
                <div class="flex items-center justify-between gap-3">
                  <p class="text-[17px] font-semibold" id="slots-title">Free this week</p>
                  <span class="nd-chip">Example</span>
                </div>
                <div class="grid grid-cols-2 gap-2.5" role="group" aria-labelledby="slots-title">
                  {
                    SLOTS.map((slot) => (
                      <button
                        type="button"
                        class="h-[52px] rounded-[14px] border-2 border-chip bg-chip text-base font-semibold aria-pressed:border-forest aria-pressed:bg-forest aria-pressed:text-paper"
                        aria-pressed={slot === SELECTED_SLOT ? 'true' : 'false'}
                        data-slot
                      >
                        {slot}
                      </button>
                    ))
                  }
                </div>
                <p class="text-[15px]" aria-live="polite">
                  Selected: <strong data-slot-label>{SELECTED_SLOT}</strong>
                </p>
              </div>
            </div>
          </div>
        </li>

        <!-- 3 -->
        <li class="flex flex-col gap-4 md:flex-row md:gap-7">
          <div aria-hidden="true" class="flex flex-[0_0_56px] flex-col items-start md:items-center">
            <span class="nd-marker">3</span>
            <span class="nd-rail my-2.5 hidden w-0 flex-1 border-l-4 border-dashed border-forest md:block"></span>
          </div>
          <div class={stepContent}>
            <div>
              <h3 class="nd-h3">Know what to practise next</h3>
              <p class={stepBody}>
                Every lesson, the skills your instructor has signed off, and how close you are to
                test-ready, all in one place.
              </p>
            </div>
            <ul class="flex flex-col gap-1.5 rounded-[32px] bg-forest p-6 text-paper sm:p-7">
              <li class="flex items-center justify-between gap-3 py-2.5 text-[17px] font-semibold">
                <span>Roundabouts</span>
                <span class="rounded-full border-2 border-paper px-3.5 py-1 text-sm">Getting there</span>
              </li>
              <li class="flex items-center justify-between gap-3 py-2.5 text-[17px] font-semibold">
                <span>Parallel parking</span>
                <span class="rounded-full border-2 border-mint bg-mint px-3.5 py-1 text-sm text-forest"
                  >Practise next</span
                >
              </li>
              <li class="flex items-center justify-between gap-3 py-2.5 text-[17px] font-semibold">
                <span>Dual carriageways</span>
                <span class="rounded-full border-2 border-dashed border-paper px-3.5 py-1 text-sm"
                  >Coming up</span
                >
              </li>
            </ul>
          </div>
        </li>

        <!-- 4 -->
        <li class="flex flex-col gap-4 md:flex-row md:gap-7">
          <div aria-hidden="true" class="flex flex-[0_0_56px] flex-col items-start md:items-center">
            <span class="nd-marker bg-pink">4</span>
          </div>
          <div class={stepContent}>
            <div>
              <h3 class="nd-h3">Swap the green one for the pink one</h3>
              <p class={stepBody}>
                Your instructor tells you when you&rsquo;re test-ready. You book the test itself on
                GOV.UK, and your lessons keep moving until the day.
              </p>
            </div>
            <div aria-hidden="true" class="flex items-center justify-center py-5">
              <div
                class="flex h-[116px] w-[180px] nd-licence-a -rotate-8 flex-col justify-between rounded-2xl border-2 border-forest bg-mint p-4 sm:h-[140px] sm:w-[220px]"
              >
                <span class="font-heading text-xl font-extrabold tracking-[-0.02em]">provisional</span>
                <span class="flex items-end gap-3">
                  <span class="h-10 w-9 rounded-md border-2 border-forest bg-paper sm:h-[54px] sm:w-11"></span>
                  <span class="flex flex-1 flex-col gap-2">
                    <span class="h-2 rounded bg-forest"></span>
                    <span class="h-2 w-3/5 rounded bg-forest"></span>
                  </span>
                </span>
              </div>
              <div
                class="nd-shadow -ml-11 flex h-[116px] w-[180px] nd-licence-b rotate-7 flex-col justify-between rounded-2xl border-2 border-forest bg-pink p-4 sm:-ml-14 sm:h-[140px] sm:w-[220px]"
              >
                <span class="font-heading text-xl font-extrabold tracking-[-0.02em]">full</span>
                <span class="flex items-end gap-3">
                  <span class="h-10 w-9 rounded-md border-2 border-forest bg-paper sm:h-[54px] sm:w-11"></span>
                  <span class="flex flex-1 flex-col gap-2">
                    <span class="h-2 rounded bg-forest"></span>
                    <span class="h-2 w-3/5 rounded bg-forest"></span>
                  </span>
                </span>
              </div>
            </div>
          </div>
        </li>
      </ol>
    </div>
  </section>

  <!-- THE MONEY BIT -->
  <section id="money" class="pt-6 pb-20 md:pb-[104px]" aria-labelledby="money-title">
    <div class="nd-container">
      <h2 id="money-title" class="nd-h2 mb-9">the money bit</h2>
      <div
        class="nd-card-lg grid items-center gap-x-[72px] gap-y-10 p-[clamp(24px,4vw,56px)] lg:grid-cols-2"
      >
        <div>
          <p class="nd-number text-[clamp(110px,15vw,210px)] text-hot-pink">£0</p>
          <p class="nd-lede mt-6 max-w-[22em]">
            <strong>in booking fees.</strong> Each instructor sets their own rate and you see it before
            you book. You pay your instructor for the lesson and nothing to us.
          </p>
        </div>
        <div class="flex flex-col gap-7">
          <div>
            <h3 class="mb-2 text-xl font-semibold">If you need to cancel</h3>
            <dl class="flex flex-col">
              {
                CANCELLATION.map((row) => (
                  <div class="flex justify-between gap-6 border-b-2 border-dashed border-forest py-3.5">
                    <dt>{row.when}</dt>
                    <dd class="text-right font-semibold">{row.cost}</dd>
                  </div>
                ))
              }
            </dl>
            <p class="mt-3 text-base">Cancellation fees go to your instructor. Newdryve takes none of it.</p>
          </div>
          <div>
            <h3 class="mb-2 text-xl font-semibold">How you pay</h3>
            <p class="text-[17px]">
              At the end of each lesson, by cash, bank transfer or your saved card. Your instructor
              chooses. Nothing is charged when you book.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- STARTING SMALL -->
  <section id="where-we-are" class="pb-20 md:pb-[104px]" aria-labelledby="where-title">
    <div class="nd-container grid items-start gap-x-[72px] gap-y-8 lg:grid-cols-2">
      <h2 id="where-title" class="nd-h2">starting small, on purpose</h2>
      <p class="nd-lede">
        Newdryve is new. The app is live on the App Store and Google Play, and we&rsquo;re
        hand-picking founding instructors in Norwich one at a time. No inflated numbers and no
        invented reviews.
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq" class="pb-24 md:pb-28" aria-labelledby="faq-title">
    <div class="nd-container grid items-start gap-x-[72px] gap-y-8 lg:grid-cols-2">
      <h2 id="faq-title" class="nd-h2">learner questions</h2>
      <div class="flex flex-col border-t-2 border-forest">
        <!-- The first answer links to the postcode check, so it is written out
             here rather than going through the plain-text Faq component. -->
        <details class="group border-b-2 border-forest" open>
          <summary class="flex min-h-11 items-center justify-between gap-4 py-5 text-xl font-semibold">
            Is Newdryve available in my area?
            <span
              class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-forest transition-transform duration-200 group-open:rotate-45"
              aria-hidden="true"
            >
              <svg width="16" height="16" viewBox="0 0 18 18" fill="none"><path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"></path></svg>
            </span>
          </summary>
          <p class="mb-6 max-w-[34em] text-[17px]">
            Newdryve is live in Norwich and the surrounding Norfolk area, including Thorpe St Andrew,
            Hellesdon, Sprowston, Costessey and Wymondham. <a href="#check" class="font-semibold underline"
              >Check your postcode</a
            > and, if we&rsquo;re not there yet, we&rsquo;ll add you to the waitlist.
          </p>
        </details>
        {
          FAQ.map((item) => (
            <details class="group border-b-2 border-forest">
              <summary class="flex min-h-11 items-center justify-between gap-4 py-5 text-xl font-semibold">
                {item.q}
                <span
                  class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-forest transition-transform duration-200 group-open:rotate-45"
                  aria-hidden="true"
                >
                  <svg width="16" height="16" viewBox="0 0 18 18" fill="none">
                    <path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
                  </svg>
                </span>
              </summary>
              <p class="mb-6 max-w-[34em] text-[17px]">{item.a}</p>
            </details>
          ))
        }
      </div>
    </div>
  </section>

  <AppBand checkHref="#check" />
</BaseLayout>

<script>
  // Example slot picker: one slot pressed at a time, mirrored in "Selected".
  document.querySelectorAll<HTMLElement>('[data-slot-picker]').forEach((picker) => {
    const slots = picker.querySelectorAll<HTMLButtonElement>('[data-slot]');
    const label = picker.querySelector<HTMLElement>('[data-slot-label]');
    slots.forEach((slot) =>
      slot.addEventListener('click', () => {
        slots.forEach((other) => other.setAttribute('aria-pressed', other === slot ? 'true' : 'false'));
        if (label) label.textContent = slot.textContent?.trim() || '';
      })
    );
  });

  // Supabase password-recovery links land on "/" with the recovery session in
  // the URL fragment. Forward them to the reset form, fragment intact.
  const params = new URLSearchParams(window.location.hash.slice(1));
  if (params.get('type') === 'recovery' && params.has('access_token')) {
    window.location.replace(`/reset-password${window.location.hash}`);
  }
</script>
