---
/**
 * Learner waitlist form. POSTs /api/waitlist with { email, role, city, name, notes }.
 *
 * Learners only. Instructors do not join a waitlist — they apply for a real
 * account at /instructors/apply and are approved by a founder, so this form no
 * longer carries a learner/instructor toggle. `role` is still sent, fixed to
 * 'student', because the API contract and the notification emails expect it.
 *
 * The city field is a required choice of Norwich or London, checked against
 * the same `testCentresByCity` list the instructor application form binds
 * its city <select> to, so both sides agree those are real cities.
 *
 * No framework runtime: one small inline script handles submit, and the form
 * carries a real `action`/`method` so it degrades to a normal POST if JS fails.
 *
 * Redesign (November 2026): paper card with a 2px forest border, .nd-input
 * fields, sentence-case .nd-label labels, a plain .nd-btn submit and errors in
 * .nd-error. The script below is unchanged.
 */
import { testCentresByCity } from '../data/driving-test-centres';

interface Props {
  id: string;
  submitLabel?: string;
}

const { id, submitLabel } = Astro.props;

const label = submitLabel || 'Join the Norwich waitlist';
const cities = ['Norwich', 'London'].filter((city) => city in testCentresByCity);
---

<div data-waitlist-root>
  <form
    id={id}
    action="/api/waitlist"
    method="post"
    novalidate
    data-waitlist-form
    class="nd-card-lg nd-shadow flex flex-col gap-5 p-6 sm:p-8"
  >
    <input type="hidden" name="role" value="student" />

    <div class="grid gap-5 sm:grid-cols-2 sm:gap-4">
      <div class="flex flex-col gap-2">
        <label class="nd-label" for={`${id}-email`}>
          Email <span aria-hidden="true" class="text-pink-ink">*</span>
        </label>
        <input
          id={`${id}-email`}
          name="email"
          type="email"
          required
          autocomplete="email"
          inputmode="email"
          placeholder="you@example.com"
          class="nd-input"
        />
      </div>
      <div class="flex flex-col gap-2">
        <label class="nd-label" for={`${id}-name`}>
          Name <span class="font-normal text-forest-soft">(optional)</span>
        </label>
        <input
          id={`${id}-name`}
          name="name"
          type="text"
          autocomplete="name"
          placeholder="First name"
          class="nd-input"
        />
      </div>
    </div>

    <div class="flex flex-col gap-2">
      <label class="nd-label" for={`${id}-city`}>
        City <span aria-hidden="true" class="text-pink-ink">*</span>
      </label>
      <select id={`${id}-city`} name="city" required class="nd-input">
        <option value="">Select a city</option>
        {cities.map((city) => <option value={city}>{city}</option>)}
      </select>
    </div>

    <div class="flex flex-col gap-2">
      <label class="nd-label" for={`${id}-notes`}>
        Anything we should know
        <span class="font-normal text-forest-soft">(optional)</span>
      </label>
      <textarea
        id={`${id}-notes`}
        name="notes"
        rows="3"
        placeholder="Beginner, automatic only, test booked for July"
        class="nd-input"></textarea>
    </div>

    <p data-waitlist-error role="alert" class="nd-error hidden"></p>

    <div class="flex flex-col items-start gap-3 sm:flex-row sm:items-center sm:gap-5">
      <button type="submit" data-waitlist-submit class="nd-btn nd-btn-lg">
        <span data-waitlist-submit-label>{label}</span>
      </button>
      <p class="nd-help">No spam. We only email you about Newdryve.</p>
    </div>
  </form>

  <div
    data-waitlist-success
    hidden
    role="status"
    tabindex="-1"
    class="nd-card-lg nd-shadow flex flex-col items-center gap-3 p-8 text-center"
  >
    <span
      class="inline-flex size-12 items-center justify-center rounded-full border-2 border-forest bg-mint"
      aria-hidden="true"
    >
      <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
        <path
          d="M5 12.5l4.5 4.5L19 7.5"
          stroke="currentColor"
          stroke-width="3"
          stroke-linecap="round"
          stroke-linejoin="round"></path>
      </svg>
    </span>
    <h3 class="nd-h4">You&rsquo;re on the list.</h3>
    <p class="max-w-[28em] text-[17px]">
      We&rsquo;ll be in touch from <span class="font-semibold">hello@newdryve.com</span> as the
      early-access cohort opens up.
    </p>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-waitlist-root]').forEach((root) => {
    const form = root.querySelector<HTMLFormElement>('[data-waitlist-form]');
    const success = root.querySelector<HTMLElement>('[data-waitlist-success]');
    const errorEl = root.querySelector<HTMLElement>('[data-waitlist-error]');
    const button = root.querySelector<HTMLButtonElement>('[data-waitlist-submit]');
    const buttonLabel = root.querySelector<HTMLElement>('[data-waitlist-submit-label]');
    if (!form || !success || !errorEl || !button || !buttonLabel) return;

    let submitting = false;

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (submitting) return;

      const data = new FormData(form);
      const payload = {
        email: String(data.get('email') || ''),
        role: 'student',
        city: String(data.get('city') || ''),
        name: String(data.get('name') || ''),
        notes: String(data.get('notes') || ''),
      };

      submitting = true;
      button.disabled = true;
      const restoreLabel = buttonLabel.textContent;
      buttonLabel.textContent = 'Sending...';
      errorEl.classList.add('hidden');

      try {
        const res = await fetch('/api/waitlist', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });

        if (!res.ok) {
          const body = (await res.json().catch(() => ({}))) as { error?: string };
          throw new Error(body.error || 'Something went wrong. Please try again.');
        }

        form.hidden = true;
        success.hidden = false;
        success.focus?.();
      } catch (err) {
        errorEl.textContent =
          err instanceof Error ? err.message : 'Something went wrong. Please try again.';
        errorEl.classList.remove('hidden');
        buttonLabel.textContent = restoreLabel;
      } finally {
        submitting = false;
        button.disabled = false;
      }
    });
  });
</script>
