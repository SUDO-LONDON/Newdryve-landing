---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  src: ImageMetadata;
  alt: string;
  /** Caption printed under the frame. Use it to disclose sample data. */
  caption?: string;
  float?: boolean;
  loading?: 'eager' | 'lazy';
  class?: string;
}

const {
  src,
  alt,
  caption,
  float = false,
  loading = 'lazy',
  class: className = '',
} = Astro.props;
---

<figure class={`flex flex-col items-center ${className}`}>
  <div class={`relative ${float ? 'motion-safe:float-slow' : ''}`}>
    <!-- Phone bezel -->
    <div
      class="relative w-[260px] rounded-[2.5rem] border-[10px] border-ink bg-ink shadow-[0_30px_70px_-25px_rgba(10,10,20,0.5)] sm:w-[290px]"
    >
      <div class="overflow-hidden rounded-[1.9rem] bg-white">
        <Image
          src={src}
          alt={alt}
          widths={[290, 580, 870]}
          sizes="(min-width: 640px) 290px, 260px"
          loading={loading}
          decoding={loading === 'eager' ? 'sync' : 'async'}
          class="block h-auto w-full"
        />
      </div>
    </div>

    <!-- Required disclosure that this is app UI, not a live booking. -->
    <span
      class="absolute -right-2 top-4 z-20 rounded-full border border-blush-border bg-white px-2.5 py-1 text-[10px] font-bold uppercase tracking-[1px] text-deep-rose-ink shadow-sm"
    >
      Preview
    </span>
  </div>

  {
    caption && (
      <figcaption class="mt-4 max-w-[290px] text-center text-xs leading-relaxed text-ink-muted">
        {caption}
      </figcaption>
    )
  }
</figure>
