---
/**
 * Forest footer: four link columns, a giant mint wordmark fitted to the
 * content column, and the copyright line.
 *
 * The wordmark is sized in container-query units (cqi) against its own
 * wrapper, so it always fills the content width exactly instead of running
 * past it the way a vw size does.
 */
import { BRAND, FOOTER_COLUMNS } from '../config/site';

const year = new Date().getFullYear();
---

<footer class="on-forest bg-forest pt-20 pb-12 text-paper">
  <div class="nd-container">
    <div class="grid grid-cols-1 gap-x-8 gap-y-10 text-base sm:grid-cols-2 lg:grid-cols-4">
      {
        FOOTER_COLUMNS.map((column) => (
          <nav aria-label={column.title} class="flex flex-col gap-1">
            <h2 class="mb-2 text-[15px] font-semibold text-mint">{column.title}</h2>
            {column.links.map((link) => (
              <a
                href={link.href}
                class="inline-flex min-h-11 items-center self-start text-paper no-underline hover:underline"
                {...('external' in link && link.external
                  ? { target: '_blank', rel: 'noopener noreferrer' }
                  : {})}
              >
                {link.label}
              </a>
            ))}
          </nav>
        ))
      }
    </div>

    <div class="mt-16 [container-type:inline-size] sm:mt-20" aria-hidden="true">
      <div
        class="font-heading leading-[0.82] font-extrabold whitespace-nowrap text-mint"
        style="font-size:24.6cqi;letter-spacing:-0.05em"
        translate="no"
      >
        newdr<span class="text-pink">y</span>ve
      </div>
    </div>

    <p class="mt-9 text-[15px]">&copy; {year} {BRAND.name}. Built in {BRAND.city}.</p>
  </div>
</footer>
