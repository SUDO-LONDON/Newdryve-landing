---
/**
 * Site header: a paper pill on a mint band. Every page's first section is
 * mint too, so the band runs straight into the page hero.
 *
 * Learner pages get "Get the app"; instructor pages get "Apply". Pass
 * `appHref` to point "Get the app" at an anchor on the page (the home page
 * sends it to its #get-the-app band); otherwise it uses GetAppButton, which
 * routes to the right store per device and opens the QR hand-off on desktop.
 */
import Logo from './Logo.astro';
import GetAppButton from './GetAppButton.astro';
import { NAV_LINKS, INSTRUCTOR_NAV_LINKS } from '../config/site';

interface Props {
  audience?: 'learner' | 'instructor';
  appHref?: string;
}

const { audience = 'learner', appHref } = Astro.props;

const links = audience === 'instructor' ? INSTRUCTOR_NAV_LINKS : NAV_LINKS;
const ctaClass = 'nd-btn shrink-0 px-5 sm:px-6';
---

<header class="bg-mint pt-3 sm:pt-5">
  <div class="nd-container">
    <nav
      aria-label="Main"
      class="flex items-center justify-between gap-3 rounded-[36px] bg-paper py-2 pr-2 pl-5 sm:py-2.5 sm:pr-3 sm:pl-7"
    >
      <a href="/" aria-label="newdryve home" class="-my-1 shrink-0 rounded-md py-1 no-underline">
        <Logo size={26} />
      </a>

      <div class="hidden items-center gap-7 text-base font-semibold lg:flex">
        {
          links.map((link) => (
            <a href={link.href} class="py-3 no-underline hover:underline">
              {link.label}
            </a>
          ))
        }
      </div>

      <div class="flex items-center gap-2">
        {
          audience === 'instructor' ? (
            <a href="/instructors/apply" class={ctaClass}>
              Apply
            </a>
          ) : appHref ? (
            <a href={appHref} class={ctaClass}>
              Get the app
            </a>
          ) : (
            <GetAppButton class={ctaClass}>Get the app</GetAppButton>
          )
        }

        <!-- Menu below the lg breakpoint: a native disclosure, no framework. -->
        <details class="relative lg:hidden" data-mobile-menu>
          <summary
            class="inline-flex size-12 items-center justify-center rounded-full border-2 border-forest bg-paper"
            aria-label="Menu"
          >
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"
              ></path>
            </svg>
          </summary>
          <div class="nd-card nd-shadow absolute right-0 z-50 mt-3 flex w-64 flex-col p-2">
            {
              links.map((link) => (
                <a
                  href={link.href}
                  class="flex min-h-12 items-center rounded-2xl px-4 text-base font-semibold no-underline hover:bg-mint"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </details>
      </div>
    </nav>
  </div>
</header>

<script>
  // Close the menu on outside click, Escape, or after choosing a link.
  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  if (menu) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && menu.open) {
        menu.open = false;
        menu.querySelector('summary')?.focus();
      }
    });
    menu.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        menu.open = false;
      })
    );
  }
</script>
