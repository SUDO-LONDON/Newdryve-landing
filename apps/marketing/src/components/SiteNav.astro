---
import Logo from './Logo.astro';
import { NAV_LINKS, INSTRUCTOR_NAV_LINKS } from '../config/site';

interface Props {
  audience?: 'learner' | 'instructor';
}

const { audience = 'learner' } = Astro.props;

const links = audience === 'instructor' ? INSTRUCTOR_NAV_LINKS : NAV_LINKS;
const ctaHref = audience === 'instructor' ? '/instructors#apply' : '/#join';
const ctaLabel = audience === 'instructor' ? 'Apply' : 'Join';
const ctaLabelLong =
  audience === 'instructor' ? 'Apply as a founding instructor' : 'Join the waitlist';
---

<header
  id="site-nav"
  class="sticky top-0 z-50 border-b border-transparent transition-[background-color,border-color,box-shadow] duration-300"
  data-nav
>
  <nav aria-label="Primary" class="mx-auto flex h-16 max-w-6xl items-center justify-between px-5">
    <a href="/" aria-label="Newdryve home" class="focus-ring -m-1 flex items-center rounded-md p-1">
      <Logo />
    </a>

    <div class="hidden items-center gap-1 md:flex">
      {
        links.map((link) => (
          <a
            href={link.href}
            class="focus-ring rounded-md px-3 py-2 text-sm font-semibold text-ink-secondary transition-colors hover:text-ink"
          >
            {link.label}
          </a>
        ))
      }
    </div>

    <div class="flex items-center gap-2">
      <a
        href={ctaHref}
        class="focus-ring inline-flex min-h-11 items-center gap-1.5 rounded-full bg-deep-rose px-4 py-2.5 text-sm font-bold tracking-tight text-white shadow-[0_8px_20px_-8px_rgba(232,82,122,0.6)] transition-transform hover:bg-[#d8406b] motion-safe:hover:-translate-y-0.5 sm:px-5"
      >
        <span class="sm:hidden">{ctaLabel}</span>
        <span class="hidden sm:inline">{ctaLabelLong}</span>
      </a>

      <!-- Mobile menu: a native disclosure, so it costs zero JavaScript. -->
      <details class="relative md:hidden" data-mobile-menu>
        <summary
          class="focus-ring inline-flex size-11 cursor-pointer list-none items-center justify-center rounded-full border border-border bg-white text-ink [&::-webkit-details-marker]:hidden"
          aria-label="Open menu"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" aria-hidden="true">
            <path d="M4 7h16M4 12h16M4 17h16" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
          </svg>
        </summary>
        <div
          class="absolute right-0 z-50 mt-2 w-56 rounded-2xl border border-border bg-white p-2 shadow-[0_20px_50px_-20px_rgba(10,10,20,0.3)]"
        >
          {
            links.map((link) => (
              <a
                href={link.href}
                class="focus-ring flex min-h-11 items-center rounded-xl px-3 text-sm font-semibold text-ink transition-colors hover:bg-canvas"
              >
                {link.label}
              </a>
            ))
          }
        </div>
      </details>
    </div>
  </nav>
</header>

<script>
  // Adds the frosted background once the page is scrolled, and closes the
  // mobile disclosure on outside click or Escape.
  const nav = document.querySelector<HTMLElement>('[data-nav]');
  const scrolledClasses = [
    'bg-canvas/85',
    'backdrop-blur-md',
    'border-border',
    'shadow-[0_4px_24px_-12px_rgba(0,0,0,0.18)]',
  ];

  if (nav) {
    const onScroll = () => {
      nav.classList.toggle('border-transparent', window.scrollY <= 12);
      scrolledClasses.forEach((cls) => nav.classList.toggle(cls, window.scrollY > 12));
    };
    onScroll();
    window.addEventListener('scroll', onScroll, { passive: true });
  }

  const menu = document.querySelector<HTMLDetailsElement>('[data-mobile-menu]');
  if (menu) {
    document.addEventListener('click', (event) => {
      if (menu.open && !menu.contains(event.target as Node)) menu.open = false;
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') menu.open = false;
    });
    menu.querySelectorAll('a').forEach((link) =>
      link.addEventListener('click', () => {
        menu.open = false;
      })
    );
  }
</script>
