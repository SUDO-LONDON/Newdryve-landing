---
/**
 * Avatar picker beside "from green to pink". A scroll-snap strip showing one
 * avatar at a time, six thumbnails (current one ringed), previous and next
 * arrows that wrap round, and a "1 of 6" counter. Swiping or scrolling the
 * strip updates the counter and thumbnails. Smooth scrolling is skipped when
 * the user prefers reduced motion.
 *
 * The tiles are 400 x 372 PNGs with a baked-in #DEF5E5 background, cropped
 * from a JPEG, so the panel uses the same colour.
 */
const AVATARS = [
  { file: 'mint', name: 'mint car', alt: 'newdryve avatar driving a mint car' },
  { file: 'pink', name: 'pink car', alt: 'newdryve avatar driving a pink car with a heart on the door' },
  { file: 'yellow', name: 'yellow car', alt: 'newdryve avatar driving a yellow car with a star on the door' },
  { file: 'blue', name: 'blue car', alt: 'newdryve avatar driving a blue car with racing stripes' },
  { file: 'orange', name: 'orange car', alt: 'newdryve avatar driving an orange car' },
  { file: 'white', name: 'white car', alt: 'newdryve avatar driving a white car' },
];

const arrowClass =
  'inline-flex size-11 shrink-0 items-center justify-center rounded-full border-2 border-forest bg-paper';
---

<div class="flex w-full max-w-[380px] min-w-0 flex-col gap-3.5" data-avatar-picker>
  <div class="relative">
    <div
      class="scrollbar-none flex snap-x snap-mandatory overflow-x-auto rounded-3xl bg-avatar-tile"
      role="region"
      aria-label="newdryve avatars"
      tabindex="0"
      data-avatar-strip
    >
      {
        AVATARS.map((avatar, index) => (
          <div class="flex flex-[0_0_100%] snap-center items-center justify-center">
            <img
              src={`/avatars/avatar-${avatar.file}.png`}
              alt={avatar.alt}
              width="400"
              height="372"
              loading={index === 0 ? 'eager' : 'lazy'}
              decoding="async"
              class="block h-auto w-full max-w-[290px]"
            />
          </div>
        ))
      }
    </div>
    <div
      class="pointer-events-none absolute top-4 right-4 rounded-full bg-forest px-3.5 py-1 text-sm font-semibold text-paper"
    >
      <span data-avatar-count>1 of {AVATARS.length}</span>
    </div>
  </div>

  <div class="flex items-center justify-between gap-2">
    <button type="button" class={arrowClass} aria-label="Previous avatar" data-avatar-step="-1">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 5l-7 7 7 7"></path></svg>
    </button>
    <div class="flex justify-center gap-1 sm:gap-1.5">
      {
        AVATARS.map((avatar, index) => (
          <button
            type="button"
            class="size-9 shrink-0 overflow-hidden rounded-[10px] bg-avatar-tile p-0 aria-pressed:ring-3 aria-pressed:ring-forest sm:size-10"
            aria-pressed={index === 0 ? 'true' : 'false'}
            aria-label={`Show the ${avatar.name} avatar`}
            data-avatar-go={index}
          >
            <img
              src={`/avatars/avatar-${avatar.file}.png`}
              alt=""
              width="40"
              height="40"
              loading="lazy"
              decoding="async"
              class="block size-full object-cover"
            />
          </button>
        ))
      }
    </div>
    <button type="button" class={arrowClass} aria-label="Next avatar" data-avatar-step="1">
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M9 5l7 7-7 7"></path></svg>
    </button>
  </div>
  <p class="text-center text-base font-semibold">Customise your character more in the app!</p>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-avatar-picker]').forEach((root) => {
    const strip = root.querySelector<HTMLElement>('[data-avatar-strip]')!;
    const thumbs = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-avatar-go]'));
    const count = root.querySelector<HTMLElement>('[data-avatar-count]')!;
    const total = thumbs.length;
    let current = 0;
    // While a programmatic scroll is running, ignore the intermediate scroll
    // events so the counter doesn't flick through every avatar on the way.
    let lock: number | null = null;
    let timer: number | undefined;

    const paint = (index: number) => {
      current = index;
      thumbs.forEach((thumb, k) => thumb.setAttribute('aria-pressed', k === index ? 'true' : 'false'));
      count.textContent = `${index + 1} of ${total}`;
    };

    const go = (index: number) => {
      const target = ((index % total) + total) % total;
      lock = target;
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        lock = null;
      }, 900);
      const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      strip.scrollTo({ left: target * strip.clientWidth, behavior: reduce ? 'auto' : 'smooth' });
      paint(target);
    };

    strip.addEventListener(
      'scroll',
      () => {
        const index = Math.max(0, Math.min(total - 1, Math.round(strip.scrollLeft / strip.clientWidth)));
        if (lock !== null) {
          if (index === lock) lock = null;
          return;
        }
        if (index !== current) paint(index);
      },
      { passive: true }
    );

    thumbs.forEach((thumb) =>
      thumb.addEventListener('click', () => go(Number(thumb.dataset.avatarGo)))
    );
    root.querySelectorAll<HTMLButtonElement>('[data-avatar-step]').forEach((button) =>
      button.addEventListener('click', () => go(current + Number(button.dataset.avatarStep)))
    );
  });
</script>
