---
/**
 * Desktop hand-off for "Get the app": Newdryve is a phone app, so on desktop we
 * show a QR code (to app.newdryve.com, the download page) and both store
 * buttons. Opened by GetAppButton. Rendered once per page.
 */
import { APP } from '../config/site';
import StoreBadges from './StoreBadges.astro';
---

<dialog
  data-app-handoff
  data-android-url={APP.android.live ? APP.android.url : undefined}
  data-ios-url={APP.ios.live && APP.ios.url ? APP.ios.url : undefined}
  aria-labelledby="app-handoff-title"
  class="nd-card-lg m-auto w-[min(92vw,420px)] bg-pink p-0 text-forest backdrop:bg-forest/60"
>
  <div class="relative px-7 pt-9 pb-8 text-center">
    <button
      type="button"
      data-app-handoff-close
      aria-label="Close"
      class="absolute top-4 right-4 inline-flex size-11 items-center justify-center rounded-full border-2 border-forest bg-paper"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3.5 3.5l9 9m0-9l-9 9" stroke="currentColor" stroke-width="2.25" stroke-linecap="round"></path>
      </svg>
    </button>

    <h2 id="app-handoff-title" class="nd-h4 text-[30px]">get newdryve on your phone</h2>
    <p class="mx-auto mt-3 max-w-[28ch] text-[17px]">
      Point your phone camera at the code. It opens the download page for the App Store and Google
      Play.
    </p>

    <img
      src="/qr-app.svg"
      alt="QR code linking to the Newdryve download page"
      width="180"
      height="180"
      class="mx-auto mt-6 block size-[180px] -rotate-3 rounded-2xl border-2 border-forest bg-paper p-3"
    />

    <StoreBadges class="mt-6 justify-center" />
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-app-handoff]');
  dialog?.querySelector('[data-app-handoff-close]')?.addEventListener('click', () => dialog.close());
  // Clicking the dimmed backdrop (the dialog element itself, outside the panel) closes it.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
