---
/**
 * Desktop hand-off for "Get the app": Newdryve is a phone app, so on desktop we
 * show a QR code (to app.newdryve.com, the download page) and both store
 * buttons. Opened by GetAppButton. Rendered once per page.
 */
import { APP } from '../config/site';
import StoreBadges from './StoreBadges.astro';
---

<dialog
  data-app-handoff
  data-android-url={APP.android.live ? APP.android.url : undefined}
  data-ios-url={APP.ios.live && APP.ios.url ? APP.ios.url : undefined}
  aria-labelledby="app-handoff-title"
  class="m-auto w-[min(92vw,400px)] rounded-3xl border border-border bg-white p-0 text-ink shadow-[0_30px_80px_-30px_rgba(10,10,20,0.45)] backdrop:bg-ink/50 backdrop:backdrop-blur-sm"
>
  <div class="relative px-7 pb-7 pt-8 text-center">
    <button
      type="button"
      data-app-handoff-close
      aria-label="Close"
      class="focus-ring absolute right-4 top-4 inline-flex size-10 items-center justify-center rounded-full text-ink-secondary transition-colors hover:bg-canvas hover:text-ink"
    >
      <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
        <path d="M3.5 3.5l9 9m0-9l-9 9" stroke="currentColor" stroke-width="1.75" stroke-linecap="round"></path>
      </svg>
    </button>

    <h2 id="app-handoff-title" class="font-display text-[26px] font-semibold leading-tight tracking-[-0.5px]">
      Get Newdryve on your phone
    </h2>
    <p class="mx-auto mt-3 max-w-[30ch] text-sm leading-relaxed text-ink-secondary">
      Newdryve is on the App Store and Google Play. Scan the code with your phone camera to
      download it.
    </p>

    <img
      src="/qr-app.svg"
      alt="QR code linking to the Newdryve download page"
      width="180"
      height="180"
      class="mx-auto mt-5 block size-[180px]"
    />

    <StoreBadges class="mt-5 justify-center" />
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('[data-app-handoff]');
  dialog?.querySelector('[data-app-handoff-close]')?.addEventListener('click', () => dialog.close());
  // Clicking the dimmed backdrop (the dialog element itself, outside the panel) closes it.
  dialog?.addEventListener('click', (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
