---
/**
 * The newdryve car and its square driver, as an inline SVG (the base car
 * vector, newdryve-base-car.pdf).
 *
 * The body colour reads the `--car` custom property, so a page can recolour
 * every car inside an element by setting `--car` on it; `color` is the
 * fallback. `look` picks one of two drivers. Decorative by default: pass
 * `label` to give it an accessible name.
 */
interface Props {
  width?: number;
  color?: string;
  look?: 'short-hair' | 'long-hair';
  label?: string;
  class?: string;
}

const { width = 160, color = '#A5F0BC', look = 'short-hair', label, class: className = '' } = Astro.props;

const LOOKS = {
  'short-hair': { shirt: '#E8327F', hairLong: 0, lashes: 0, stHeart: 0 },
  'long-hair': { shirt: '#0A3B2C', hairLong: 1, lashes: 1, stHeart: 1 },
} as const;

const values: Record<string, string | number> = {
  skin: '#E8B98D',
  hair: '#5A3A28',
  hairPony: 0,
  hairBun: 0,
  hairAny: 1,
  glasses: 0,
  cap: 0,
  bow: 0,
  stStripe: 0,
  stStar: 0,
  ...LOOKS[look],
};

const TEMPLATE = `<g transform="translate(14 18)"><ellipse cx="104" cy="167" rx="98" ry="11" fill="#0A3B2C" opacity="0.14"></ellipse><rect x="60" y="108" width="40" height="40" rx="13" fill="#0F2A22"></rect><rect x="146" y="108" width="40" height="40" rx="13" fill="#0F2A22"></rect><path d="M16 88L44 70H184L156 88Z" style="fill:var(--car,BODY);stroke:var(--car,BODY)" stroke-width="8" stroke-linejoin="round"></path><path d="M16 88L44 70H184L156 88Z" fill="#FFFFFF" stroke="#FFFFFF" stroke-width="8" stroke-linejoin="round" opacity="0.32"></path><path d="M156 88L184 70V116L156 134Z" style="fill:var(--car,BODY);stroke:var(--car,BODY)" stroke-width="8" stroke-linejoin="round"></path><path d="M156 88L184 70V116L156 134Z" fill="#0A3B2C" stroke="#0A3B2C" stroke-width="8" stroke-linejoin="round" opacity="0.2"></path><path d="M66 85H140L157 74H83Z" fill="#0A3B2C" stroke="#0A3B2C" stroke-width="4" stroke-linejoin="round" opacity="0.5"></path><rect x="76" y="56" width="15" height="28" rx="6" fill="#0F2A22"></rect><g opacity="{{ hairLong }}"><path d="M73 22a15 15 0 0 1 15-15h36a15 15 0 0 1 15 15v44a10 10 0 0 1-10 10H83a10 10 0 0 1-10-10z" fill="{{ hair }}"></path><path d="M73 50h66v16a10 10 0 0 1-10 10H83a10 10 0 0 1-10-10z" fill="#0A3B2C" opacity="0.16"></path></g><g opacity="{{ hairPony }}"><path d="M86 12C62 8 52 30 58 54C60 64 72 63 71 53C69 40 74 30 88 27Z" fill="{{ hair }}"></path><path d="M62 34C60 44 62 52 64 56" fill="none" stroke="#0A3B2C" stroke-width="3" stroke-linecap="round" opacity="0.18"></path><rect x="78" y="12" width="7" height="13" rx="3.5" fill="#E8327F" transform="rotate(-18 81 18)"></rect></g><g opacity="{{ hairBun }}"><circle cx="108" cy="1" r="12" fill="{{ hair }}"></circle><path d="M100 -4a10 10 0 0 1 14 -2" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.25"></path></g><rect x="98" y="44" width="13" height="10" rx="3" fill="{{ skin }}"></rect><rect x="98" y="44" width="13" height="10" rx="3" fill="#0A3B2C" opacity="0.18"></rect><rect x="88" y="50" width="33" height="34" rx="9" fill="{{ shirt }}"></rect><path d="M121 58l5-3v21l-5 5z" fill="{{ shirt }}" stroke="{{ shirt }}" stroke-width="3" stroke-linejoin="round"></path><path d="M121 58l5-3v21l-5 5z" fill="#0A3B2C" stroke="#0A3B2C" stroke-width="3" stroke-linejoin="round" opacity="0.2"></path><rect x="92" y="54" width="20" height="5" rx="2.5" fill="#FFFFFF" opacity="0.28"></rect><ellipse cx="139" cy="70" rx="4" ry="10" fill="none" stroke="#0F2A22" stroke-width="4"></ellipse><path d="M116 62Q128 62 134 70" fill="none" stroke="{{ shirt }}" stroke-width="10" stroke-linecap="round"></path><path d="M116 62Q128 62 134 70" fill="none" stroke="#0A3B2C" stroke-width="10" stroke-linecap="round" opacity="0.1"></path><circle cx="135" cy="71" r="6" fill="{{ skin }}"></circle><g fill="{{ skin }}"><rect x="91" y="2" width="44" height="40" rx="12"></rect><rect x="89.5" y="3" width="44" height="40" rx="12"></rect><rect x="88" y="4" width="44" height="40" rx="12"></rect><rect x="86.5" y="5" width="44" height="40" rx="12"></rect><rect x="85" y="6" width="44" height="40" rx="12"></rect><rect x="83.5" y="7" width="44" height="40" rx="12"></rect></g><g fill="#0A3B2C" opacity="0.2"><rect x="91" y="2" width="44" height="40" rx="12"></rect><rect x="89.5" y="3" width="44" height="40" rx="12"></rect><rect x="88" y="4" width="44" height="40" rx="12"></rect><rect x="86.5" y="5" width="44" height="40" rx="12"></rect><rect x="85" y="6" width="44" height="40" rx="12"></rect><rect x="83.5" y="7" width="44" height="40" rx="12"></rect></g><g opacity="{{ hairAny }}"><g fill="{{ hair }}"><rect x="89" y="0" width="48" height="21" rx="12"></rect><rect x="87.5" y="1" width="48" height="21" rx="12"></rect><rect x="86" y="2" width="48" height="21" rx="12"></rect><rect x="84.5" y="3" width="48" height="21" rx="12"></rect><rect x="83" y="4" width="48" height="21" rx="12"></rect><rect x="81.5" y="5" width="48" height="21" rx="12"></rect></g><g fill="#0A3B2C" opacity="0.22"><rect x="89" y="0" width="48" height="21" rx="12"></rect><rect x="87.5" y="1" width="48" height="21" rx="12"></rect><rect x="86" y="2" width="48" height="21" rx="12"></rect><rect x="84.5" y="3" width="48" height="21" rx="12"></rect><rect x="83" y="4" width="48" height="21" rx="12"></rect><rect x="81.5" y="5" width="48" height="21" rx="12"></rect></g></g><rect x="82" y="8" width="44" height="40" rx="12" fill="{{ skin }}"></rect><rect x="86" y="11" width="36" height="12" rx="6" fill="#FFFFFF" opacity="0.2"></rect><ellipse cx="89.500" cy="37" rx="4.5" ry="3" fill="#E8327F" opacity="0.3"></ellipse><ellipse cx="119" cy="37" rx="4.5" ry="3" fill="#E8327F" opacity="0.3"></ellipse><rect x="93" y="24" width="7.5" height="10" rx="3.75" fill="#0F2A22"></rect><rect x="109" y="24" width="7.5" height="10" rx="3.75" fill="#0F2A22"></rect><circle cx="98" cy="26.500" r="1.7" fill="#FFFFFF"></circle><circle cx="114" cy="26.500" r="1.7" fill="#FFFFFF"></circle><path d="M99 38.500q5.500 5 11 0" fill="none" stroke="#0F2A22" stroke-width="2.6" stroke-linecap="round"></path><g opacity="{{ lashes }}" fill="none" stroke="#0F2A22" stroke-width="1.9" stroke-linecap="round"><path d="M92.500 25l-3.500-2.500"></path><path d="M92 28.500l-4-0.500"></path><path d="M117 25l3.500-2.500"></path><path d="M117.500 28.500l4-0.500"></path></g><g opacity="{{ glasses }}" fill="none" stroke="#0F2A22" stroke-width="2.3" stroke-linejoin="round"><rect x="89.500" y="21.500" width="14.500" height="14.500" rx="4.500" fill="#FFFFFF" fill-opacity="0.25"></rect><rect x="105.500" y="21.500" width="14.500" height="14.500" rx="4.500" fill="#FFFFFF" fill-opacity="0.25"></rect></g><g opacity="{{ hairAny }}"><path d="M80 27V19a13 13 0 0 1 13-13h22a13 13 0 0 1 13 13v8q-8-10-24-10t-24 10z" fill="{{ hair }}"></path><path d="M86 12q8-4 16-3" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.25"></path></g><g opacity="{{ hairLong }}"><rect x="75" y="20" width="10" height="50" rx="5" fill="{{ hair }}"></rect><rect x="123" y="20" width="10" height="50" rx="5" fill="{{ hair }}"></rect><rect x="123" y="20" width="10" height="50" rx="5" fill="#0A3B2C" opacity="0.14"></rect></g><g opacity="{{ cap }}"><g fill="{{ shirt }}"><path d="M88 17v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path><path d="M86.5 18v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path><path d="M85 19v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path><path d="M83.5 20v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path><path d="M82 21v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path><path d="M80.5 22v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path></g><g fill="#0A3B2C" opacity="0.22"><path d="M88 17v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path><path d="M86.5 18v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path><path d="M85 19v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path><path d="M83.5 20v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path><path d="M82 21v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path><path d="M80.5 22v-6a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z"></path></g><path d="M79 23V17a13 13 0 0 1 13-13h24a13 13 0 0 1 13 13v6z" fill="{{ shirt }}"></path><path d="M86 9q9-3 18-2" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.3"></path><rect x="106" y="18" width="36" height="9" rx="4.500" fill="{{ shirt }}"></rect><rect x="106" y="22" width="36" height="5" rx="2.500" fill="#0A3B2C" opacity="0.22"></rect></g><g opacity="{{ bow }}"><path d="M94 7L80 -2V16Z" fill="#E8327F" stroke="#E8327F" stroke-width="4" stroke-linejoin="round"></path><path d="M94 7L108 -2V16Z" fill="#E8327F" stroke="#E8327F" stroke-width="4" stroke-linejoin="round"></path><path d="M94 7L108 -2V16Z" fill="#0A3B2C" opacity="0.14"></path><rect x="90" y="2" width="8" height="10" rx="3.500" fill="#C2185F"></rect></g><path d="M143 87L165 73L159 43L137 57Z" fill="#CFEFF8" opacity="0.72"></path><path d="M143 87L165 73L159 43L137 57Z" fill="none" stroke="#FFFFFF" stroke-width="4" stroke-linejoin="round"></path><path d="M143.500 64l9-5.800" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.85"></path><rect x="12" y="84" width="148" height="54" rx="13" style="fill:var(--car,BODY)"></rect><rect x="21" y="90" width="130" height="7" rx="3.500" fill="#FFFFFF" opacity="0.38"></rect><path d="M12 121h148v4a13 13 0 0 1-13 13H25a13 13 0 0 1-13-13z" fill="#0A3B2C" opacity="0.14"></path><g opacity="{{ stStripe }}"><rect x="12" y="103" width="148" height="7" fill="#FBFAF6" opacity="0.9"></rect><rect x="12" y="113" width="148" height="3" fill="#FBFAF6" opacity="0.9"></rect></g><rect x="62" y="99" width="48" height="30" rx="8" fill="none" stroke="#0A3B2C" stroke-width="2.500" opacity="0.26"></rect><rect x="96" y="104" width="10" height="4" rx="2" fill="#0A3B2C" opacity="0.45"></rect><g opacity="{{ stHeart }}"><path d="M84 126c-9-6-12-10-12-14.500a6.200 6.200 0 0 1 12-2.200a6.200 6.200 0 0 1 12 2.200c0 4.500-3 8.500-12 14.500z" fill="#E8327F" stroke="#FBFAF6" stroke-width="2.500" stroke-linejoin="round"></path></g><g opacity="{{ stStar }}"><path d="M84 102l3.700 7.600 8.300 1.100-6.100 5.800 1.500 8.300-7.400-4-7.400 4 1.500-8.300-6.100-5.800 8.300-1.100z" fill="#FFD84A" stroke="#FBFAF6" stroke-width="2.500" stroke-linejoin="round"></path></g><g class="nd-car-plate"><rect x="23" y="100" width="25" height="25" rx="6" fill="#0A3B2C" opacity="0.2"></rect><rect x="22" y="98" width="25" height="25" rx="6" fill="#FBFAF6"></rect><path d="M30.500 103.500v13.500h9.500" fill="none" stroke="#E8327F" stroke-width="4.500" stroke-linecap="round" stroke-linejoin="round"></path></g><g transform="matrix(1 -0.643 0 1 156 88)"><rect x="2" y="41" width="25" height="6" rx="3" fill="#0A3B2C" opacity="0.28"></rect><rect x="6" y="7" width="17" height="14" rx="5.500" fill="#FFE27A"></rect><rect x="6" y="7" width="17" height="14" rx="5.500" fill="none" stroke="#FFFFFF" stroke-width="2" opacity="0.7"></rect><circle cx="11.500" cy="12" r="2.500" fill="#FFFFFF" opacity="0.9"></circle><rect x="5" y="30" width="19" height="7" rx="3.500" fill="#0A3B2C" opacity="0.5"></rect></g><rect x="35" y="120" width="42" height="42" rx="14" fill="#0A1F19"></rect><rect x="119" y="120" width="42" height="42" rx="14" fill="#0A1F19"></rect><rect x="30" y="124" width="42" height="42" rx="14" fill="#1B3A31"></rect><rect x="114" y="124" width="42" height="42" rx="14" fill="#1B3A31"></rect><path d="M38 138a14 14 0 0 1 12-8" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.2"></path><path d="M122 138a14 14 0 0 1 12-8" fill="none" stroke="#FFFFFF" stroke-width="3" stroke-linecap="round" opacity="0.2"></path><rect x="41" y="135" width="20" height="20" rx="7" fill="#EDEAE0"></rect><rect x="125" y="135" width="20" height="20" rx="7" fill="#EDEAE0"></rect><rect x="47" y="141" width="8" height="8" rx="3" fill="#8FA097"></rect><rect x="131" y="141" width="8" height="8" rx="3" fill="#8FA097"></rect></g>`;

const inner = TEMPLATE.replace(/\{\{\s*(\w+)\s*\}\}/g, (_, key: string) => String(values[key])).replaceAll(
  'BODY',
  color
);
const height = Math.round((width * 200) / 220);
---

<svg
  class={className}
  width={width}
  height={height}
  viewBox="0 0 220 200"
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
  style="overflow:visible"
>
  <Fragment set:html={inner} />
</svg>
