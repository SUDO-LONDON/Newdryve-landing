---
interface Props {
  variant: 'learner-search' | 'learner-progress' | 'instructor-profile';
  caption?: string;
  float?: boolean;
  class?: string;
}

const { variant, caption, float = false, class: className = '' } = Astro.props;

const variants = {
  'learner-search': {
    src: '/product/newdryve-discover.png',
    alt: 'Newdryve instructor discovery screen with search, filters and verified instructor cards',
  },
  'learner-progress': {
    src: '/product/newdryve-lessons.png',
    alt: 'Newdryve lessons screen showing upcoming lessons, lesson tracking and rescheduling controls',
  },
  'instructor-profile': {
    src: '/product/newdryve-discover.png',
    alt: 'Newdryve instructor discovery screen showing how instructors appear to learners',
  },
} as const;

const data = variants[variant];
---

<figure class={`flex flex-col items-center ${className}`}>
  <div class={`relative ${float ? 'motion-safe:float-slow' : ''}`}>
    <img
      src={data.src}
      alt={data.alt}
      width="740"
      height="1488"
      loading={float ? 'eager' : 'lazy'}
      decoding="async"
      class="h-auto w-[260px] select-none sm:w-[290px]"
    />

    <span
      class="absolute -right-2 top-4 z-20 rounded-full border border-blush-border bg-white px-2.5 py-1 text-[10px] font-bold uppercase tracking-[1px] text-deep-rose-ink shadow-sm"
    >
      Preview
    </span>
  </div>

  {
    caption && (
      <figcaption class="mt-4 max-w-[290px] text-center text-xs leading-relaxed text-ink-muted">
        {caption}
      </figcaption>
    )
  }
</figure>
