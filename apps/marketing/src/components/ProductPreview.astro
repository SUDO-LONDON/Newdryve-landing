---
/**
 * A product screenshot on a coloured tile. The PNGs in /public/product already
 * carry an iPhone frame on a grey halo, so the figure only adds the redesign
 * framing: a mint or pink tile, a 2px forest-bordered panel holding the image,
 * a "Preview, sample data" chip and a caption in forest-soft.
 *
 * `float` marks the hero preview: it loads eagerly and defaults to a pink tile
 * so it stands out on the mint hero. There is no float animation any more.
 * `tone` overrides the tile colour.
 */
interface Props {
  variant: 'learner-search' | 'learner-progress' | 'instructor-profile';
  caption?: string;
  float?: boolean;
  /** Tile colour. Defaults to pink for the hero (`float`), mint elsewhere. */
  tone?: 'mint' | 'pink';
  class?: string;
}

const { variant, caption, float = false, tone, class: className = '' } = Astro.props;

const variants = {
  'learner-search': {
    src: '/product/newdryve-discover.png',
    alt: 'Newdryve instructor discovery screen with search, filters and verified instructor cards',
  },
  'learner-progress': {
    src: '/product/newdryve-lessons.png',
    alt: 'Newdryve lessons screen showing upcoming lessons, lesson tracking and rescheduling controls',
  },
  'instructor-profile': {
    src: '/product/newdryve-discover.png',
    alt: 'Newdryve instructor discovery screen showing how instructors appear to learners',
  },
} as const;

const data = variants[variant];
const tileTone = tone ?? (float ? 'pink' : 'mint');
const tileClass = tileTone === 'pink' ? 'bg-pink' : 'bg-mint';
---

<figure class={`flex w-full max-w-[332px] flex-col items-center ${className}`}>
  <div class={`flex w-full flex-col gap-3 rounded-[32px] p-4 sm:p-5 ${tileClass}`}>
    <div class="flex justify-end">
      <span class="nd-chip">Preview, sample data</span>
    </div>
    <div class="overflow-hidden rounded-[24px] border-2 border-forest bg-paper">
      <img
        src={data.src}
        alt={data.alt}
        width="740"
        height="1488"
        loading={float ? 'eager' : 'lazy'}
        decoding="async"
        class="block h-auto w-full select-none"
      />
    </div>
  </div>

  {
    caption && (
      <figcaption class="mt-4 max-w-[290px] text-center text-[15px] leading-snug text-forest-soft">
        {caption}
      </figcaption>
    )
  }
</figure>
