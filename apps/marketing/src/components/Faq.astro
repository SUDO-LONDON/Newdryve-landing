---
/**
 * FAQ list on native <details>: no JavaScript. Ruled 2px forest lines, the
 * first item open by default.
 */
import type { FaqItem } from '../lib/schema';

interface Props {
  items: readonly FaqItem[];
  /** Open the first question on load. */
  openFirst?: boolean;
  class?: string;
}

const { items, openFirst = true, class: className = '' } = Astro.props;
---

<div class={`flex flex-col border-t-2 border-forest ${className}`}>
  {
    items.map((item, index) => (
      <details class="group border-b-2 border-forest" open={openFirst && index === 0}>
        <summary class="flex min-h-11 items-center justify-between gap-4 py-5 text-left text-xl font-semibold">
          {item.q}
          <span
            class="inline-flex size-9 shrink-0 items-center justify-center rounded-full border-2 border-forest transition-transform duration-200 group-open:rotate-45"
            aria-hidden="true"
          >
            <svg width="16" height="16" viewBox="0 0 18 18" fill="none">
              <path d="M9 3v12M3 9h12" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" />
            </svg>
          </span>
        </summary>
        <p class="mb-6 max-w-[34em] text-[17px]">{item.a}</p>
      </details>
    ))
  }
</div>
