---
/**
 * The newdryve wordmark, typeset in Bricolage Grotesque ExtraBold with a hot
 * pink "y" (style sheet, November 2026). There is no logo file yet; when one
 * arrives it replaces the markup below.
 *
 * `inverted` is for forest surfaces: mint letters with a pink "y", as in the
 * footer.
 */
interface Props {
  size?: number;
  inverted?: boolean;
}

const { size = 28, inverted = false } = Astro.props;
---

<span
  class:list={[
    'font-heading font-extrabold leading-none whitespace-nowrap',
    inverted ? 'text-mint' : 'text-forest',
  ]}
  style={`font-size:${size}px;letter-spacing:-0.04em`}
  translate="no">newdr<span class={inverted ? 'text-pink' : 'text-hot-pink'}>y</span>ve</span
>
